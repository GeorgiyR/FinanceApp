    private async Task SaveStockAsync()
    {
        if (!_stockModalOpen || _stockEditSaving) return;
        var original = _editingStock;
        var ticker = original is null || _identityEditingEnabled ? _stockEditForm.Ticker.Trim().ToUpperInvariant() : original.Ticker;
        var exchange = original is null || _identityEditingEnabled ? _stockEditForm.Exchange.Trim() : original.Exchange;
        var identityChanged = original is not null && (!string.Equals(ticker, original.Ticker, StringComparison.Ordinal)
            || !string.Equals(exchange, original.Exchange, StringComparison.OrdinalIgnoreCase));
        var confirmationText = string.Empty;
        if (identityChanged && original is not null)
        {
            confirmationText = $"{original.Ticker} ({original.Exchange}) → {ticker} ({exchange})";
            if (!await JS.InvokeAsync<bool>("confirm", $"Подтвердите изменение идентичности: {confirmationText}. История котировок и provider-данные будут очищены.")) return;
        }

        _stockEditSaving = true;
        _stockEditError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) { _stockEditError = "Войдите в приложение и повторите попытку."; return; }
            var payload = new
            {
                ticker,
                exchange,
                name = _stockEditForm.Name.Trim(),
                commonName = string.IsNullOrWhiteSpace(_stockEditForm.CommonName) ? _stockEditForm.Name.Trim() : _stockEditForm.CommonName.Trim(),
                wkn = NullIfEmpty(_stockEditForm.Wkn?.Trim().ToUpperInvariant()),
                isin = NullIfEmpty(_stockEditForm.Isin?.Trim().ToUpperInvariant()),
                finanzenNetSlug = NullIfEmpty(_stockEditForm.FinanzenNetSlug?.Trim().ToLowerInvariant()),
                currentPrice = _stockEditForm.CurrentPrice,
                sectorId = _stockEditForm.SectorId,
                industryId = _stockEditForm.IndustryId,
                marketIndexIds = _stockEditForm.MarketIndexIds.Distinct().ToList(),
                confirmationText,
                identityEditingEnabled = identityChanged && _identityEditingEnabled,
                retainProviderSymbol = false
            };
            using var response = original is null
                ? await client.PostAsJsonAsync("Stocks", payload)
                : await client.PutAsJsonAsync($"Stocks/{original.Id}/edit", payload);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _stockEditError = string.IsNullOrWhiteSpace(body) ? $"Не удалось сохранить акцию (HTTP {(int)response.StatusCode})." : body;
                return;
            }

            _editingStock = null;
            _stockModalOpen = false;
            _refreshMessage = original is null ? $"Акция {ticker} добавлена." : $"Данные акции {ticker} сохранены.";
            await LoadTrackedStocksAsync();
        }
        catch { _stockEditError = "Не удалось связаться с API."; }
        finally { _stockEditSaving = false; }
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    private static List<string> ParseCsv(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string key)
        => query.TryGetValue(key, out var value) ? value.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList() : [];
    private static List<int> ParseIds(IDictionary<string, Microsoft.Extensions.Primitives.StringValues> query, string key)
        => ParseCsv(query, key).Select(value => int.TryParse(value, out var id) ? id : 0).Where(id => id > 0).Distinct().Order().ToList();

    private bool MatchesSearch(TrackedStockViewModel stock, string search) => string.IsNullOrWhiteSpace(search)
        || stock.Ticker.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
        || stock.Name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
        || stock.CommonName.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
        || stock.Exchange.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)
        || (stock.Sector?.Name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase) ?? false)
        || (stock.Industry?.Name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase) ?? false)
        || stock.MarketIndexIds.Any(id => _marketIndexNameById.TryGetValue(id, out var name) && name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase));

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        await _autoRefreshCancellation.CancelAsync();
        if (_autoRefreshTask is not null)
        {
            try { await _autoRefreshTask; } catch (OperationCanceledException) { }
        }
        _autoRefreshCancellation.Dispose();
    }

    private enum QuoteRefreshResult { Success, Delayed, NoEuroPrice, Failed }
    private sealed class StockEditFormModel
    {
        [Required(ErrorMessage = "Укажите тикер.")]
        [RegularExpression(@"^[A-Za-z0-9.^_-]+$", ErrorMessage = "Тикер содержит недопустимые символы.")]
        public string Ticker { get; set; } = string.Empty;
        [Required(ErrorMessage = "Укажите биржу.")] public string Exchange { get; set; } = "NYSE";
        [Required(ErrorMessage = "Укажите название.")] public string Name { get; set; } = string.Empty;
        public string CommonName { get; set; } = string.Empty;
        [Range(typeof(decimal), "0", "1000000000000000", ParseLimitsInInvariantCulture = true, ErrorMessage = "Цена должна быть неотрицательной.")]
        public decimal CurrentPrice { get; set; }
        [RegularExpression(@"^$|^[A-Za-z0-9]{6}$", ErrorMessage = "WKN должен содержать 6 букв или цифр.")] public string Wkn { get; set; } = string.Empty;
        [RegularExpression(@"^$|^[A-Za-z]{2}[A-Za-z0-9]{10}$", ErrorMessage = "ISIN должен содержать 2 буквы и 10 букв или цифр.")] public string Isin { get; set; } = string.Empty;
        [RegularExpression(@"^$|^[a-z0-9][a-z0-9_-]*$", ErrorMessage = "Slug может содержать строчные латинские буквы, цифры, дефис и подчёркивание.")] public string FinanzenNetSlug { get; set; } = string.Empty;
        public int? SectorId { get; set; }
        public int? IndustryId { get; set; }
        public List<int> MarketIndexIds { get; set; } = [];
    }
