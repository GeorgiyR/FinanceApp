    private async Task DeleteStockPermanentlyAsync()
    {
        if (_editingStock is null || _permanentDeleteSaving) return;
        var stock = _editingStock;
        _permanentDeleteSaving = true;
        _permanentDeleteError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) { _permanentDeleteError = "Войдите в приложение и повторите попытку."; return; }
            using var response = await client.DeleteAsync($"Stocks/{stock.Id}/permanent");
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _permanentDeleteError = ExtractApiErrorMessage(body) ?? $"Не удалось удалить акцию (HTTP {(int)response.StatusCode}).";
                return;
            }

            _permanentDeleteConfirmationOpen = false;
            _stockModalOpen = false;
            _editingStock = null;
            _refreshMessage = $"Акция {stock.Ticker} удалена полностью.";
            await LoadTrackedStocksAsync();
        }
        catch { _permanentDeleteError = "Не удалось связаться с API."; }
        finally { _permanentDeleteSaving = false; }
    }

    private static string? ExtractApiErrorMessage(string body)
    {
        if (string.IsNullOrWhiteSpace(body)) return null;
        try
        {
            using var document = JsonDocument.Parse(body);
            var root = document.RootElement;
            foreach (var name in new[] { "message", "title", "detail" })
                if (root.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String)
                    return value.GetString();
        }
        catch (JsonException) { }
        return body;
    }

