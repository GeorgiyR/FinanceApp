    private TrackedStockFiltersViewModel NormalizeFilters(TrackedStockFiltersViewModel filters)
    {
        var exchanges = new[] { "fra", "us" }.Where(filters.Exchanges.Contains).ToList();
        var activeSectors = _sectors.Where(sector => !sector.IsArchived).Select(sector => sector.Id).ToHashSet();
        var sectors = filters.SectorIds.Where(activeSectors.Contains).Distinct().Order().ToList();
        var activeIndustries = _sectors.Where(sector => !sector.IsArchived && (sectors.Count == 0 || sectors.Contains(sector.Id)))
            .SelectMany(sector => sector.Industries.Where(industry => !industry.IsArchived).Select(industry => industry.Id)).ToHashSet();
        var industries = filters.IndustryIds.Where(activeIndustries.Contains).Distinct().Order().ToList();
        return new() { Exchanges = exchanges, SectorIds = sectors, IndustryIds = industries };
    }

    private static TrackedStockFiltersViewModel CopyFilters(TrackedStockFiltersViewModel filters) => new()
    {
        Exchanges = [.. filters.Exchanges], SectorIds = [.. filters.SectorIds], IndustryIds = [.. filters.IndustryIds]
    };

    private bool MatchesCurrentFilters(TrackedStockViewModel stock)
    {
        if (MatchesSearch(stock, _search) is false) return false;
        if (_advancedFilters.Exchanges.Count > 0)
        {
            var group = stock.Exchange.Equals("Frankfurt", StringComparison.OrdinalIgnoreCase) ? "fra"
                : stock.Exchange.Equals("NYSE", StringComparison.OrdinalIgnoreCase) || stock.Exchange.Equals("NASDAQ", StringComparison.OrdinalIgnoreCase) ? "us" : null;
            if (group is null || !_advancedFilters.Exchanges.Contains(group)) return false;
        }
        var industryId = stock.IndustryId ?? stock.Industry?.Id;
        var sectorId = stock.Industry?.Sector?.Id ?? stock.Industry?.SectorId ?? stock.SectorId ?? stock.Sector?.Id;
        if (sectorId is null && industryId is int id && _industryToSector.TryGetValue(id, out var resolved)) sectorId = resolved;
        return (_advancedFilters.SectorIds.Count == 0 || (sectorId is not null && _advancedFilters.SectorIds.Contains(sectorId.Value)))
            && (_advancedFilters.IndustryIds.Count == 0 || (industryId is not null && _advancedFilters.IndustryIds.Contains(industryId.Value)));
    }

    private async Task LoadPerformanceAsync(string range)
    {
        var requestId = ++_performanceRequestId;
        _performanceLoading = true;
        _performanceError = null;
        _performanceByStockId.Clear();
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) { _performanceError = "Войдите в приложение, чтобы загрузить рост за период."; return; }
            using var response = await client.GetAsync($"Stocks/catalog/performance?range={Uri.EscapeDataString(range)}");
            if (!response.IsSuccessStatusCode) { _performanceError = "Не удалось загрузить данные о росте."; return; }
            var result = await response.Content.ReadFromJsonAsync<StockPerformanceResponse>(JsonOptions);
            if (requestId != _performanceRequestId) return;
            foreach (var item in result?.Items ?? []) _performanceByStockId[item.StockId] = item.ChangePercent;
        }
        catch { if (requestId == _performanceRequestId) _performanceError = "Не удалось загрузить данные о росте."; }
        finally { if (requestId == _performanceRequestId) _performanceLoading = false; }
    }

    private void ReadQueryState()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _search = query.TryGetValue("tq", out var search) ? search.ToString().Trim() : string.Empty;
        var sort = query.TryGetValue("tsort", out var sortValue) ? sortValue.ToString() : "name";
        _sortMode = SupportedSortModes.Contains(sort, StringComparer.Ordinal) ? sort : "name";
        _sortDirection = query.TryGetValue("tdir", out var direction) && direction == "asc" ? "asc" : "desc";
        _advancedFilters = new()
        {
            Exchanges = ParseCsv(query, "texchanges").Where(value => value is "fra" or "us").Distinct().OrderBy(value => value == "fra" ? 0 : 1).ToList(),
            SectorIds = ParseIds(query, "tsectors"),
            IndustryIds = ParseIds(query, "tindustries")
        };
        _filterDraft = CopyFilters(_advancedFilters);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            var previousSort = _sortMode;
            ReadQueryState();
            if (previousSort != _sortMode)
            {
                if (_sortMode == "name")
                {
                    _performanceRequestId++;
                    _performanceByStockId.Clear();
                    _performanceLoading = false;
                    _performanceError = null;
                }
                else await LoadPerformanceAsync(_sortMode);
            }
            await InvokeAsync(StateHasChanged);
        });
    }

    private void CommitQueryState(bool replace)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query).ToDictionary(pair => pair.Key, pair => pair.Value.ToString(), StringComparer.OrdinalIgnoreCase);
        foreach (var key in new[] { "tq", "tsort", "tdir", "texchanges", "tsectors", "tindustries" }) query.Remove(key);
        if (!string.IsNullOrWhiteSpace(_search)) query["tq"] = _search.Trim();
        if (_sortMode != "name") query["tsort"] = _sortMode;
        if (_sortMode != "name" && _sortDirection != "desc") query["tdir"] = _sortDirection;
        if (_advancedFilters.Exchanges.Count > 0) query["texchanges"] = string.Join(",", _advancedFilters.Exchanges);
        if (_advancedFilters.SectorIds.Count > 0) query["tsectors"] = string.Join(",", _advancedFilters.SectorIds);
        if (_advancedFilters.IndustryIds.Count > 0) query["tindustries"] = string.Join(",", _advancedFilters.IndustryIds);
        var queryText = string.Join('&', query.Select(pair => $"{Uri.EscapeDataString(pair.Key)}={Uri.EscapeDataString(pair.Value)}"));
        var next = uri.GetLeftPart(UriPartial.Path) + (queryText.Length > 0 ? $"?{queryText}" : string.Empty) + uri.Fragment;
        Navigation.NavigateTo(next, new NavigationOptions { ReplaceHistoryEntry = replace });
    }

