@page "/portfolios"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject UiLanguageService L
@implements IDisposable

<PageTitle>Stockpilot</PageTitle>

<div class="portfolio-page">
    <div class="portfolio-page-heading">
        <div>
            <h1>@L.T("portfolios.title")</h1>
            <p class="portfolio-page-description">@L.T("portfolios.subtitle")</p>
        </div>
        <div class="portfolio-heading-actions">
            <button class="portfolio-primary-button" @onclick="OpenCreateDialog" disabled="@_busy">
                @L.T("portfolios.add")
            </button>
            <button class="portfolio-refresh-button" @onclick="LoadPortfoliosAsync" disabled="@_loading">
                @L.T("common.refresh")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <div class="portfolio-refresh-notice" role="status">@_actionMessage</div>
    }

    @if (_loading)
    {
        <div class="portfolio-state">@L.T("portfolios.loading")</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="portfolio-state portfolio-state-error" role="alert">
            <p>@_error</p>
            @if (_requiresLogin)
            {
                <a class="portfolio-login-link" href="/stockpilot/login">@L.T("nav.login")</a>
            }
            <button class="portfolio-refresh-button" @onclick="LoadPortfoliosAsync">@L.T("common.retry")</button>
        </div>
    }
    else if (_portfolios.Count == 0)
    {
        <div class="portfolio-state">@L.T("portfolios.empty")</div>
    }
    else
    {
        <div class="portfolio-list">
            @foreach (var portfolio in _portfolios)
            {
                var canDelete = (portfolio.Items?.Count ?? 0) == 0;
                <div class="portfolio-card">
                    <a class="portfolio-card-link" href="@($"/stockpilot/portfolios/{portfolio.Id}")">
                        <div class="portfolio-card-heading">
                            <h2>@portfolio.Name @if (portfolio.IsDemo) { <span class="portfolio-demo-tag" title="Демо-портфель">Демо</span> }</h2>
                            <span class="portfolio-card-arrow" aria-hidden="true">→</span>
                        </div>
                        <div class="portfolio-card-meta">
                            <span>@L.T("portfolios.positions"): @(portfolio.Items?.Count ?? 0)</span>
                            <span>@L.T("portfolios.orders"): @(portfolio.Orders?.Count ?? 0)</span>
                        </div>
                    </a>
                    <div class="portfolio-card-actions">
                        <button type="button" class="action-icon-button" title="@L.T("portfolios.edit")" aria-label="@L.T("portfolios.edit")" disabled="@_busy" @onclick="() => OpenEditDialog(portfolio)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m3 14.8-.8 3 3-.8L16.8 5.4a1.8 1.8 0 0 0-2.6-2.6L3 14.8Zm9.9-9.9 2.6 2.6" /></svg>
                        </button>
                        <button type="button" class="action-icon-button action-delete-button portfolio-card-delete"
                            title="@(canDelete ? L.T("portfolios.delete") : L.T("portfolios.cannotDelete"))"
                            aria-label="@L.T("portfolios.delete")"
                            disabled="@(!canDelete || _busy)"
                            @onclick="() => DeletePortfolioAsync(portfolio)">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14m-9 0V3h4v2m3 0-.8 12H5.8L5 5m3 3v6m4-6v6" /></svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_createOpen)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseCreateDialog">
        <section class="action-dialog" role="dialog" aria-modal="true" aria-labelledby="create-portfolio-title" @onclick:stopPropagation>
            <h2 id="create-portfolio-title">@L.T("portfolios.createTitle")</h2>
            @if (!string.IsNullOrWhiteSpace(_createError))
            {
                <div class="login-error" role="alert">@_createError</div>
            }
            <EditForm Model="_createForm" OnValidSubmit="CreatePortfolioAsync" FormName="portfolio-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="login-field">
                    <label for="portfolio-name">@L.T("common.name")</label>
                    <input id="portfolio-name" type="text" @bind="_createForm.Name" @bind:event="oninput" disabled="@_busy" />
                </div>
                <label class="portfolio-demo-checkbox">
                    <input type="checkbox" @bind="_createForm.IsDemo" disabled="@_busy" />
                    @L.T("common.demo")
                </label>
                <div class="dialog-actions">
                    <button type="button" class="portfolio-refresh-button" @onclick="CloseCreateDialog" disabled="@_busy">@L.T("common.cancel")</button>
                    <button type="submit" class="login-submit" disabled="@_busy">@(_busy ? L.T("common.saving") : L.T("common.create"))</button>
                </div>
            </EditForm>
        </section>
    </div>
}

@if (_editOpen && _editingPortfolio is not null)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseEditDialog">
        <section class="action-dialog" role="dialog" aria-modal="true" aria-labelledby="edit-portfolio-title" @onclick:stopPropagation>
            <h2 id="edit-portfolio-title">@L.T("portfolios.editTitle")</h2>
            @if (!string.IsNullOrWhiteSpace(_editError))
            {
                <div class="login-error" role="alert">@_editError</div>
            }
            <EditForm Model="_editForm" OnValidSubmit="UpdatePortfolioAsync" FormName="portfolio-edit-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="login-field">
                    <label for="edit-portfolio-name">@L.T("common.name")</label>
                    <input id="edit-portfolio-name" type="text" @bind="_editForm.Name" @bind:event="oninput" disabled="@_busy" />
                </div>
                <label class="portfolio-demo-checkbox">
                    <input type="checkbox" @bind="_editForm.IsDemo" disabled="@_busy" />
                    @L.T("common.demo")
                </label>
                <div class="dialog-actions">
                    <button type="button" class="portfolio-refresh-button" @onclick="CloseEditDialog" disabled="@_busy">@L.T("common.cancel")</button>
                    <button type="submit" class="login-submit" disabled="@_busy">@(_busy ? L.T("common.saving") : L.T("common.save"))</button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private List<PortfolioSummary> _portfolios = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _actionMessage;
    private bool _requiresLogin;
    private bool _createOpen;
    private string? _createError;
    private readonly CreatePortfolioForm _createForm = new();
    private bool _editOpen;
    private string? _editError;
    private PortfolioSummary? _editingPortfolio;
    private readonly PortfolioEditForm _editForm = new();
    private IJSObjectReference? _apiModule;

    protected override void OnInitialized()
    {
        L.Changed += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPortfoliosAsync();
        }
    }

    private async Task LoadPortfoliosAsync()
    {
        _loading = true;
        _error = null;
        _requiresLogin = false;
        StateHasChanged();

        try
        {
            _apiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
            var token = await _apiModule.InvokeAsync<string?>("getToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                _error = "Войдите в приложение, чтобы увидеть свои портфели.";
                _requiresLogin = true;
                return;
            }

            using var client = HttpClientFactory.CreateClient("FinanceApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var response = await client.GetAsync("Portfolios");

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                _error = "Сессия истекла. Войдите в приложение и попробуйте снова.";
                _requiresLogin = true;
            }
            else if (!response.IsSuccessStatusCode)
            {
                _error = $"Не удалось загрузить портфели (HTTP {(int)response.StatusCode}).";
            }
            else
            {
                _portfolios = await response.Content.ReadFromJsonAsync<List<PortfolioSummary>>(JsonOptions) ?? [];
            }
        }
        catch (Exception)
        {
            _error = "Не удалось связаться с API. Проверьте его адрес в настройках и повторите попытку.";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenCreateDialog()
    {
        _createError = null;
        _createForm.Name = string.Empty;
        _createOpen = true;
    }

    private void CloseCreateDialog()
    {
        if (_busy) return;
        _createOpen = false;
    }

    private async Task CreatePortfolioAsync()
    {
        if (_busy) return;

        _busy = true;
        _createError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _createError = "Войдите в приложение, чтобы создать портфель.";
                return;
            }

            using var response = await client.PostAsJsonAsync("Portfolios", new { name = _createForm.Name.Trim(), isDemo = _createForm.IsDemo });
            if (!response.IsSuccessStatusCode)
            {
                _createError = $"Не удалось создать портфель (HTTP {(int)response.StatusCode}).";
                return;
            }

            _createOpen = false;
            _actionMessage = "Портфель создан.";
            await LoadPortfoliosAsync();
        }
        catch (Exception)
        {
            _createError = "Не удалось создать портфель.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenEditDialog(PortfolioSummary portfolio)
    {
        if (_busy) return;
        _editError = null;
        _editingPortfolio = portfolio;
        _editForm.Name = portfolio.Name;
        _editForm.IsDemo = portfolio.IsDemo;
        _editOpen = true;
    }

    private void CloseEditDialog()
    {
        if (_busy) return;
        _editOpen = false;
        _editingPortfolio = null;
    }

    private async Task UpdatePortfolioAsync()
    {
        if (_busy || _editingPortfolio is null) return;

        _busy = true;
        _editError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _editError = "Войдите в приложение, чтобы изменить портфель.";
                return;
            }

            using var response = await client.PutAsJsonAsync(
                $"Portfolios/{_editingPortfolio.Id}",
                new { name = _editForm.Name.Trim(), isDemo = _editForm.IsDemo });

            if (!response.IsSuccessStatusCode)
            {
                _editError = $"Не удалось сохранить портфель (HTTP {(int)response.StatusCode}).";
                return;
            }

            _editingPortfolio.Name = _editForm.Name.Trim();
            _editingPortfolio.IsDemo = _editForm.IsDemo;
            _editOpen = false;
            _editingPortfolio = null;
            _actionMessage = "Портфель обновлён.";
        }
        catch (Exception)
        {
            _editError = "Не удалось сохранить портфель.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeletePortfolioAsync(PortfolioSummary portfolio)
    {
        if (_busy || (portfolio.Items?.Count ?? 0) > 0) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить портфель «{portfolio.Name}»?")) return;

        _busy = true;
        _actionMessage = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _actionMessage = "Войдите в приложение, чтобы удалить портфель.";
                return;
            }

            using var response = await client.DeleteAsync($"Portfolios/{portfolio.Id}");
            if (!response.IsSuccessStatusCode)
            {
                _actionMessage = "Не удалось удалить портфель.";
                return;
            }

            _actionMessage = "Портфель удалён.";
            await LoadPortfoliosAsync();
        }
        catch (Exception)
        {
            _actionMessage = "Не удалось удалить портфель.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<HttpClient?> CreateAuthenticatedClientAsync()
    {
        _apiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
        var token = await _apiModule.InvokeAsync<string?>("getToken");
        if (string.IsNullOrWhiteSpace(token)) return null;

        var client = HttpClientFactory.CreateClient("FinanceApi");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    private sealed class PortfolioSummary
    {
        public PortfolioSummary() { }
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool IsDemo { get; set; }
        public List<JsonElement>? Items { get; set; } = [];
        public List<JsonElement>? Orders { get; set; } = [];
    }

    private sealed class CreatePortfolioForm
    {
        [Required(ErrorMessage = "Укажите название портфеля.")]
        [StringLength(100, ErrorMessage = "Название не должно превышать 100 символов.")]
        public string Name { get; set; } = string.Empty;
        public bool IsDemo { get; set; }
    }

    private sealed class PortfolioEditForm
    {
        [Required(ErrorMessage = "Укажите название портфеля.")]
        [StringLength(100, ErrorMessage = "Название не должно превышать 100 символов.")]
        public string Name { get; set; } = string.Empty;
        public bool IsDemo { get; set; }
    }

    public void Dispose()
    {
        L.Changed -= OnLanguageChanged;
    }
}


