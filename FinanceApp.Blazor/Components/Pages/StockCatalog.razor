@page "/stocks/catalog"
@using System.Globalization
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@using FinanceApp.Blazor.Components.Models
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Список акций</PageTitle>

<div class="tracked-stocks-page">
    <div class="tracked-stocks-heading">
        <div><h1>Список акций</h1><p>Каталог всех акций в системе.</p></div>
        <div class="catalog-heading-actions">
            <button type="button" class="portfolio-primary-button" @onclick="OpenStockCreate">＋ Добавить акцию</button>
            <button type="button" class="portfolio-refresh-button" @onclick="LoadCatalogAsync" disabled="@_loading">@(_loading ? "Загрузка…" : "Обновить список")</button>
        </div>
    </div>

    <div class="tracked-stocks-toolbar">
        <input type="search" placeholder="Поиск: тикер, название, биржа, индекс" aria-label="Поиск акций" value="@_search" @oninput="OnSearchChanged" />
        <div class="tracked-stocks-filter-controls">
            <button type="button" class="stocks-toolbar-button" @onclick="OpenFilters" aria-label="Открыть расширенные фильтры">@(_activeFilterCount > 0 ? $"Фильтры ({_activeFilterCount})" : "Фильтры")</button>
            <button type="button" class="stocks-toolbar-button" @onclick="ResetFilters" disabled="@(_activeFilterCount == 0)" aria-label="Сбросить расширенные фильтры">Сбросить</button>
        </div>
        <label class="tracked-stocks-sort-label" for="catalog-stock-sort">Сортировка:</label>
        <select id="catalog-stock-sort" value="@_sortMode" @onchange="OnSortModeChanged" aria-label="Сортировка">
            <option value="name">По названию</option>
            <option value="today">Сегодня</option><option value="24h">24 ч.</option><option value="1w">1 нед.</option>
            <option value="1m">1 мес.</option><option value="3m">3 мес.</option><option value="6m">6 мес.</option>
            <option value="1y">1 год</option><option value="3y">3 года</option><option value="5y">5 лет</option>
        </select>
        @if (_sortMode != "name")
        {
            <button type="button" class="stocks-toolbar-button stocks-sort-direction" @onclick="ToggleSortDirection" aria-label="@(_sortDirection == "desc" ? "Сортировать по возрастанию" : "Сортировать по убыванию")" title="@(_sortDirection == "desc" ? "Убывание" : "Возрастание")">@(_sortDirection == "desc" ? "↓" : "↑")</button>
        }
        <span>Найдено: @FilteredStocks.Count() из @_stocks.Count</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_notice)) { <div class="tracked-stocks-notice" role="status">@_notice</div> }
    @if (_loading)
    {
        <div class="portfolio-state">Загрузка списка акций…</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="portfolio-state portfolio-state-error" role="alert"><p>@_error</p><button type="button" class="portfolio-refresh-button" @onclick="LoadCatalogAsync">Повторить</button></div>
    }
    else if (!FilteredStocks.Any())
    {
        <div class="portfolio-state">Акции не найдены.</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_performanceError)) { <div class="tracked-stocks-performance-error">@_performanceError</div> }
        <div class="positions-table-wrap catalog-table-wrap">
            <table class="positions-table catalog-stocks-table">
                <thead><tr><th>Тикер</th><th>Название</th>@if (_sortMode != "name") { <th class="numeric">Рост за период</th> }<th>Сектор / отрасль</th><th>Биржа</th><th class="numeric">Текущая цена</th><th>Индексы</th><th>Статус</th><th class="actions-heading">Действия</th></tr></thead>
                <tbody>
                    @foreach (var stock in PagedStocks)
                    {
                        var isTracked = stock.TrackingStatus == 1;
                        var expanded = _expandedStockId == stock.Id;
                        <tr>
                            <td class="ticker-cell">
                                <button type="button" class="ticker-chart-toggle" aria-expanded="@expanded" aria-controls="catalog-history-@stock.Id" @onclick="() => ToggleHistory(stock.Id)"><span class="ticker-chart-caret @(expanded ? "expanded" : "")">›</span>@stock.Ticker</button>
                                <span class="ticker-exchange-abbreviation" title="@stock.Exchange">@ExchangeAbbreviation(stock.Exchange)</span>
                            </td>
                            <td><div class="catalog-stock-name">@stock.Name@if (!string.IsNullOrWhiteSpace(stock.CommonName) && stock.CommonName != stock.Name) { <small>@stock.CommonName</small> }</div></td>
                            @if (_sortMode != "name")
                            {
                                <td class="numeric">
                                    @if (_performanceLoading) { <span class="catalog-stock-status">…</span> }
                                    else if (_performanceByStockId.TryGetValue(stock.Id, out var changePercent) && changePercent is decimal performance) { <span class="@ProfitClass(performance)">@FormatSignedPercent(performance)</span> }
                                    else { <span class="catalog-stock-status" title="Недостаточно исторических данных">—</span> }
                                </td>
                            }
                            <td>@(stock.Industry?.Name ?? stock.Sector?.Name ?? "—")</td>
                            <td>@stock.Exchange</td>
                            <td class="numeric">@FormatMoney(stock.CurrentPrice)</td>
                            <td><div class="catalog-index-tags">@if (stock.MarketIndexIds.Count == 0) { <span>—</span> } else { @foreach (var id in stock.MarketIndexIds) { <span>@(_marketIndexNameById.TryGetValue(id, out var name) ? name : $"#{id}")</span> } }</div></td>
                            <td><span class="catalog-stock-status @(isTracked ? "is-tracked" : "")">@(isTracked ? "Отслеживается" : "В каталоге")</span></td>
                            <td class="catalog-stock-actions">
                                <button type="button" class="action-icon-button" title="Обновить цену" aria-label="Обновить цену @stock.Ticker" disabled="@(_refreshingStockId == stock.Id)" @onclick="() => RefreshStockPriceAsync(stock)"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16.5 7.5A6.8 6.8 0 0 0 4.7 5.2L3 7m0 0V3.5M3 7h3.5M3.5 12.5a6.8 6.8 0 0 0 11.8 2.3l1.7-1.8m0 0v3.5m0-3.5h-3.5" /></svg></button>
                                <button type="button" class="action-icon-button" title="Фундаментальные данные" aria-label="Фундаментальные данные для @stock.Ticker" @onclick="() => OpenFundamentals(stock)"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.2a7.8 7.8 0 1 0 0 15.6 7.8 7.8 0 0 0 0-15.6Zm0 3.1v.1m0 2.4v5.1" /></svg></button>
                                <button type="button" class="action-icon-button" title="Редактировать акцию" aria-label="Редактировать акцию @stock.Ticker" @onclick="() => OpenStockEdit(stock)"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m3 14.8-.8 3 3-.8L16.8 5.4a1.8 1.8 0 0 0-2.6-2.6L3 14.8Zm9.9-9.9 2.6 2.6" /></svg></button>
                                @if (!isTracked)
                                {
                                    <button type="button" class="action-icon-button catalog-track-icon" title="Добавить в отслеживаемые" aria-label="Добавить @stock.Ticker в отслеживаемые" disabled="@(_trackingStockId == stock.Id)" @onclick="() => TrackStockAsync(stock)">
                                        @if (_trackingStockId == stock.Id) { <span aria-hidden="true">…</span> }
                                        else { <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m10 2.2 2.35 4.76 5.25.76-3.8 3.7.9 5.23L10 14.18l-4.7 2.47.9-5.23-3.8-3.7 5.25-.76L10 2.2Z" /></svg> }
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (expanded)
                        {
                            <tr id="catalog-history-@stock.Id" class="position-history-row"><td colspan="@(_sortMode == "name" ? 8 : 9)"><StockHistoryPanel Stock="ToHistoryStock(stock)" /></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (PageCount > 1)
        {
            <div class="catalog-pagination">
                <button type="button" class="stocks-toolbar-button" @onclick="PreviousPage" disabled="@(_page == 1)">← Назад</button>
                <span>Страница @_page из @PageCount</span>
                <button type="button" class="stocks-toolbar-button" @onclick="NextPage" disabled="@(_page == PageCount)">Вперёд →</button>
            </div>
        }
    }
</div>

@if (_filtersOpen)
{
    <div class="tracked-filters-backdrop" role="presentation" @onclick="CloseFilters">
        <aside class="tracked-filters-drawer" role="dialog" aria-modal="true" aria-labelledby="catalog-filter-title" @onclick:stopPropagation>
            <header><h2 id="catalog-filter-title">Расширенные фильтры</h2><button type="button" class="dialog-close-button" aria-label="Закрыть фильтры" @onclick="CloseFilters">×</button></header>
            <div class="tracked-filter-content">
                <section class="tracked-filter-section">
                    <h3>Биржа</h3>
                    <label><input type="checkbox" checked="@IsFrankfurtFilterSelected" @onchange="ToggleFrankfurtFilter" /> Frankfurt (FRA)</label>
                    <label><input type="checkbox" checked="@IsUsFilterSelected" @onchange="ToggleUsFilter" /> США (NYSE + NASDAQ)</label>
                </section>
                <section class="tracked-filter-section">
                    <h3>Сектор</h3>
                    @foreach (var sector in _sectors.Where(sector => !sector.IsArchived).OrderBy(sector => sector.Name, StringComparer.CurrentCultureIgnoreCase))
                    {
                        <label><input type="checkbox" checked="@_filterDraft.SectorIds.Contains(sector.Id)" @onchange="args => ToggleSector(sector.Id, args)" /> @sector.Name</label>
                    }
                </section>
                <section class="tracked-filter-section">
                    <h3>Отрасль</h3>
                    @foreach (var industry in AvailableIndustries)
                    {
                        <label><input type="checkbox" checked="@_filterDraft.IndustryIds.Contains(industry.Id)" @onchange="args => ToggleIndustry(industry.Id, args)" /> @industry.Name</label>
                    }
                </section>
            </div>
            <footer>
                <button type="button" class="dialog-secondary-button" @onclick="ClearFilterDraft">Очистить</button>
                <button type="button" class="portfolio-primary-button" @onclick="ApplyFilters">Применить фильтры</button>
            </footer>
        </aside>
    </div>
}

@if (_createModalOpen || _editingStock is not null)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseStockEdit">
        <section class="action-dialog stock-edit-dialog" role="dialog" aria-modal="true" aria-labelledby="catalog-stock-edit-title" @onclick:stopPropagation>
            <h2 id="catalog-stock-edit-title">@(_editingStock is null ? "Добавить акцию" : "Редактировать акцию")</h2>
            @if (_editingStock is not null) { <p class="action-dialog-subtitle">@_editingStock.Ticker · @_editingStock.Name</p> }
            <EditForm Model="@_editForm" OnValidSubmit="SaveStockEditAsync" FormName="catalog-stock-edit-form">
                <DataAnnotationsValidator /><ValidationSummary />
                @if (!string.IsNullOrWhiteSpace(_editError)) { <div class="portfolio-state-error" role="alert">@_editError</div> }
                <div class="stock-edit-grid">
                    <label class="login-field">Тикер<InputText @bind-Value="_editForm.Ticker" disabled="@(_editingStock is not null && !_identityEditingEnabled)" /></label>
                    <label class="login-field">Биржа<InputSelect @bind-Value="_editForm.Exchange" disabled="@(_editingStock is not null && !_identityEditingEnabled)"><option value="Frankfurt">Frankfurt</option><option value="NASDAQ">NASDAQ</option><option value="NYSE">NYSE</option></InputSelect></label>
                    <label class="login-field">Название<InputText @bind-Value="_editForm.Name" /></label>
                    <label class="login-field">Общее название<InputText @bind-Value="_editForm.CommonName" /></label>
                    <label class="login-field">ISIN<InputText @bind-Value="_editForm.Isin" /></label>
                    <label class="login-field">WKN<InputText @bind-Value="_editForm.Wkn" /></label>
                    <label class="login-field">Сектор<InputSelect TValue="int?" Value="@_editForm.SectorId" ValueChanged="OnEditSectorChanged" ValueExpression="@(() => _editForm.SectorId)"><option value="">Без сектора</option>@foreach (var sector in EditSectors) { <option value="@sector.Id">@sector.Name@(sector.IsArchived ? " (архив)" : "")</option> }</InputSelect></label>
                    <label class="login-field">Отрасль<InputSelect @bind-Value="_editForm.IndustryId"><option value="">Без отрасли</option>@foreach (var industry in EditIndustries) { <option value="@industry.Id">@industry.Name@(industry.IsArchived ? " (архив)" : "")</option> }</InputSelect></label>
                    <label class="login-field">Текущая цена (€)<InputNumber @bind-Value="_editForm.CurrentPrice" step="0.01" /></label>
                    <label class="login-field">Finanzen.net slug<InputText @bind-Value="_editForm.FinanzenNetSlug" /></label>
                </div>
                <fieldset class="stock-edit-indices"><legend>Биржевые индексы</legend>
                    @foreach (var index in EditMarketIndices) { <label><input type="checkbox" checked="@_editForm.MarketIndexIds.Contains(index.Id)" @onchange="args => ToggleEditMarketIndex(index.Id, args)" /> @index.Name@(index.IsArchived ? " (архив)" : "")</label> }
                </fieldset>
                @if (_editingStock is not null && !_identityEditingEnabled) { <button type="button" class="dialog-secondary-button" @onclick="EnableIdentityEditAsync">Изменить тикер / биржу</button> }
                else if (_editingStock is not null) { <p class="stock-edit-warning">Изменение тикера или биржи очищает историю котировок и provider-данные инструмента.</p> }
                <footer class="stock-edit-footer"><button type="button" class="dialog-secondary-button" @onclick="CloseStockEdit" disabled="@_editSaving">Отмена</button><button type="submit" class="portfolio-primary-button" disabled="@_editSaving">@(_editSaving ? "Сохранение…" : _editingStock is null ? "Добавить" : "Сохранить")</button></footer>
            </EditForm>
        </section>
    </div>
}

@if (_fundamentalsStock is not null)
{
    <StockFundamentalsPanel StockId="@_fundamentalsStock.Id" Ticker="@_fundamentalsStock.Ticker" Name="@_fundamentalsStock.Name" OnClose="CloseFundamentals" />
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private static readonly string[] SupportedSortModes = ["name", "today", "24h", "1w", "1m", "3m", "6m", "1y", "3y", "5y"];
    private readonly List<TrackedStockViewModel> _stocks = [];
    private readonly List<TrackedSectorDirectoryViewModel> _sectors = [];
    private readonly List<TrackedMarketIndexDirectoryViewModel> _marketIndices = [];
    private readonly Dictionary<int, string> _marketIndexNameById = [];
    private readonly Dictionary<int, int> _industryToSector = [];
    private readonly Dictionary<int, decimal?> _performanceByStockId = [];
    private string _search = string.Empty;
    private string _sortMode = "name";
    private string _sortDirection = "desc";
    private TrackedStockFiltersViewModel _advancedFilters = new();
    private TrackedStockFiltersViewModel _filterDraft = new();
    private string? _error;
    private string? _notice;
    private string? _performanceError;
    private bool _loading = true;
    private bool _filtersOpen;
    private bool _performanceLoading;
    private int _page = 1;
    private int _performanceRequestId;
    private int? _trackingStockId;
    private int? _refreshingStockId;
    private int? _expandedStockId;
    private TrackedStockViewModel? _fundamentalsStock;
    private TrackedStockViewModel? _editingStock;
    private CatalogStockEditModel _editForm = new();
    private bool _identityEditingEnabled;
    private bool _createModalOpen;
    private bool _editSaving;
    private string? _editError;
    private const int PageSize = 50;
    private bool IsFrankfurtFilterSelected => _filterDraft.Exchanges.Contains("fra");
    private bool IsUsFilterSelected => _filterDraft.Exchanges.Contains("us");
    private int _activeFilterCount => (_advancedFilters.Exchanges.Count > 0 ? 1 : 0)
        + (_advancedFilters.SectorIds.Count > 0 ? 1 : 0)
        + (_advancedFilters.IndustryIds.Count > 0 ? 1 : 0);
    private IEnumerable<TrackedIndustryDirectoryViewModel> AvailableIndustries
        => _sectors.Where(sector => !sector.IsArchived && (_filterDraft.SectorIds.Count == 0 || _filterDraft.SectorIds.Contains(sector.Id)))
            .SelectMany(sector => sector.Industries.Where(industry => !industry.IsArchived))
            .OrderBy(industry => industry.Name, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<TrackedStockViewModel> FilteredStocks
    {
        get
        {
            var matching = _stocks.Where(MatchesCurrentFilters);
            if (_sortMode == "name")
            {
                return matching
                    .OrderBy(stock => stock.Name, StringComparer.CurrentCultureIgnoreCase)
                    .ThenBy(stock => stock.Ticker, StringComparer.CurrentCultureIgnoreCase);
            }

            var direction = _sortDirection == "asc" ? 1 : -1;
            return matching
                .OrderByDescending(stock => _performanceByStockId.TryGetValue(stock.Id, out var score) && score is not null)
                .ThenBy(stock => _performanceByStockId.TryGetValue(stock.Id, out var score) ? score * direction : decimal.MinValue)
                .ThenBy(stock => stock.Id);
        }
    }
    private List<TrackedStockViewModel> PagedStocks => FilteredStocks.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredStocks.Count() / (double)PageSize));
    private IEnumerable<TrackedSectorDirectoryViewModel> EditSectors => _sectors.Where(s => !s.IsArchived || s.Id == _editForm.SectorId).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<TrackedIndustryDirectoryViewModel> EditIndustries => _sectors.Where(s => s.Id == _editForm.SectorId).SelectMany(s => s.Industries.Where(i => !i.IsArchived || i.Id == _editForm.IndustryId)).OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<TrackedMarketIndexDirectoryViewModel> EditMarketIndices => _marketIndices.Where(i => !i.IsArchived || _editForm.MarketIndexIds.Contains(i.Id)).OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase);

    protected override void OnInitialized()
    {
        ReadQueryState();
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        _loading = true; _error = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) { _error = "Войдите в приложение, чтобы увидеть список акций."; return; }
            using var response = await client.GetAsync("Stocks/catalog");
            if (response.StatusCode == HttpStatusCode.Unauthorized) { _error = "Войдите в приложение, чтобы увидеть список акций."; return; }
            if (!response.IsSuccessStatusCode) { _error = $"Не удалось загрузить список акций (HTTP {(int)response.StatusCode})."; return; }
            var stocks = await response.Content.ReadFromJsonAsync<List<TrackedStockViewModel>>(JsonOptions) ?? [];
            _stocks.Clear(); _stocks.AddRange(stocks);
            using var sectorsResponse = await client.GetAsync("Sectors?includeArchived=true");
            if (sectorsResponse.IsSuccessStatusCode)
            {
                var sectors = await sectorsResponse.Content.ReadFromJsonAsync<List<TrackedSectorDirectoryViewModel>>(JsonOptions) ?? [];
                _sectors.Clear(); _sectors.AddRange(sectors);
            }
            _industryToSector.Clear();
            foreach (var sector in _sectors)
                foreach (var industry in sector.Industries)
                    _industryToSector[industry.Id] = sector.Id;
            using var indicesResponse = await client.GetAsync("market-indices?includeArchived=true");
            if (indicesResponse.IsSuccessStatusCode)
            {
                var indices = await indicesResponse.Content.ReadFromJsonAsync<List<TrackedMarketIndexDirectoryViewModel>>(JsonOptions) ?? [];
                _marketIndices.Clear(); _marketIndices.AddRange(indices);
                _marketIndexNameById.Clear();
                foreach (var index in indices) _marketIndexNameById[index.Id] = index.Name;
            }
            _advancedFilters = NormalizeFilters(_advancedFilters);
            if (_page > PageCount) _page = PageCount;
            if (_sortMode != "name") await LoadPerformanceAsync(_sortMode);
        }
        catch { _error = "Не удалось связаться с API."; }
        finally { _loading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task<HttpClient?> CreateAuthenticatedClientAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
        try
        {
            var token = await module.InvokeAsync<string?>("getToken");
            if (string.IsNullOrWhiteSpace(token)) return null;
            var client = HttpClientFactory.CreateClient("FinanceApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            return client;
        }
        finally { await module.DisposeAsync(); }
    }

    private async Task TrackStockAsync(TrackedStockViewModel stock)
    {
        if (stock.TrackingStatus == 1 || _trackingStockId is not null) return;
        _trackingStockId = stock.Id; _notice = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) { _notice = "Войдите в приложение и повторите попытку."; return; }
            using var response = await client.PostAsync($"Stocks/{stock.Id}/track", null);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _notice = string.IsNullOrWhiteSpace(body) ? $"Не удалось добавить акцию в отслеживаемые (HTTP {(int)response.StatusCode})." : body;
                return;
            }
            stock.TrackingStatus = 1;
            _notice = $"{stock.Ticker} добавлена в отслеживаемые акции.";
        }
        catch { _notice = "Не удалось связаться с API."; }
        finally { _trackingStockId = null; }
    }

    private async Task RefreshStockPriceAsync(TrackedStockViewModel stock)
    {
        if (_refreshingStockId is not null) return;
        _refreshingStockId = stock.Id; _notice = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) { _notice = "Войдите в приложение и повторите попытку."; return; }
            var slug = string.IsNullOrWhiteSpace(stock.FinanzenNetSlug) ? string.Empty : $"&finanzenNetSlug={Uri.EscapeDataString(stock.FinanzenNetSlug)}";
            using var quoteResponse = await client.GetAsync($"StockPrice/{Uri.EscapeDataString(stock.Ticker)}?exchange={Uri.EscapeDataString(stock.Exchange)}{slug}");
            if (!quoteResponse.IsSuccessStatusCode) { _notice = $"Не удалось получить цену {stock.Ticker} (HTTP {(int)quoteResponse.StatusCode})."; return; }
            var quote = await quoteResponse.Content.ReadFromJsonAsync<StockLiveQuoteViewModel>(JsonOptions);
            if (quote?.CurrentPriceEur is not decimal price) { _notice = $"Для {stock.Ticker} не удалось получить цену в EUR."; return; }
            var update = new
            {
                currentPrice = Math.Round(price, 2, MidpointRounding.AwayFromZero),
                currentPriceChange = quote.ChangeEur is decimal change ? Math.Round(change, 4, MidpointRounding.AwayFromZero) : (decimal?)null,
                currentPriceChangePercent = quote.PercentChange is decimal percent ? Math.Round(percent, 4, MidpointRounding.AwayFromZero) : (decimal?)null,
                currentPriceAt = quote.PriceTimestampUtc,
                currentPriceIsDelayed = quote.IsStale || !string.IsNullOrWhiteSpace(quote.DelayWarning),
                currentPriceDelayWarning = string.IsNullOrWhiteSpace(quote.DelayWarning) ? null : quote.DelayWarning.Trim()
            };
            using var updateResponse = await client.PatchAsJsonAsync($"Stocks/{stock.Id}/quote", update);
            if (!updateResponse.IsSuccessStatusCode) { _notice = $"Не удалось сохранить цену {stock.Ticker} (HTTP {(int)updateResponse.StatusCode})."; return; }
            var snapshot = await updateResponse.Content.ReadFromJsonAsync<TrackedStockQuoteUpdateViewModel>(JsonOptions);
            if (snapshot is not null)
            {
                stock.CurrentPrice = snapshot.CurrentPrice;
                stock.CurrentPriceChange = snapshot.CurrentPriceChange;
                stock.CurrentPriceChangePercent = snapshot.CurrentPriceChangePercent;
                stock.CurrentPriceAt = snapshot.CurrentPriceAt;
                stock.CurrentPriceIsDelayed = snapshot.CurrentPriceIsDelayed;
                stock.CurrentPriceDelayWarning = snapshot.CurrentPriceDelayWarning;
            }
            stock.LiveQuote = quote;
            _notice = quote.IsStale || !string.IsNullOrWhiteSpace(quote.DelayWarning)
                ? $"Для {stock.Ticker} получена задержанная котировка."
                : $"Цена {stock.Ticker} обновлена.";
        }
        catch { _notice = $"Не удалось обновить цену {stock.Ticker}."; }
        finally { _refreshingStockId = null; }
    }

