@page "/market-indices"
@page "/market-indices/{Id:int}"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject FinanceApp.Blazor.Components.Services.MarketIndexNavigationService MarketIndexNavigation

<PageTitle>Мировые индексы</PageTitle>

<div class="tracked-stocks-page indices-page">
    <div class="tracked-stocks-heading">
        <div><h1>@HeaderTitle</h1></div>
        <div class="catalog-heading-actions">
            @if (ActiveIndex is null)
            {
                <button type="button" class="portfolio-refresh-button" @onclick="ToggleIncludeArchived" disabled="@_loading">@(_includeArchived ? "Скрыть архивные" : "Показать архивные")</button>
                <button type="button" class="portfolio-primary-button" @onclick="OpenCreate" disabled="@_loading">＋ Добавить индекс</button>
            }
            else if (Id is not null)
            {
                <button type="button" class="action-icon-button" title="Редактировать" aria-label="Редактировать индекс" @onclick="() => OpenEdit(ActiveIndex!)" disabled="@_actionSaving">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m3 14.8-.8 3 3-.8L16.8 5.4a1.8 1.8 0 0 0-2.6-2.6L3 14.8Zm9.9-9.9 2.6 2.6" /></svg>
                </button>
                @if (ActiveIndex.IsArchived)
                {
                    <button type="button" class="action-icon-button" title="Восстановить" aria-label="Восстановить индекс" @onclick="() => RestoreAsync(ActiveIndex!)" disabled="@_actionSaving">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 7.5a6.2 6.2 0 1 1-.4 4.4M4.5 7.5V3.7m0 3.8h3.8" /></svg>
                    </button>
                }
                else
                {
                    <button type="button" class="action-icon-button" title="Архивировать" aria-label="Архивировать индекс" @onclick="() => ArchiveAsync(ActiveIndex!)" disabled="@_actionSaving">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h14v4H3zM4 8v8h12V8M8 11h4" /></svg>
                    </button>
                }
                <button type="button" class="action-icon-button action-delete-button" title="Удалить индекс" aria-label="Удалить индекс" @onclick="() => DeleteAsync(ActiveIndex!)" disabled="@_actionSaving">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M8 6V4h4v2M6 6l1 10h6l1-10" /></svg>
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <div class="tracked-stocks-notice" role="status">@_notice</div>
    }

    @if (_loading)
    {
        <div class="portfolio-state">Загрузка индексов…</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="portfolio-state portfolio-state-error" role="alert"><p>@_error</p><button type="button" class="portfolio-refresh-button" @onclick="LoadAsync">Повторить</button></div>
    }
    else if (Id is not null && ActiveIndex is null)
    {
        <div class="portfolio-state">Индекс не найден</div>
    }
    else if (Id is not null)
    {
        @if (ActiveIndex!.IsArchived)
        {
            <div><span class="directory-archive-tag">Архив</span></div>
        }
        <div class="index-tabs" role="tablist" aria-label="Разделы индекса">
            <button type="button" role="tab" class="@(_indexTab == "chart" ? "active" : "")" aria-selected="@(_indexTab == "chart")" @onclick='() => SelectIndexTab("chart")'>График</button>
            <button type="button" role="tab" class="@(_indexTab == "constituents" ? "active" : "")" aria-selected="@(_indexTab == "constituents")" @onclick='() => SelectIndexTab("constituents")'>Состав</button>
        </div>
        <div class="index-tab-panel">
            @if (_indexTab == "chart")
            {
                <MarketIndexPriceChart IndexId="ActiveIndex!.Id" Code="@ActiveIndex!.Code" Name="@ActiveIndex!.Name" ProviderSymbol="@ActiveIndex!.ProviderSymbol" IsArchived="ActiveIndex!.IsArchived" PanelId="@GetPanelId(ActiveIndex!.Id)" />
            }
            else
            {
                <IndexConstituentsPanel IndexId="ActiveIndex!.Id" IsArchived="ActiveIndex!.IsArchived" />
            }
        </div>
    }
    else
    {
        <div class="tracked-stocks-toolbar">
            <input type="search" placeholder="Поиск по коду, названию, стране/региону или описанию..." aria-label="Поиск по мировым индексам" value="@_search" @oninput="OnSearchChanged" />
        </div>

        @if (!FilteredIndices.Any())
        {
            <div class="portfolio-state">Нет данных</div>
        }
        else
        {
            <div class="positions-table-wrap indices-table-wrap">
                <table class="positions-table indices-table">
                    <thead>
                        <tr>
                            <th>Код</th>
                            <th>Название</th>
                            <th>Страна / регион</th>
                            <th>Описание</th>
                            <th class="actions-heading">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var index in FilteredIndices)
                        {
                            var expanded = _expandedIndexId == index.Id;
                            <tr class="@(index.IsArchived ? "directory-row-archived" : "")">
                                <td>
                                    <button type="button" class="index-expand-button" aria-expanded="@expanded" aria-controls="index-chart-panel-@index.Id" aria-label="@(expanded ? $"Скрыть {index.Code}" : $"Показать {index.Code}")" @onclick="() => ToggleExpand(index)">
                                        <span class="ticker-chart-caret @(expanded ? "expanded" : "")">›</span>
                                        <strong>@index.Code</strong>
                                    </button>
                                    @if (index.IsArchived)
                                    {
                                        <span class="directory-archive-tag">Архив</span>
                                    }
                                </td>
                                <td>@index.Name</td>
                                <td>@index.CountryOrRegion</td>
                                <td class="index-description-cell">@(string.IsNullOrWhiteSpace(index.Description) ? "—" : index.Description)</td>
                                <td>
                                    <div class="directory-action-buttons">
                                        <button type="button" class="action-icon-button" title="Редактировать" aria-label="Редактировать индекс @index.Code" @onclick="() => OpenEdit(index)" disabled="@_actionSaving">
                                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m3 14.8-.8 3 3-.8L16.8 5.4a1.8 1.8 0 0 0-2.6-2.6L3 14.8Zm9.9-9.9 2.6 2.6" /></svg>
                                        </button>
                                        @if (index.IsArchived)
                                        {
                                            <button type="button" class="action-icon-button" title="Восстановить" aria-label="Восстановить индекс @index.Code" @onclick="() => RestoreAsync(index)" disabled="@_actionSaving">
                                                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 7.5a6.2 6.2 0 1 1-.4 4.4M4.5 7.5V3.7m0 3.8h3.8" /></svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="action-icon-button" title="Архивировать" aria-label="Архивировать индекс @index.Code" @onclick="() => ArchiveAsync(index)" disabled="@_actionSaving">
                                                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h14v4H3zM4 8v8h12V8M8 11h4" /></svg>
                                            </button>
                                        }
                                        <button type="button" class="action-icon-button action-delete-button" title="Удалить индекс" aria-label="Удалить индекс @index.Code" @onclick="() => DeleteAsync(index)" disabled="@_actionSaving">
                                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M8 6V4h4v2M6 6l1 10h6l1-10" /></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            @if (expanded)
                            {
                                <tr class="index-chart-panel-row">
                                    <td colspan="5">
                                        <div class="index-tabs index-tabs--embedded" role="tablist" aria-label="Разделы индекса @index.Code">
                                            <button type="button" role="tab" class="@(_expandedTab == "chart" ? "active" : "")" aria-selected="@(_expandedTab == "chart")" @onclick='() => SelectExpandedTab("chart")'>График</button>
                                            <button type="button" role="tab" class="@(_expandedTab == "constituents" ? "active" : "")" aria-selected="@(_expandedTab == "constituents")" @onclick='() => SelectExpandedTab("constituents")'>Состав</button>
                                        </div>
                                        <div class="index-chart-panel-content">
                                            @if (_expandedTab == "chart")
                                            {
                                                <MarketIndexPriceChart IndexId="index.Id" Code="@index.Code" Name="@index.Name" ProviderSymbol="@index.ProviderSymbol" IsArchived="index.IsArchived" PanelId="@GetPanelId(index.Id)" />
                                            }
                                            else
                                            {
                                                <IndexConstituentsPanel IndexId="index.Id" IsArchived="index.IsArchived" />
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@if (_modalOpen)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseModal">
        <section class="action-dialog index-dialog" role="dialog" aria-modal="true" aria-labelledby="index-dialog-title" @onclick:stopPropagation>
            <h2 id="index-dialog-title">@(_editingIndex is null ? "Добавить индекс" : "Редактировать индекс")</h2>
            <EditForm Model="@_form" OnValidSubmit="SaveAsync" FormName="market-index-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                @if (!string.IsNullOrWhiteSpace(_formError))
                {
                    <div class="portfolio-state-error" role="alert">@_formError</div>
                }
                <label class="login-field">Код<InputText @bind-Value="_form.Code" maxlength="50" /></label>
                <label class="login-field">Название<InputText @bind-Value="_form.Name" maxlength="200" /></label>
                <label class="login-field">
                    Символ поставщика (Yahoo Finance)
                    <InputText @bind-Value="_form.ProviderSymbol" placeholder="^GSPC" maxlength="50" />
                    <span class="index-field-hint">Например: ^GSPC, ^DJI, ^N225. Оставьте пустым, если символ недоступен.</span>
                </label>
                <label class="login-field">Страна / регион<InputText @bind-Value="_form.CountryOrRegion" /></label>
                <label class="login-field">Описание<InputTextArea @bind-Value="_form.Description" rows="4" /></label>
                <label class="login-field">Порядок сортировки<InputNumber @bind-Value="_form.SortOrder" min="0" /></label>
                <label class="index-checkbox-field">
                    <input type="checkbox" checked="@_form.ShowInNavigation" @onchange="OnShowInNavigationChanged" />
                    <span>Показывать в навигации</span>
                </label>
                <span class="index-field-hint">Отображать индекс отдельным пунктом в разделе «Мировые индексы»</span>
                <footer class="dialog-actions">
                    <button type="button" class="dialog-secondary-button" @onclick="CloseModal" disabled="@_formSaving">Отмена</button>
                    <button type="submit" class="portfolio-primary-button" disabled="@_formSaving">@(_formSaving ? "Сохранение…" : "Сохранить")</button>
                </footer>
            </EditForm>
        </section>
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    [Parameter] public int? Id { get; set; }

    private readonly List<MarketIndexDto> _indices = [];
    private bool _loading = true;
    private bool _actionSaving;
    private string? _error;
    private string? _notice;
    private bool _includeArchived = true;
    private string _search = string.Empty;
    private int? _expandedIndexId;
    private string _expandedTab = "chart";
    private string _indexTab = "chart";
    private int? _loadedRouteId;
    private bool _routeLoaded;

    private bool _modalOpen;
    private bool _formSaving;
    private string? _formError;
    private MarketIndexDto? _editingIndex;
    private MarketIndexFormModel _form = new();

    private MarketIndexDto? ActiveIndex => Id is int id ? _indices.FirstOrDefault(index => index.Id == id) : null;
    private string HeaderTitle => ActiveIndex is not null ? $"{ActiveIndex.Code} — {ActiveIndex.Name}" : "Мировые индексы";

    private IEnumerable<MarketIndexDto> FilteredIndices
    {
        get
        {
            var query = (_search ?? string.Empty).Trim();
            return _indices
                .Where(index => _includeArchived || !index.IsArchived)
                .Where(index => query.Length == 0
                    || Contains(index.Code, query)
                    || Contains(index.Name, query)
                    || Contains(index.CountryOrRegion, query)
                    || Contains(index.Description, query));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_routeLoaded || _loadedRouteId != Id)
        {
            _routeLoaded = true;
            _loadedRouteId = Id;
            _indexTab = "chart";
            _expandedIndexId = null;
            _expandedTab = "chart";
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _error = "Войдите в приложение, чтобы увидеть мировые индексы.";
                return;
            }
            using var response = await client.GetAsync("market-indices?includeArchived=true");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _error = "Войдите в приложение, чтобы увидеть мировые индексы.";
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                _error = "Ошибка загрузки данных";
                return;
            }
            var indices = await response.Content.ReadFromJsonAsync<List<MarketIndexDto>>(JsonOptions) ?? [];
            _indices.Clear();
            _indices.AddRange(indices);
        }
        catch
        {
            _error = "Не удалось связаться с API.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<HttpClient?> CreateAuthenticatedClientAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
        try
        {
            var token = await module.InvokeAsync<string?>("getToken");
            if (string.IsNullOrWhiteSpace(token)) return null;
            var client = HttpClientFactory.CreateClient("FinanceApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            return client;
        }
        finally
        {
            await module.DisposeAsync();
        }
    }

    private void ToggleIncludeArchived() => _includeArchived = !_includeArchived;

    private void SelectIndexTab(string tab) => _indexTab = tab;
    private void SelectExpandedTab(string tab) => _expandedTab = tab;
    private static string GetPanelId(int indexId) => $"index-chart-panel-{indexId}";

    private void OnSearchChanged(ChangeEventArgs args) => _search = args.Value?.ToString() ?? string.Empty;

    private void ToggleExpand(MarketIndexDto index)
    {
        if (_expandedIndexId == index.Id)
        {
            _expandedIndexId = null;
            return;
        }
        _expandedIndexId = index.Id;
        _expandedTab = "chart";
    }

    private void OpenCreate()
    {
        _editingIndex = null;
        _formError = null;
        _modalOpen = true;
        var maxSortOrder = _indices.Count == 0 ? 0 : _indices.Max(index => index.SortOrder);
        _form = new MarketIndexFormModel { SortOrder = maxSortOrder + 10, ShowInNavigation = true };
    }

    private void OpenEdit(MarketIndexDto index)
    {
        _editingIndex = index;
        _formError = null;
        _modalOpen = true;
        _form = new MarketIndexFormModel
        {
            Code = index.Code,
            Name = index.Name,
            ProviderSymbol = index.ProviderSymbol ?? string.Empty,
            Description = index.Description,
            CountryOrRegion = index.CountryOrRegion,
            SortOrder = index.SortOrder,
            ShowInNavigation = index.ShowInNavigation,
        };
    }

    private void CloseModal()
    {
        if (_formSaving) return;
        _modalOpen = false;
        _formError = null;
    }

    private void OnShowInNavigationChanged(ChangeEventArgs args) =>
        _form.ShowInNavigation = string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private async Task SaveAsync()
    {
        if (_formSaving) return;
        _formSaving = true;
        _formError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _formError = "Войдите в приложение и повторите попытку.";
                return;
            }
            var payload = new
            {
                code = _form.Code.Trim(),
                name = _form.Name.Trim(),
                providerSymbol = string.IsNullOrWhiteSpace(_form.ProviderSymbol) ? null : _form.ProviderSymbol.Trim(),
                description = _form.Description,
                countryOrRegion = _form.CountryOrRegion,
                sortOrder = _form.SortOrder,
                showInNavigation = _form.ShowInNavigation,
            };

            using var response = _editingIndex is null
                ? await client.PostAsJsonAsync("market-indices", payload)
                : await client.PutAsJsonAsync($"market-indices/{_editingIndex.Id}", payload);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _formError = ExtractApiErrorMessage(body) ?? $"Ошибка сохранения индекса (HTTP {(int)response.StatusCode}).";
                return;
            }

            _notice = _editingIndex is null ? "Индекс создан" : "Индекс обновлён";
            _modalOpen = false;
            await LoadAsync();
            MarketIndexNavigation.NotifyChanged();
        }
        catch
        {
            _formError = "Не удалось связаться с API.";
        }
        finally
        {
            _formSaving = false;
        }
    }

    private async Task ArchiveAsync(MarketIndexDto index)
    {
        if (_actionSaving) return;
        _actionSaving = true;
        _notice = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            using var response = await client.PostAsync($"market-indices/{index.Id}/archive", null);
            if (!response.IsSuccessStatusCode)
            {
                _notice = await BuildApiErrorAsync(response, "Ошибка архивирования индекса");
                return;
            }
            _notice = "Индекс архивирован";
            await LoadAsync();
            MarketIndexNavigation.NotifyChanged();
        }
        catch
        {
            _notice = "Ошибка архивирования индекса";
        }
        finally
        {
            _actionSaving = false;
        }
    }

    private async Task RestoreAsync(MarketIndexDto index)
    {
        if (_actionSaving) return;
        _actionSaving = true;
        _notice = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            using var response = await client.PostAsync($"market-indices/{index.Id}/restore", null);
            if (!response.IsSuccessStatusCode)
            {
                _notice = await BuildApiErrorAsync(response, "Ошибка восстановления индекса");
                return;
            }
            _notice = "Индекс восстановлен";
            await LoadAsync();
            MarketIndexNavigation.NotifyChanged();
        }
        catch
        {
            _notice = "Ошибка восстановления индекса";
        }
        finally
        {
            _actionSaving = false;
        }
    }

    private async Task DeleteAsync(MarketIndexDto index)
    {
        if (_actionSaving) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Удалить индекс?")) return;
        _actionSaving = true;
        _notice = null;
        var fromDetail = Id == index.Id;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            using var response = await client.DeleteAsync($"market-indices/{index.Id}");
            if (!response.IsSuccessStatusCode)
            {
                _notice = await BuildApiErrorAsync(response, "Невозможно удалить индекс");
                return;
            }
            _notice = "Индекс удалён";
            MarketIndexNavigation.NotifyChanged();
            if (fromDetail)
            {
                Navigation.NavigateTo("/market-indices");
                return;
            }
            await LoadAsync();
        }
        catch
        {
            _notice = "Невозможно удалить индекс";
        }
        finally
        {
            _actionSaving = false;
        }
    }

    private static bool Contains(string? value, string query) =>
        value?.Contains(query, StringComparison.CurrentCultureIgnoreCase) == true;

    private static string? ExtractApiErrorMessage(string body)
    {
        if (string.IsNullOrWhiteSpace(body)) return null;
        try
        {
            using var document = JsonDocument.Parse(body);
            if (document.RootElement.ValueKind == JsonValueKind.String) return document.RootElement.GetString();
            foreach (var key in new[] { "message", "detail", "title" })
            {
                if (document.RootElement.TryGetProperty(key, out var value) && value.ValueKind == JsonValueKind.String)
                {
                    var text = value.GetString();
                    if (!string.IsNullOrWhiteSpace(text)) return text;
                }
            }
        }
        catch (JsonException)
        {
        }
        return body.TrimStart().StartsWith('<') ? null : body;
    }

    private static async Task<string> BuildApiErrorAsync(HttpResponseMessage response, string fallback)
    {
        var body = await response.Content.ReadAsStringAsync();
        return ExtractApiErrorMessage(body) ?? $"{fallback} (HTTP {(int)response.StatusCode}).";
    }

    private sealed class MarketIndexDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string? ProviderSymbol { get; set; }
        public string Description { get; set; } = string.Empty;
        public string CountryOrRegion { get; set; } = string.Empty;
        public int SortOrder { get; set; }
        public bool IsArchived { get; set; }
        public bool ShowInNavigation { get; set; }
    }

    private sealed class MarketIndexFormModel
    {
        [Required(ErrorMessage = "Введите код")]
        [StringLength(50, ErrorMessage = "Код не длиннее 50 символов.")]
        public string Code { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите название")]
        [StringLength(200, ErrorMessage = "Название не длиннее 200 символов.")]
        public string Name { get; set; } = string.Empty;

        [StringLength(50, ErrorMessage = "Символ поставщика не длиннее 50 символов.")]
        public string ProviderSymbol { get; set; } = string.Empty;

        public string CountryOrRegion { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int SortOrder { get; set; }
        public bool ShowInNavigation { get; set; } = true;
    }
}
