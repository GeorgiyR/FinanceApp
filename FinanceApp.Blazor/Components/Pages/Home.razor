@page "/"
@using System.Globalization
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject UiLanguageService L
@implements IDisposable

<PageTitle>Stockpilot</PageTitle>

<div class="earnings-calendar-page">
    <div class="earnings-calendar-heading">
        <div>
            <h1>@L.T("home.title")</h1>
            <p class="earnings-calendar-description">@L.T("home.subtitle")</p>
            <p class="earnings-calendar-hint">@L.T("home.hint")</p>
        </div>
        <div class="earnings-calendar-controls">
            <label for="earnings-upcoming">@L.T("home.forward")
                <select id="earnings-upcoming" @bind="_upcomingDays" @bind:after="LoadAsync">
                    <option value="30">30 @L.T("home.days")</option>
                    <option value="90">90 @L.T("home.days")</option>
                </select>
            </label>
            <label for="earnings-past">@L.T("home.back")
                <select id="earnings-past" @bind="_pastDays" @bind:after="LoadAsync">
                    <option value="14">14 @L.T("home.days")</option>
                    <option value="30">30 @L.T("home.days")</option>
                </select>
            </label>
            <button type="button" class="portfolio-refresh-button" @onclick="LoadAsync" disabled="@_loading">@L.T("common.refresh")</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="portfolio-state portfolio-state-error" role="alert">
            <p>@_error</p>
            @if (_requiresLogin) { <a class="portfolio-login-link" href="/stockpilot/login">@L.T("nav.login")</a> }
            <button type="button" class="portfolio-refresh-button" @onclick="LoadAsync">@L.T("common.retry")</button>
        </div>
    }
    else if (_loading)
    {
        <div class="portfolio-state">@L.T("home.loading")</div>
    }
    else if (_events.Count == 0)
    {
        <div class="portfolio-state">@L.T("home.noEvents")</div>
    }
    else
    {
        <div class="earnings-calendar-grid">
            <section class="earnings-calendar-section">
                <h2>@L.T("home.upcoming")</h2>
                <EarningsEventList Items="_upcoming" EmptyText="@L.T("home.emptyUpcoming")" />
            </section>
            <section class="earnings-calendar-section">
                <h2>@L.T("home.past")</h2>
                <EarningsEventList Items="_past" EmptyText="@L.T("home.emptyPast")" />
            </section>
        </div>
        @if (_fetchedAtUtc is DateTime fetchedAt)
        {
            <p class="earnings-calendar-source">@L.T("home.updated") @fetchedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm", RussianCulture)</p>
        }
    }
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { PropertyNameCaseInsensitive = true };
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private readonly List<EarningsEventList.EarningsCalendarItem> _events = [];
    private List<EarningsEventList.EarningsCalendarItem> _upcoming = [];
    private List<EarningsEventList.EarningsCalendarItem> _past = [];
    private int _upcomingDays = 30;
    private int _pastDays = 14;
    private bool _loading = true;
    private bool _requiresLogin;
    private string? _error;
    private DateTime? _fetchedAtUtc;

    protected override void OnInitialized()
    {
        L.Changed += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _requiresLogin = false;
        StateHasChanged();

        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
            string? token;
            try { token = await module.InvokeAsync<string?>("getToken"); }
            finally { await module.DisposeAsync(); }

            if (string.IsNullOrWhiteSpace(token))
            {
                _error = "Войдите в приложение, чтобы увидеть даты отчётов.";
                _requiresLogin = true;
                return;
            }

            using var client = HttpClientFactory.CreateClient("FinanceApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var response = await client.GetAsync($"Stocks/earnings-calendar?upcomingDays={_upcomingDays}&pastDays={_pastDays}");
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                _error = "Сессия истекла. Войдите и попробуйте снова.";
                _requiresLogin = true;
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Не удалось загрузить даты отчётов (HTTP {(int)response.StatusCode}).";
                return;
            }

            _events.Clear();
            _events.AddRange(await response.Content.ReadFromJsonAsync<List<EarningsEventList.EarningsCalendarItem>>(JsonOptions) ?? []);
            var today = DateTime.UtcNow.Date;
            _upcoming = _events.Where(x => x.EffectiveDate is DateTime date && date >= today).ToList();
            _past = _events.Where(x => x.EffectiveDate is DateTime date && date < today).OrderByDescending(x => x.EffectiveDate).ToList();
            _fetchedAtUtc = _events.Count == 0 ? null : _events.Max(x => x.SourceFetchedAtUtc);
        }
        catch (Exception)
        {
            _error = "Не удалось связаться с API. Проверьте адрес и попробуйте снова.";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        L.Changed -= OnLanguageChanged;
    }
}


