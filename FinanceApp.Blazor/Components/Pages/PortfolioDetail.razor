    private async Task LoadPortfolioAsync()
    {
        _loading = true;
        _error = null;
        _requiresLogin = false;
        StateHasChanged();

        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _requiresLogin = true;
                _error = "Войдите в приложение, чтобы увидеть позиции.";
                return;
            }

            using var response = await client.GetAsync($"Portfolios/{Id}");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _requiresLogin = true;
                _error = "Сессия истекла. Войдите в приложение и попробуйте снова.";
            }
            else if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _error = "Портфель не найден.";
            }
            else if (!response.IsSuccessStatusCode)
            {
                _error = $"Не удалось загрузить позиции (HTTP {(int)response.StatusCode}).";
            }
            else
            {
                _portfolio = await response.Content.ReadFromJsonAsync<PortfolioDetailsViewModel>(JsonOptions);
                if (_portfolio is null)
                {
                    _error = "Сервер не вернул данные портфеля.";
                }
            }
        }
        catch
        {
            _error = "Не удалось связаться с API. Проверьте подключение и попробуйте ещё раз.";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

