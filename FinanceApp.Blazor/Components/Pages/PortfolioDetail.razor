    private void SelectStock(StockOption stock)
    {
        _addModel.StockId = stock.Id;
        _stockSearch = $"{stock.Ticker} [{stock.Exchange}] — {stock.Name}";
        _stockSearchOpen = false;
        _stockSearchMessage = null;
        _stockOptionsError = null;
        _stockOptions.Clear();
    }

    private async Task OnStockSearchChanged(ChangeEventArgs args)
    {
        _stockSearch = args.Value?.ToString() ?? string.Empty;
        _addModel.StockId = null;
        _stockOptions.Clear();
        _stockOptionsError = null;

        var query = _stockSearch.Trim();
        _stockSearchOpen = query.Length >= 2;
        _stockSearchMessage = query.Length < 2 ? "Введите не менее двух символов для поиска." : null;

        _stockSearchCancellation?.Cancel();
        _stockSearchCancellation?.Dispose();
        _stockSearchCancellation = null;

        if (query.Length < 2)
        {
            _loadingStockOptions = false;
            return;
        }

        var cancellation = new CancellationTokenSource();
        _stockSearchCancellation = cancellation;
        _loadingStockOptions = true;
        try
        {
            await Task.Delay(250, cancellation.Token);
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _stockOptionsError = "Войдите в приложение для поиска акций.";
                return;
            }

            var url = $"Stocks/search?q={Uri.EscapeDataString(query)}&limit=15";
            using var response = await client.GetAsync(url, cancellation.Token);
            if (!response.IsSuccessStatusCode)
            {
                _stockOptionsError = $"Не удалось выполнить поиск (HTTP {(int)response.StatusCode}).";
                return;
            }

            _stockOptions = await response.Content.ReadFromJsonAsync<List<StockOption>>(JsonOptions, cancellation.Token) ?? [];
            if (_stockOptions.Count == 0)
            {
                _stockSearchMessage = "Совпадений не найдено.";
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            if (!cancellation.IsCancellationRequested)
            {
                _stockOptionsError = "Не удалось связаться с API.";
            }
        }
        finally
        {
            if (!cancellation.IsCancellationRequested)
            {
                _loadingStockOptions = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task AddPositionAsync()
    {
        if (_addModel.StockId is null)
        {
            _addError = "Выберите акцию.";
            return;
        }

        _savingPosition = true;
        _addError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _addError = "Войдите в приложение и повторите попытку.";
                return;
            }

            var request = new AddPositionRequest(_addModel.StockId.Value, _addModel.Quantity, _addModel.BuyPrice);
            using var response = await client.PostAsJsonAsync($"Portfolios/{Id}/items", request);
            if (!response.IsSuccessStatusCode)
            {
                _addError = $"Не удалось добавить позицию (HTTP {(int)response.StatusCode}).";
                return;
            }

            _addPositionOpen = false;
            await LoadPortfolioAsync();
        }
        catch
        {
            _addError = "Не удалось связаться с API.";
        }
        finally
        {
            _savingPosition = false;
        }
    }

