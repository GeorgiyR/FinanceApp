    private async Task<HttpClient?> CreateAuthenticatedClientAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
        string? token;
        try
        {
            token = await module.InvokeAsync<string?>("getToken");
        }
        finally
        {
            await module.DisposeAsync();
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            return null;
        }

        var client = HttpClientFactory.CreateClient("FinanceApi");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    private static string FormatMoney(decimal value) => $"{value.ToString("N2", RussianCulture)} €";
    private static string FormatSignedMoney(decimal value) => $"{(value >= 0m ? "+" : "")}{FormatMoney(value)}";
    private static string FormatSignedPercent(decimal value) => $"{(value >= 0m ? "+" : "")}{value.ToString("N2", RussianCulture)}%";
    private static string GetExchangeAbbreviation(string exchange) => exchange.Trim().ToUpperInvariant() switch
    {
        "FRANKFURT" => "F",
        "NASDAQ" or "NYSE" => "N",
        _ => exchange.Trim()
    };
private static string FormatFinancial(decimal? value, string? currency = null)
    {
        if (value is not decimal amount) return "—";
        var abs = Math.Abs(amount);
        var divisor = abs >= 1_000_000_000_000m ? 1_000_000_000_000m
            : abs >= 1_000_000_000m ? 1_000_000_000m
            : abs >= 1_000_000m ? 1_000_000m
            : abs >= 1_000m ? 1_000m
            : 1m;
        var suffix = divisor == 1_000_000_000_000m ? "T"
            : divisor == 1_000_000_000m ? "B"
            : divisor == 1_000_000m ? "M"
            : divisor == 1_000m ? "K"
            : string.Empty;
        var formatted = divisor == 1m ? amount.ToString("N2", RussianCulture) : $"{(amount / divisor).ToString("N1", RussianCulture)}{suffix}";
        return string.IsNullOrWhiteSpace(currency) ? formatted : $"{formatted} {currency}";
    }
    private static string FormatNumber(decimal? value, int digits = 2) => value?.ToString("N"+digits, RussianCulture) ?? "—";
    private static string FormatDividendYield(decimal? value) => value is decimal amount ? $"{(amount * 100m).ToString("N2", RussianCulture)}%" : "—";
    private static string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("dd.MM.yyyy", RussianCulture) ?? "—";
    private static string FormatEarningsDate(EarningsEvent item)
    {
        if (item.ReportDate is null) return "—";
        var start = FormatDate(item.ReportDate);
        var end = item.ReportDateEnd is null ? null : FormatDate(item.ReportDateEnd);
        return !string.IsNullOrWhiteSpace(end) && end != start ? $"{start} – {end}" : start;
    }
    private static string FormatEarningsStatus(string status) => status switch
    {
        "Estimated" => "Ожидаемая",
        "Confirmed" => "Подтверждённая",
        _ => "Статус неизвестен"
    };
    private static string ProfitClass(decimal value) => value > 0m ? "positive" : value < 0m ? "negative" : string.Empty;

