@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject FinanceApp.Blazor.Components.Services.MarketIndexNavigationService MarketIndexNavigation
@implements IDisposable

<nav class="sidebar-nav" aria-label="Основная навигация">
    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Главная</NavLink>

    <NavLink class="nav-link nav-link-section" href="/portfolios" Match="NavLinkMatch.All">Портфели</NavLink>
    <div class="nav-portfolio-items" aria-label="Ваши портфели">
        @if (_loading)
        {
            <span class="nav-placeholder">Загрузка…</span>
        }
        else if (_portfolios.Count == 0 && _isAuthenticated)
        {
            <span class="nav-placeholder">Нет портфелей</span>
        }
        else if (!_isAuthenticated)
        {
            <NavLink class="nav-link nav-portfolio-link" href="/login">Войти</NavLink>
        }
        @foreach (var portfolio in _portfolios)
        {
            <details class="nav-group nav-portfolio-group">
                <summary>@portfolio.Name</summary>
                <div class="nav-children">
                    <NavLink class="nav-link" href="@($"/portfolios/{portfolio.Id}?section=positions")">Позиции</NavLink>
                    <NavLink class="nav-link" href="@($"/portfolios/{portfolio.Id}?section=transactions")">Транзакции</NavLink>
                </div>
            </details>
        }
    </div>

    <details class="nav-group" open><summary>Акции</summary>
        <div class="nav-children">
            <NavLink class="nav-link" href="/stocks" Match="NavLinkMatch.All">Отслеживаемые акции</NavLink>
            <NavLink class="nav-link" href="/stocks/catalog">Список акций</NavLink>
            <details class="nav-group nav-group-nested">
                <summary>Мировые индексы</summary>
                <div class="nav-children">
                    <NavLink class="nav-link" href="/market-indices" Match="NavLinkMatch.All">Управление</NavLink>
                    @foreach (var index in _marketIndices)
                    {
                        var tooltip = index.Name == index.Code ? index.Name : $"{index.Name} ({index.Code})";
                        <NavLink class="nav-link" href="@($"/market-indices/{index.Id}")" Match="NavLinkMatch.All" title="@tooltip">@index.Name</NavLink>
                    }
                </div>
            </details>
        </div>
    </details>

    <details class="nav-group">
        <summary>Справочники</summary>
        <div class="nav-children">
            <NavLink class="nav-link" href="/sectors">Секторы и отрасли</NavLink>
            <details class="nav-group nav-group-nested">
                <summary>Аналитика и показатели</summary>
                <div class="nav-children">
                    <NavLink class="nav-link" href="/help/analytical-signal">Аналитический сигнал: как читать</NavLink>
                    <NavLink class="nav-link" href="/help/technical-indicators">Технические показатели в FinanceApp: краткий обзор</NavLink>
                    <NavLink class="nav-link" href="/help/technical-indicator-formulas">Технические показатели: формулы, примеры и ограничения</NavLink>
                    <NavLink class="nav-link" href="/help/fundamentals">Фундаментальные показатели и экраны</NavLink>
                </div>
            </details>
            <NavLink class="nav-link" href="/financial-metrics">Финансовые показатели</NavLink>
            <NavLink class="nav-link" href="/help">Справка</NavLink>
        </div>
    </details>

    <details class="nav-group">
        <summary>Система</summary>
        <div class="nav-children">
            <NavLink class="nav-link" href="/system/processes">Журнал процессов</NavLink>
        </div>
    </details>

    <div class="sidebar-bottom">
        <NavLink class="nav-link" href="/profile">Профиль</NavLink>
        <NavLink class="nav-link" href="/logout">Выйти</NavLink>
    </div>
</nav>

@code {
    private bool _loading = true;
    private bool _isAuthenticated;
    private List<PortfolioNavigationItem> _portfolios = [];
    private List<MarketIndexNavigationItem> _marketIndices = [];
    private IJSObjectReference? _apiModule;

    protected override void OnInitialized()
    {
        MarketIndexNavigation.Changed += OnMarketIndexNavigationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadNavigationAsync();
        }
    }

    private void OnMarketIndexNavigationChanged()
    {
        _ = InvokeAsync(LoadMarketIndicesAsync);
    }

    private async Task LoadNavigationAsync()
    {
        try
        {
            _apiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
            var token = await _apiModule.InvokeAsync<string?>("getToken");
            if (string.IsNullOrWhiteSpace(token))
            {
                return;
            }

            _isAuthenticated = true;
            using var client = CreateClient(token);
            using var response = await client.GetAsync("Portfolios");
            if (response.IsSuccessStatusCode)
            {
                _portfolios = await response.Content.ReadFromJsonAsync<List<PortfolioNavigationItem>>() ?? [];
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                _isAuthenticated = false;
            }

            _marketIndices = await FetchMarketIndicesAsync(client);
        }
        catch
        {
            _portfolios = [];
            _marketIndices = [];
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMarketIndicesAsync()
    {
        if (!_isAuthenticated) return;
        try
        {
            _apiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
            var token = await _apiModule.InvokeAsync<string?>("getToken");
            if (string.IsNullOrWhiteSpace(token)) return;
            using var client = CreateClient(token);
            _marketIndices = await FetchMarketIndicesAsync(client);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private static async Task<List<MarketIndexNavigationItem>> FetchMarketIndicesAsync(HttpClient client)
    {
        using var response = await client.GetAsync("market-indices?includeArchived=false");
        if (!response.IsSuccessStatusCode) return [];
        var indices = await response.Content.ReadFromJsonAsync<List<MarketIndexNavigationItem>>() ?? [];
        return indices.Where(index => index.ShowInNavigation && !index.IsArchived).ToList();
    }

    private HttpClient CreateClient(string token)
    {
        var client = HttpClientFactory.CreateClient("FinanceApi");
        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    private sealed class PortfolioNavigationItem
    {
        public PortfolioNavigationItem() { }
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private sealed class MarketIndexNavigationItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public bool IsArchived { get; set; }
        public bool ShowInNavigation { get; set; }
    }

    public void Dispose()
    {
        MarketIndexNavigation.Changed -= OnMarketIndexNavigationChanged;
    }
}






