@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject FinanceApp.Blazor.Components.Services.MarketIndexNavigationService MarketIndexNavigation
@inject UiLanguageService L
@implements IDisposable

<nav class="sidebar-nav" aria-label="@L.T("nav.aria")">
    <div class="sidebar-scroll">
    <NavLink class="nav-link" href="/stockpilot/" Match="NavLinkMatch.All" title="@L.T("nav.home")">
        <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M3.5 9 10 3.5 16.5 9v7a1 1 0 0 1-1 1H4.5a1 1 0 0 1-1-1Z" /><path d="M8 17v-4.5h4V17" /></svg></span><span class="nav-label">@L.T("nav.home")</span>
    </NavLink>

    <NavLink class="nav-link nav-link-section" href="/stockpilot/portfolios" Match="NavLinkMatch.All" title="@L.T("nav.portfolios")">
        <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><rect x="3" y="6.5" width="14" height="10" rx="1.5" /><path d="M7.5 6.5V5a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 12.5 5v1.5" /><path d="M3 10.5h14" /></svg></span><span class="nav-label">@L.T("nav.portfolios")</span>
    </NavLink>
    <div class="nav-portfolio-items" aria-label="@L.T("nav.yourPortfolios")">
        @if (_loading)
        {
            <span class="nav-placeholder">@L.T("nav.loading")</span>
        }
        else if (_portfolios.Count == 0 && _isAuthenticated)
        {
            <span class="nav-placeholder">@L.T("nav.noPortfolios")</span>
        }
        else if (!_isAuthenticated)
        {
            <NavLink class="nav-link nav-portfolio-link" href="/stockpilot/login">@L.T("nav.login")</NavLink>
        }
        @foreach (var portfolio in _portfolios)
        {
            <details class="nav-group nav-portfolio-group">
                <summary><span class="nav-label">@portfolio.Name @if (portfolio.IsDemo) { <span class="nav-demo-tag" title="@L.T("common.demo")">@L.T("nav.demo")</span> }</span></summary>
                <div class="nav-children">
                    <NavLink class="nav-link" href="@($"/stockpilot/portfolios/{portfolio.Id}?section=positions")">@L.T("portfolios.positions")</NavLink>
                    <NavLink class="nav-link" href="@($"/stockpilot/portfolios/{portfolio.Id}?section=transactions")">@L.T("portfolios.transactions")</NavLink>
                </div>
            </details>
        }
    </div>

    <details class="nav-group" open>
        <summary title="@L.T("nav.stocks")" @onclick="OnGroupSummaryClick">
            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M3 16V4" /><path d="M3 16h14" /><path d="M5.5 12.5 9 9l2.5 2.5L16 6.5" /><path d="M13 6.5h3v3" /></svg></span><span class="nav-label">@L.T("nav.stocks")</span>
        </summary>
        <div class="nav-children">
            <NavLink class="nav-link" href="/stockpilot/stocks" Match="NavLinkMatch.All">@L.T("nav.tracked")</NavLink>
            <NavLink class="nav-link" href="/stockpilot/stocks/catalog">@L.T("nav.catalog")</NavLink>
            <details class="nav-group nav-group-nested">
                <summary>@L.T("nav.indices")</summary>
                <div class="nav-children">
                    <NavLink class="nav-link" href="/stockpilot/market-indices" Match="NavLinkMatch.All">@L.T("nav.manage")</NavLink>
                    @foreach (var index in _marketIndices)
                    {
                        var tooltip = index.Name == index.Code ? index.Name : $"{index.Name} ({index.Code})";
                        <NavLink class="nav-link" href="@($"/stockpilot/market-indices/{index.Id}")" Match="NavLinkMatch.All" title="@tooltip">@index.Name</NavLink>
                    }
                </div>
            </details>
        </div>
    </details>

    <details class="nav-group">
        <summary title="@L.T("nav.directories")" @onclick="OnGroupSummaryClick">
            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 4.5A1.5 1.5 0 0 1 5.5 3H8v14H5.5A1.5 1.5 0 0 1 4 15.5Z" /><path d="M8 3h6.5A1.5 1.5 0 0 1 16 4.5v11a1.5 1.5 0 0 1-1.5 1.5H8" /><path d="M11 6.5h2.5M11 9.5h2.5" /></svg></span><span class="nav-label">@L.T("nav.directories")</span>
        </summary>
        <div class="nav-children">
            <NavLink class="nav-link" href="/stockpilot/sectors">Секторы и отрасли</NavLink>
            <details class="nav-group nav-group-nested">
                <summary>Аналитика и показатели</summary>
                <div class="nav-children">
                    <NavLink class="nav-link" href="/stockpilot/help/analytical-signal">Аналитический сигнал: как читать</NavLink>
                    <NavLink class="nav-link" href="/stockpilot/help/technical-indicators">Технические показатели в FinanceApp: краткий обзор</NavLink>
                    <NavLink class="nav-link" href="/stockpilot/help/technical-indicator-formulas">Технические показатели: формулы, примеры и ограничения</NavLink>
                    <NavLink class="nav-link" href="/stockpilot/help/fundamentals">Фундаментальные показатели и экраны</NavLink>
                </div>
            </details>
            <NavLink class="nav-link" href="/stockpilot/financial-metrics">Финансовые показатели</NavLink>
        </div>
    </details>

    <details class="nav-group">
        <summary title="@L.T("nav.system")" @onclick="OnGroupSummaryClick">
            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="2.5" /><path d="M10 3.2v2.1M10 14.7v2.1M3.2 10h2.1M14.7 10h2.1M5.2 5.2l1.5 1.5M13.3 13.3l1.5 1.5M14.8 5.2l-1.5 1.5M6.7 13.3l-1.5 1.5" /></svg></span><span class="nav-label">@L.T("nav.system")</span>
        </summary>
        <div class="nav-children">
            <NavLink class="nav-link" href="/stockpilot/system/processes">Журнал процессов</NavLink>
        </div>
    </details>

    </div>

    <div class="sidebar-bottom">
        <NavLink class="nav-link" href="/stockpilot/profile" title="@(_userName ?? L.T("nav.profile"))">
            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><circle cx="10" cy="7" r="3" /><path d="M4.5 16.5c0-2.8 2.5-4.5 5.5-4.5s5.5 1.7 5.5 4.5" /></svg></span><span class="nav-label">@(_userName ?? L.T("nav.profile"))</span>
        </NavLink>
        <NavLink class="nav-link nav-link-logout" href="/stockpilot/logout" title="@L.T("nav.logout")">
            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M8 3.5H5.5A1.5 1.5 0 0 0 4 5v10a1.5 1.5 0 0 0 1.5 1.5H8" /><path d="M12 6.5 15.5 10 12 13.5" /><path d="M15.5 10H8" /></svg></span><span class="nav-label">@L.T("nav.logout")</span>
        </NavLink>
    </div>
</nav>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnExpandRequested { get; set; }

    private bool _loading = true;
    private bool _isAuthenticated;
    private string? _userName;
    private List<PortfolioNavigationItem> _portfolios = [];
    private List<MarketIndexNavigationItem> _marketIndices = [];
    private IJSObjectReference? _apiModule;

    protected override void OnInitialized()
    {
        MarketIndexNavigation.Changed += OnMarketIndexNavigationChanged;
        L.Changed += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadNavigationAsync();
        }
    }

    private async Task OnGroupSummaryClick()
    {
        if (Collapsed && OnExpandRequested.HasDelegate)
        {
            await OnExpandRequested.InvokeAsync();
        }
    }

    private void OnMarketIndexNavigationChanged()
    {
        _ = InvokeAsync(LoadMarketIndicesAsync);
    }

    private async Task LoadNavigationAsync()
    {
        try
        {
            _apiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
            var token = await _apiModule.InvokeAsync<string?>("getToken");
            if (string.IsNullOrWhiteSpace(token))
            {
                _userName = null;
                return;
            }

            _isAuthenticated = true;
            using var client = CreateClient(token);
            using var response = await client.GetAsync("Portfolios");
            if (response.IsSuccessStatusCode)
            {
                _portfolios = await response.Content.ReadFromJsonAsync<List<PortfolioNavigationItem>>() ?? [];
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                _isAuthenticated = false;
            }

            _marketIndices = await FetchMarketIndicesAsync(client);
            _userName = await FetchUserNameAsync(client);
        }
        catch
        {
            _portfolios = [];
            _marketIndices = [];
            _userName = null;
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMarketIndicesAsync()
    {
        if (!_isAuthenticated) return;
        try
        {
            _apiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
            var token = await _apiModule.InvokeAsync<string?>("getToken");
            if (string.IsNullOrWhiteSpace(token)) return;
            using var client = CreateClient(token);
            _marketIndices = await FetchMarketIndicesAsync(client);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private static async Task<List<MarketIndexNavigationItem>> FetchMarketIndicesAsync(HttpClient client)
    {
        using var response = await client.GetAsync("market-indices?includeArchived=false");
        if (!response.IsSuccessStatusCode) return [];
        var indices = await response.Content.ReadFromJsonAsync<List<MarketIndexNavigationItem>>() ?? [];
        return indices.Where(index => index.ShowInNavigation && !index.IsArchived).ToList();
    }

    private static async Task<string?> FetchUserNameAsync(HttpClient client)
    {
        using var response = await client.GetAsync("Users/me");
        if (!response.IsSuccessStatusCode) return null;
        var user = await response.Content.ReadFromJsonAsync<UserNavigationItem>();
        return string.IsNullOrWhiteSpace(user?.Username) ? null : user.Username;
    }

    private HttpClient CreateClient(string token)
    {
        var client = HttpClientFactory.CreateClient("FinanceApi");
        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    private sealed class PortfolioNavigationItem
    {
        public PortfolioNavigationItem() { }
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool IsDemo { get; set; }
    }

    private sealed class MarketIndexNavigationItem
    {
        public MarketIndexNavigationItem() { }
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public bool IsArchived { get; set; }
        public bool ShowInNavigation { get; set; }
    }

    private sealed class UserNavigationItem
    {
        public UserNavigationItem() { }
        public string Username { get; set; } = string.Empty;
    }

    public void Dispose()
    {
        MarketIndexNavigation.Changed -= OnMarketIndexNavigationChanged;
        L.Changed -= OnLanguageChanged;
    }
}
