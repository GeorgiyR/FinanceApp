@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject UiLanguageService L
@implements IDisposable

<div class="app-shell @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
    <aside class="app-sidebar">
        <a class="brand" href="/stockpilot/">FinanceApp</a>
        <SidebarNav Collapsed="_sidebarCollapsed" OnExpandRequested="ExpandSidebar" />
        <div class="sidebar-language-switch" role="group" aria-label="Язык / Sprache">
            <button type="button" class="@(L.Language == UiLanguageService.Russian ? "active" : "")" @onclick="() => SetLanguageAsync(UiLanguageService.Russian)">RU</button>
            <button type="button" class="@(L.Language == UiLanguageService.German ? "active" : "")" @onclick="() => SetLanguageAsync(UiLanguageService.German)">DE</button>
        </div>
        <button type="button" class="sidebar-collapse-button" title="@(_sidebarCollapsed ? "Развернуть навигацию" : "Свернуть навигацию")" aria-label="@(_sidebarCollapsed ? "Развернуть навигацию" : "Свернуть навигацию")" aria-expanded="@(!_sidebarCollapsed)" @onclick="ToggleSidebar">
            <svg viewBox="0 0 20 20" aria-hidden="true">
                @if (_sidebarCollapsed)
                {
                    <path d="M7.5 4.5 13 10l-5.5 5.5" />
                }
                else
                {
                    <path d="M12.5 4.5 7 10l5.5 5.5" />
                }
            </svg>
        </button>
    </aside>

    <main class="app-main">
       <!-- <header class="app-header">
            <span>FinanceApp</span>
        </header>-->
        <section class="page-content">
            @Body
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="/stockpilot/" class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string SidebarCollapsedStorageKey = "financeapp.sidebar.collapsed";
    private const string LanguageStorageKey = "financeapp.language";
    private bool _sidebarCollapsed;

    protected override void OnInitialized()
    {
        L.Changed += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", SidebarCollapsedStorageKey);
            if (stored == "1" && !_sidebarCollapsed)
            {
                _sidebarCollapsed = true;
                StateHasChanged();
            }

            var language = await JS.InvokeAsync<string?>("localStorage.getItem", LanguageStorageKey);
            L.SetLanguage(UiLanguageService.Normalize(language));
        }
        catch (JSException)
        {
        }
    }

    private async Task SetLanguageAsync(string language)
    {
        L.SetLanguage(language);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", LanguageStorageKey, language);
        }
        catch (JSException)
        {
        }
    }

    private async Task ToggleSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        await PersistSidebarStateAsync();
    }

    private async Task ExpandSidebar()
    {
        if (!_sidebarCollapsed) return;
        _sidebarCollapsed = false;
        await PersistSidebarStateAsync();
    }

    private async Task PersistSidebarStateAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SidebarCollapsedStorageKey, _sidebarCollapsed ? "1" : "0");
        }
        catch (JSException)
        {
        }
    }

    public void Dispose()
    {
        L.Changed -= OnLanguageChanged;
    }
}
