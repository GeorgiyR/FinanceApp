@using System.Globalization
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using FinanceApp.Blazor.Components.Models
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<section class="position-history-panel" aria-label="История цены @Stock.Ticker">
    <div class="position-history-toolbar">
        <div><strong>История цены: @Stock.Ticker</strong><span>@Stock.Name</span></div>
        <div class="history-toolbar-actions">
            <div class="history-action-buttons">
                <button type="button" class="history-refresh-button" @onclick="ConfirmRefreshHistoryAsync" disabled="@(_historyRefreshing || _hardResetLoading)">
                    @(_historyRefreshing ? "Перезагрузка…" : "Перезагрузить историю")
                </button>
                <button type="button" class="history-hard-reset-button" @onclick="OpenHardResetModalAsync" disabled="@(_historyRefreshing || _hardResetLoading || _validationLoading)">
                    Полностью восстановить историю
                </button>
            </div>
            <div class="history-range-buttons" role="group" aria-label="Период истории">
                @foreach (var range in HistoryRanges)
                {
                    <button type="button" class="@(_historyRange == range.Value ? "active" : "")" @onclick="() => LoadHistoryAsync(range.Value)">@range.Label</button>
                }
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_historyNotice))
    {
        <div class="history-notice history-notice-@_historyNoticeLevel" role="status">@_historyNotice</div>
    }
    @if (_historyLoading)
    {
        <div class="position-history-state">Загрузка истории…</div>
    }
    else if (!string.IsNullOrWhiteSpace(_historyError))
    {
        <div class="position-history-state position-history-error" role="alert">@_historyError <button type="button" @onclick="() => LoadHistoryAsync(_historyRange)">Повторить</button></div>
    }
    else if (_history?.Points.Count is null or 0)
    {
        <div class="position-history-state">Исторические данные отсутствуют.</div>
    }
    else
    {
        <div class="history-summary-grid">
            <section class="history-summary-card">
                <h3>Изменение за период (к текущей цене)</h3>
                <div class="history-performance-metrics">
                    <div><span>Тек. цена</span><strong>@FormatHistoryMoney(Stock.CurrentPrice)</strong></div>
                    <div><span>Мин.–макс. за @GetHistoryRangeLabel(_historyRange)</span><strong>@FormatHistoryMoney(GetHistoryLow(_history)) → @FormatHistoryMoney(GetHistoryHigh(_history))</strong></div>
                    <div><span>Цена в начале периода</span><strong>@FormatHistoryMoney(GetHistoryBaseline(_history))</strong></div>
                    <div><span>@GetPeriodChangeHeading(_historyRange)</span><strong class="@ProfitClass(GetPeriodChange(_history, Stock)?.Value ?? 0m)">@FormatPeriodChange(_history, Stock)</strong></div>
                </div>
            </section>
            <section class="history-summary-card history-volume-card">
                <h3>Объём и активность торгов</h3>
                <div class="history-volume-metrics">
                    <div><span>Объём</span><strong>@FormatHistoryVolume(GetLatestHistoryVolume(_history))</strong></div>
                    <div><span>Ø20</span><strong>@FormatHistoryDecimal(_history.VolumeMetrics.AverageVolume20)</strong></div>
                    <div><span>Ø50</span><strong>@FormatHistoryDecimal(_history.VolumeMetrics.AverageVolume50)</strong></div>
                    <div><span>RVOL</span><strong>@(_history.VolumeMetrics.RelativeVolume is decimal rvol ? $"{rvol.ToString("N2", RussianCulture)}x" : "—")</strong></div>
                    <div><span>Оборот</span><strong>@FormatHistoryMoney(_history.VolumeMetrics.Turnover, _history.VolumeMetrics.TurnoverCurrency)</strong></div>
                </div>
            </section>
        </div>
        <div class="position-history-chart">
            <svg viewBox="0 0 800 220" role="img" aria-label="График исторических цен @Stock.Ticker" preserveAspectRatio="none">
                @foreach (var tick in GetHistoryAxisTicks(_history))
                {
                    <line class="history-grid-line" x1="70" y1="@tick.Y.ToString(CultureInfo.InvariantCulture)" x2="790" y2="@tick.Y.ToString(CultureInfo.InvariantCulture)" />
                    @((MarkupString)$"<text class='history-price-label' x='62' y='{(tick.Y + 4).ToString(CultureInfo.InvariantCulture)}' text-anchor='end'>{tick.Label}</text>")
                }
                @foreach (var tick in GetHistoryDateTicks(_history, _historyRange))
                {
                    <line class="history-date-tick" x1="@tick.X.ToString(CultureInfo.InvariantCulture)" y1="180" x2="@tick.X.ToString(CultureInfo.InvariantCulture)" y2="184" />
                    @((MarkupString)$"<text class='history-date-label' x='{tick.X.ToString(CultureInfo.InvariantCulture)}' y='{tick.Y.ToString(CultureInfo.InvariantCulture)}' text-anchor='{tick.Anchor}'>{tick.Label}</text>")
                    @if (tick.SubLabel is not null)
                    {
                        @((MarkupString)$"<text class='history-date-sub-label' x='{tick.X.ToString(CultureInfo.InvariantCulture)}' y='{(tick.Y + 12m).ToString(CultureInfo.InvariantCulture)}' text-anchor='{tick.Anchor}'>{tick.SubLabel}</text>")
                    }
                }
                @foreach (var month in GetHistoryMonthLabels(_history, _historyRange))
                {
                    @((MarkupString)$"<text class='history-month-label' x='{month.X.ToString(CultureInfo.InvariantCulture)}' y='214' text-anchor='middle'>{month.Label}</text>")
                }
                <line class="history-axis-line" x1="70" y1="24" x2="70" y2="180" />
                <line class="history-axis-line" x1="70" y1="180" x2="790" y2="180" />
                @foreach (var segment in GetHistoryLineSegments(_history, _historyRange))
                {
                    <polyline class="@(segment.IsGap ? "history-gap-line" : null)" points="@segment.Points" />
                }
            </svg>
        </div>
        @if (GetVolumeBars(_history, Stock.Exchange, _historyRange).Count == 0)
        {
            <div class="position-volume-empty">Поставщик не предоставил данные об объёме</div>
        }
        else
        {
            <div class="position-volume-chart">
                <svg viewBox="0 0 800 160" role="img" aria-label="Объёмы торгов @Stock.Ticker" preserveAspectRatio="none">
                    @foreach (var tick in GetVolumeAxisTicks(_history, Stock.Exchange, _historyRange))
                    {
                        <line class="history-grid-line" x1="70" y1="@tick.Y.ToString(CultureInfo.InvariantCulture)" x2="790" y2="@tick.Y.ToString(CultureInfo.InvariantCulture)" />
                        @((MarkupString)$"<text class='history-price-label' x='62' y='{(tick.Y + 4).ToString(CultureInfo.InvariantCulture)}' text-anchor='end'>{tick.Label}</text>")
                    }
                    <line class="history-axis-line" x1="70" y1="10" x2="70" y2="140" />
                    <line class="history-axis-line" x1="70" y1="140" x2="790" y2="140" />
                    @foreach (var bar in GetVolumeBars(_history, Stock.Exchange, _historyRange))
                    {
                        <rect class="@(bar.IsCapped ? "volume-bar volume-bar-capped" : "volume-bar")" x="@bar.X.ToString("0.##", CultureInfo.InvariantCulture)" y="@bar.Y.ToString("0.##", CultureInfo.InvariantCulture)" width="@bar.Width.ToString("0.##", CultureInfo.InvariantCulture)" height="@bar.Height.ToString("0.##", CultureInfo.InvariantCulture)" rx="1">
                            <title>@FormatHistoryDate(bar.Timestamp): @FormatHistoryVolume(bar.Volume) акций</title>
                        </rect>
                    }
                </svg>
            </div>
        }
        @if (GetVolumeBars(_history, Stock.Exchange, _historyRange).Any(bar => bar.IsCapped))
        {
            <div class="volume-cap-note">Аукционные объёмы в начале и конце сессии ограничены по шкале; точное значение — во всплывающей подсказке.</div>
        }
        <TechnicalAnalysisPanel StockId="Stock.Id" />
    }
</section>

@if (_hardResetModalOpen)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseHardResetModal">
        <section class="action-dialog hard-reset-dialog" role="dialog" aria-modal="true" aria-labelledby="hard-reset-title" @onclick:stopPropagation>
            <h2 id="hard-reset-title">Сбросить и загрузить историю заново</h2>
            <p class="action-dialog-subtitle">@Stock.Ticker — @Stock.Name</p>
            <div class="hard-reset-warning">Операция разрушительная: старые исторические ряды будут удалены без сохранения.</div>
            <div class="hard-reset-meta">StockId: <strong>@Stock.Id</strong> · @Stock.Ticker — @Stock.Name</div>
            <div class="hard-reset-meta">ProviderSymbol: configured @(_repairDiagnostics?.ConfiguredProviderSymbol ?? "—") · effective @(_repairDiagnostics?.EffectiveProviderSymbol ?? "—")</div>
            <div class="login-field">
                <label for="hard-reset-provider-symbol">Кандидат ProviderSymbol</label>
                <input id="hard-reset-provider-symbol" type="text" @bind="_providerSymbolCandidate" @bind:event="oninput" placeholder="Кандидат ProviderSymbol (например ENR.DE)" disabled="@(_validationLoading || _hardResetLoading)" />
            </div>
            <div class="hard-reset-validate">
                <button type="button" class="dialog-secondary-button" @onclick="ValidateProviderSymbolAsync" disabled="@(_validationLoading || _hardResetLoading)">@(_validationLoading ? "Проверка…" : "Проверить символ")</button>
            </div>
            @if (_repairValidation is not null)
            {
                <div class="hard-reset-result">
                    <div class="hard-reset-badge @GetResultBadgeClass(_repairValidation.ResultBucket)">Результат: @_repairValidation.ResultBucket</div>
                    <div class="hard-reset-meta">Удалено: @_repairValidation.DeletedRows · Вставлено: @_repairValidation.InsertedRows · Финал: @_repairValidation.FinalRows</div>
                    @foreach (var interval in _repairValidation.Intervals)
                    {
                        <div class="hard-reset-meta @(interval.IsUnavailable ? "warning" : "")">@interval.Interval: fetched=@interval.FetchedCount, accepted=@interval.AcceptedCount, rejected=@interval.RejectedCount</div>
                    }
                    @foreach (var warning in _repairValidation.Warnings)
                    {
                        <div class="hard-reset-message warning">@warning</div>
                    }
                    @foreach (var error in _repairValidation.Errors)
                    {
                        <div class="hard-reset-message error">@error</div>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_hardResetError))
            {
                <div class="hard-reset-error" role="alert">@_hardResetError</div>
            }
            <div class="login-field">
                <label for="hard-reset-confirmation">Подтверждение</label>
                <input id="hard-reset-confirmation" type="text" @bind="_hardResetConfirmation" @bind:event="oninput" placeholder="Введите '@Stock.Ticker' или 'УДАЛИТЬ'" disabled="@_hardResetLoading" />
            </div>
            <div class="dialog-actions">
                <button type="button" class="dialog-secondary-button" @onclick="CloseHardResetModal" disabled="@_hardResetLoading">Отмена</button>
                <button type="button" class="dialog-danger-button" @onclick="HardResetHistoryAsync" disabled="@(!CanHardReset)">@(_hardResetLoading ? "Восстановление…" : "Полностью восстановить историю")</button>
            </div>
        </section>
    </div>
}

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly (string Label, string Value)[] HistoryRanges = [("Сегодня", "today"), ("24 ч.", "24h"), ("Неделя", "1w"), ("Месяц", "1m"), ("3 месяца", "3m"), ("6 месяцев", "6m"), ("1 год", "1y"), ("3 года", "3y"), ("5 лет", "5y")];

    [Parameter, EditorRequired] public PortfolioStockViewModel Stock { get; set; } = new();

    private bool _historyLoading = true;
    private string? _historyError;
    private string _historyRange = "1y";
    private StockHistoryResponse? _history;
    private int? _loadedStockId;
    private bool _historyRefreshing;
    private string? _historyNotice;
    private string _historyNoticeLevel = "info";
    private bool _hardResetModalOpen;
    private bool _hardResetLoading;
    private bool _validationLoading;
    private string _providerSymbolCandidate = string.Empty;
    private string _hardResetConfirmation = string.Empty;
    private string? _hardResetError;
    private StockHistoryRepairDiagnosticsResponse? _repairDiagnostics;
    private StockHistoryRepairDiagnosticsResponse? _repairValidation;

    private bool CanHardReset => !_hardResetLoading && !_validationLoading && HardResetValidationPassed && HardResetConfirmationValid;
    private bool HardResetValidationPassed => _repairValidation is { ResultBucket: "success" or "partial" };
    private bool HardResetConfirmationValid
    {
        get
        {
            var normalized = _hardResetConfirmation.Trim();
            return string.Equals(normalized, "УДАЛИТЬ", StringComparison.OrdinalIgnoreCase)
                || string.Equals(normalized, Stock.Ticker?.Trim(), StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedStockId == Stock.Id) return;
        _loadedStockId = Stock.Id;
        _historyRange = "1y";
        _historyNotice = null;
        _hardResetModalOpen = false;
        _repairDiagnostics = null;
        _repairValidation = null;
        await LoadHistoryAsync(_historyRange);
    }

    private async Task LoadHistoryAsync(string range)
    {
        _historyRange = range;
        _historyLoading = true;
        _historyError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _historyError = "Войдите в приложение, чтобы увидеть историю цены.";
                return;
            }

            using var response = await client.GetAsync($"Stocks/{Stock.Id}/history?range={Uri.EscapeDataString(range)}");
            if (!response.IsSuccessStatusCode)
            {
                _historyError = response.StatusCode == HttpStatusCode.Unauthorized
                    ? "Войдите в приложение, чтобы увидеть историю цены."
                    : $"Не удалось загрузить историю (HTTP {(int)response.StatusCode}).";
                return;
            }
            _history = await response.Content.ReadFromJsonAsync<StockHistoryResponse>(JsonOptions);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _historyError = "Не удалось загрузить историю цены.";
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private async Task<HttpClient?> CreateAuthenticatedClientAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
        string? token;
        try { token = await module.InvokeAsync<string?>("getToken"); }
        finally { await module.DisposeAsync(); }
        if (string.IsNullOrWhiteSpace(token)) return null;
        var client = HttpClientFactory.CreateClient("FinanceApi");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    private async Task ConfirmRefreshHistoryAsync()
    {
        if (_historyRefreshing) return;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Перезагрузить историю?\n\nВсе сохранённые исторические данные по акции {Stock.Ticker} будут удалены и загружены заново по текущему тикеру и бирже.");
        if (!confirmed) return;
        await RefreshHistoryAsync();
    }

    private async Task RefreshHistoryAsync()
    {
        if (_historyRefreshing) return;
        _historyRefreshing = true;
        SetHistoryNotice(null, "info");
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                SetHistoryNotice("Войдите в приложение, чтобы перезагрузить историю.", "error");
                return;
            }

            using var response = await client.PostAsync($"Stocks/{Stock.Id}/history/refresh", null);
            if (!response.IsSuccessStatusCode)
            {
                SetHistoryNotice(await BuildApiErrorAsync(response, "Не удалось перезагрузить историю."), "error");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<StockHistoryRefreshResponse>(JsonOptions);
            await LoadHistoryAsync(_historyRange);

            if (result?.RateLimited == true)
                SetHistoryNotice("Перезагрузка истории ограничена поставщиком данных. Попробуйте позже.", "warning");
            else if (result?.SkippedNotDue == true)
                SetHistoryNotice("Перезагрузка истории сейчас не требуется.", "info");
            else
                SetHistoryNotice($"История перезагружена: удалено {result?.DeletedPoints ?? 0}, загружено {result?.ImportedPoints ?? 0}", "success");
        }
        catch
        {
            SetHistoryNotice("Не удалось перезагрузить историю.", "error");
        }
        finally
        {
            _historyRefreshing = false;
        }
    }

    private async Task OpenHardResetModalAsync()
    {
        if (_hardResetModalOpen) return;
        _hardResetModalOpen = true;
        _repairValidation = null;
        _providerSymbolCandidate = string.Empty;
        _hardResetConfirmation = string.Empty;
        _hardResetError = null;
        _validationLoading = true;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _hardResetError = "Войдите в приложение, чтобы восстановить историю.";
                return;
            }

            using var response = await client.GetAsync($"Stocks/{Stock.Id}/history/routing-diagnostics");
            if (!response.IsSuccessStatusCode)
            {
                _hardResetError = await BuildApiErrorAsync(response, "Не удалось загрузить диагностику маршрутизации истории.");
                return;
            }

            _repairDiagnostics = await response.Content.ReadFromJsonAsync<StockHistoryRepairDiagnosticsResponse>(JsonOptions);
            _providerSymbolCandidate = _repairDiagnostics?.ConfiguredProviderSymbol ?? string.Empty;
        }
        catch
        {
            _hardResetError = "Не удалось загрузить диагностику маршрутизации истории.";
        }
        finally
        {
            _validationLoading = false;
        }
    }

    private void CloseHardResetModal()
    {
        if (_hardResetLoading) return;
        _hardResetModalOpen = false;
        _hardResetError = null;
    }

    private async Task ValidateProviderSymbolAsync()
    {
        if (_validationLoading || _hardResetLoading) return;
        _validationLoading = true;
        _hardResetError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _hardResetError = "Войдите в приложение, чтобы проверить символ поставщика.";
                return;
            }

            using var response = await client.PostAsJsonAsync(
                $"Stocks/{Stock.Id}/history/provider-symbol/validate",
                new { candidateProviderSymbol = string.IsNullOrWhiteSpace(_providerSymbolCandidate) ? null : _providerSymbolCandidate });
            if (!response.IsSuccessStatusCode)
            {
                _hardResetError = await BuildApiErrorAsync(response, "Не удалось проверить символ поставщика.");
                return;
            }

            _repairValidation = await response.Content.ReadFromJsonAsync<StockHistoryRepairDiagnosticsResponse>(JsonOptions);
            if (HardResetValidationPassed)
                SetHistoryNotice("Символ поставщика успешно проверен.", "success");
            else
                SetHistoryNotice("Проверка завершилась с предупреждениями или ошибками. Сброс не будет выполнен.", "warning");
        }
        catch
        {
            _hardResetError = "Не удалось проверить символ поставщика.";
        }
        finally
        {
            _validationLoading = false;
        }
    }

    private async Task HardResetHistoryAsync()
    {
        if (!CanHardReset) return;
        _hardResetLoading = true;
        _hardResetError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _hardResetError = "Войдите в приложение, чтобы восстановить историю.";
                return;
            }

            using var response = await client.PostAsJsonAsync(
                $"Stocks/{Stock.Id}/history/hard-reset",
                new
                {
                    candidateProviderSymbol = string.IsNullOrWhiteSpace(_providerSymbolCandidate) ? null : _providerSymbolCandidate,
                    confirmationText = _hardResetConfirmation,
                });
            if (!response.IsSuccessStatusCode)
            {
                _hardResetError = await BuildApiErrorAsync(response, "Не удалось выполнить полный сброс истории.");
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<StockHistoryRepairDiagnosticsResponse>(JsonOptions);
            _repairValidation = result;
            if (result is null || !result.ResetPerformed)
            {
                _hardResetError = "Полный сброс не выполнен. Проверьте диагностику и повторите попытку.";
                return;
            }

            _hardResetModalOpen = false;
            SetHistoryNotice($"История полностью восстановлена: удалено {result.DeletedRows}, вставлено {result.InsertedRows}.", "success");
            _history = null;
            await LoadHistoryAsync(_historyRange);
        }
        catch
        {
            _hardResetError = "Не удалось выполнить полный сброс истории.";
        }
        finally
        {
            _hardResetLoading = false;
        }
    }

    private void SetHistoryNotice(string? text, string level)
    {
        _historyNotice = text;
        _historyNoticeLevel = level;
    }

    private static string GetResultBadgeClass(string? resultBucket) => resultBucket switch
    {
        "success" or "partial" => string.Empty,
        "empty" or "rateLimited" => "warning",
        _ => "error",
    };

    private static async Task<string> BuildApiErrorAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var body = (await response.Content.ReadAsStringAsync()).Trim();
            if (!string.IsNullOrWhiteSpace(body))
            {
                if (body.Length > 1 && body[0] == '"' && body[^1] == '"')
                    body = JsonSerializer.Deserialize<string>(body) ?? body;
                return $"{fallback} {body}";
            }
        }
        catch
        {
            // Ignore malformed error bodies and fall through to the HTTP status.
        }

        return $"{fallback} (HTTP {(int)response.StatusCode}).";
    }

    private static string ProfitClass(decimal value) => value > 0m ? "positive" : value < 0m ? "negative" : string.Empty;
    private static string FormatHistoryMoney(decimal? value, string? currency = "EUR")
    {
        if (value is null) return "—";
        var suffix = currency?.ToUpperInvariant() switch { "EUR" => "€", "USD" => "$", "GBP" => "£", null or "" => "", var code => $" {code}" };
        return $"{value.Value.ToString("N2", RussianCulture)}{(suffix.Length > 0 && suffix[0] != ' ' ? " " : "")}{suffix}";
    }
    private static string FormatHistoryDecimal(decimal? value) => value?.ToString("N2", RussianCulture) ?? "—";
    private static string FormatHistoryVolume(decimal? value) => value?.ToString("N0", RussianCulture) ?? "—";
    private static string FormatHistoryDate(DateTime timestamp) => timestamp.ToLocalTime().ToString("d MMM yyyy", RussianCulture);
    private static string GetHistoryRangeLabel(string range) => range switch { "today" => "сегодня", "24h" => "24 ч.", "1w" => "неделю", "1m" => "1 месяц", "3m" => "3 месяца", "6m" => "6 месяцев", "1y" => "1 год", "3y" => "3 года", "5y" => "5 лет", _ => range };
    private static string GetPeriodChangeHeading(string range) => range is "today" or "24h" ? "Изменение к предыдущему закрытию" : "Изменение от начала периода";
    private string FormatPeriodChange(StockHistoryResponse history, PortfolioStockViewModel stock)
    {
        var baseline = history.Range is "today" or "24h" && stock.CurrentPriceChange is decimal dailyChange ? stock.CurrentPrice - dailyChange : GetHistoryBaseline(history);
        if (baseline is null) return "—";
        var change = stock.CurrentPrice - baseline.Value;
        var percent = baseline.Value == 0m ? null : (decimal?)(change / baseline.Value * 100m);
        return $"{FormatSignedMoney(change)} ({(percent is decimal value ? FormatSignedPercent(value) : "—")})";
    }
    private static (decimal Value, decimal? Percent)? GetPeriodChange(StockHistoryResponse history, PortfolioStockViewModel stock)
    {
        var baseline = (history.Range is "today" or "24h") && stock.CurrentPriceChange is decimal dailyChange ? stock.CurrentPrice - dailyChange : GetHistoryBaseline(history);
        if (baseline is null) return null;
        var change = stock.CurrentPrice - baseline.Value;
        return (change, baseline.Value == 0m ? null : change / baseline.Value * 100m);
    }
    private static string FormatSignedMoney(decimal value) => $"{(value >= 0m ? "+" : "")}{FormatHistoryMoney(value)}";
    private static string FormatSignedPercent(decimal value) => $"{(value >= 0m ? "+" : "")}{value.ToString("N2", RussianCulture)}%";

    private static List<(DateTime Timestamp, decimal Price)> GetUsableHistoryPoints(StockHistoryResponse history) => history.Points
        .Select(point => (point.Timestamp, Price: point.CloseEur ?? point.CloseNormalized)).Where(point => point.Price > 0m).OrderBy(point => point.Timestamp).ToList();

    // Nights and weekends are stretched over the whole range on a plain time axis; compress them
    // so the actual trading sessions stay readable.
    private static readonly long NoTradeGapTicks = TimeSpan.FromMinutes(30).Ticks;
    private const decimal NoTradeGapCompression = 3m;
    private static bool UsesNoTradeGapCompression(string range) => range == "24h";
    // The weekly range mirrors the React chart: one horizontal step per data point, no empty time gaps.
    private static bool UsesIndexBasedXAxis(string range) => range is "1w" or "1m";

    private static int FindHistoryPointIndex(IReadOnlyList<(DateTime Timestamp, decimal Price)> points, DateTime timestamp)
    {
        var low = 0;
        var high = points.Count - 1;
        while (low < high)
        {
            var middle = (low + high + 1) / 2;
            if (points[middle].Timestamp <= timestamp) low = middle; else high = middle - 1;
        }

        return low;
    }

    private static Func<DateTime, decimal> BuildHistoryXMap(StockHistoryResponse history, string range)
    {
        var points = GetUsableHistoryPoints(history);
        if (points.Count == 0) return _ => 430m;

        if (UsesIndexBasedXAxis(range))
        {
            return timestamp =>
            {
                if (points.Count == 1) return 430m;
                var index = FindHistoryPointIndex(points, timestamp);
                return 70m + (decimal)index / (points.Count - 1) * 720m;
            };
        }

        var start = points[0].Timestamp;
        var end = points[^1].Timestamp;
        var duration = (decimal)(end - start).Ticks;
        decimal Linear(DateTime timestamp) => duration == 0m ? 430m : 70m + (decimal)(timestamp - start).Ticks / duration * 720m;
        if (!UsesNoTradeGapCompression(range) || points.Count < 2) return Linear;

        var cumulative = new decimal[points.Count];
        for (var index = 1; index < points.Count; index++)
        {
            var delta = (decimal)(points[index].Timestamp - points[index - 1].Timestamp).Ticks;
            cumulative[index] = cumulative[index - 1] + (delta > NoTradeGapTicks ? delta / NoTradeGapCompression : delta);
        }

        var total = cumulative[^1];
        if (total <= 0m) return Linear;

        return timestamp =>
        {
            if (timestamp <= start) return 70m;
            if (timestamp >= end) return 790m;

            var low = 1;
            var high = points.Count - 1;
            while (low < high)
            {
                var middle = (low + high) / 2;
                if (points[middle].Timestamp < timestamp) low = middle + 1; else high = middle;
            }

            var next = low;
            var previous = next - 1;
            var span = (decimal)(points[next].Timestamp - points[previous].Timestamp).Ticks;
            var ratio = span <= 0m ? 0m : (decimal)(timestamp - points[previous].Timestamp).Ticks / span;
            var position = cumulative[previous] + (cumulative[next] - cumulative[previous]) * ratio;
            return 70m + position / total * 720m;
        };
    }

    private static IReadOnlyList<HistoryLineSegment> GetHistoryLineSegments(StockHistoryResponse history, string range)
    {
        var points = GetUsableHistoryPoints(history);
        if (points.Count == 0) return [];

        var min = points.Min(point => point.Price);
        var spread = points.Max(point => point.Price) - min;
        if (spread == 0m) spread = Math.Max(min * 0.01m, 0.01m);
        var xMap = BuildHistoryXMap(history, range);

        var segments = new List<HistoryLineSegment>();
        var current = new List<string> { FormatHistoryChartPoint(points[0], xMap, min, spread) };
        for (var index = 1; index < points.Count; index++)
        {
            var gap = (points[index].Timestamp - points[index - 1].Timestamp).Ticks;
            if (UsesNoTradeGapCompression(range) && gap > NoTradeGapTicks)
            {
                if (current.Count > 1) segments.Add(new HistoryLineSegment(string.Join(" ", current), false));
                var gapPoints = FormatHistoryChartPoint(points[index], xMap, min, spread);
                segments.Add(new HistoryLineSegment($"{current[^1]} {gapPoints}", true));
                current = [gapPoints];
            }
            else
            {
                current.Add(FormatHistoryChartPoint(points[index], xMap, min, spread));
            }
        }

        if (current.Count > 1) segments.Add(new HistoryLineSegment(string.Join(" ", current), false));
        return segments;
    }

    private static string FormatHistoryChartPoint((DateTime Timestamp, decimal Price) point, Func<DateTime, decimal> xMap, decimal min, decimal spread)
    {
        var x = xMap(point.Timestamp);
        var y = 180m - (point.Price - min) / spread * 156m;
        return $"{x.ToString("0.##", CultureInfo.InvariantCulture)},{y.ToString("0.##", CultureInfo.InvariantCulture)}";
    }
    private static IReadOnlyList<HistoryAxisTick> GetHistoryAxisTicks(StockHistoryResponse history)
    {
        var prices = history.Points.Select(point => point.CloseEur ?? point.CloseNormalized).Where(price => price > 0m).ToArray();
        if (prices.Length == 0) return [];
        var min = prices.Min(); var max = prices.Max();
        if (min == max) { var padding = Math.Max(min * 0.01m, 0.01m); min -= padding; max += padding; }
        return Enumerable.Range(0, 5).Select(index => { var ratio = index / 4m; return new HistoryAxisTick(24m + ratio * 156m, $"{(max - (max - min) * ratio).ToString("N2", RussianCulture)} €"); }).ToArray();
    }
    private static bool IsUsIntradayVolumeRange(string? exchange, string range)
    {
        if (range is not ("1w" or "24h" or "today")) return false;
        var normalizedExchange = exchange?.Trim();
        if (string.IsNullOrEmpty(normalizedExchange)) return false;
        return normalizedExchange.Contains("NYSE", StringComparison.OrdinalIgnoreCase)
            || normalizedExchange.Contains("NASDAQ", StringComparison.OrdinalIgnoreCase)
            || normalizedExchange.Contains("AMEX", StringComparison.OrdinalIgnoreCase);
    }

    private static decimal GetVolumeDisplayMax(IEnumerable<long> sourceVolumes, string? exchange, string range)
    {
        var volumes = sourceVolumes.Where(volume => volume > 0).Select(volume => (decimal)volume).Order().ToArray();
        if (volumes.Length == 0) return 0m;
        var max = volumes[^1];

        var isFrankfurtLongRange = string.Equals(exchange?.Trim(), "Frankfurt", StringComparison.OrdinalIgnoreCase)
            && range is "1y" or "3y" or "5y";
        if (isFrankfurtLongRange && volumes.Length >= 20)
        {
            var reference = volumes[(int)Math.Floor((volumes.Length - 1) * 0.95m)];
            if (max > reference * 2m) return Math.Min(max, reference * 1.25m);
        }

        // Yahoo's US 5m bars put the whole opening/closing auction into the first and last bar of
        // a session, so the first and last 10m buckets dwarf every other bucket on 1w/24h/today.
        // Anchor the scale on the regular-session distribution and mark auction bars as capped;
        // the tooltip still shows the real volume.
        if (IsUsIntradayVolumeRange(exchange, range) && volumes.Length >= 20)
        {
            var median = volumes[(int)Math.Floor((volumes.Length - 1) * 0.50m)];
            var p90 = volumes[(int)Math.Floor((volumes.Length - 1) * 0.90m)];
            if (max > p90 * 1.5m || max > median * 3m)
            {
                return Math.Min(max, p90 * 1.4m);
            }
        }

        return max;
    }
    private static IReadOnlyList<HistoryVolumeBar> GetVolumeBars(StockHistoryResponse history, string? exchange, string range)
    {
        var points = history.Points.Where(point => point.Volume > 0).OrderBy(point => point.Timestamp).ToArray();
        var max = GetVolumeDisplayMax(points.Select(point => point.Volume), exchange, range);
        if (points.Length == 0 || max <= 0m) return [];
        // Share the price chart's time mapping so volume bars line up with the price line.
        var xMap = BuildHistoryXMap(history, range);
        var width = Math.Clamp(700m / points.Length * 0.72m, 1m, 12m);
        return points.Select(point => { var x = xMap(point.Timestamp); var height = Math.Min((decimal)point.Volume, max) / max * 120m; return new HistoryVolumeBar(point.Timestamp, point.Volume, x - width / 2m, 140m - height, width, height, point.Volume > max); }).ToArray();
    }
    private static IReadOnlyList<HistoryAxisTick> GetVolumeAxisTicks(StockHistoryResponse history, string? exchange, string range)
    {
        var max = GetVolumeDisplayMax(history.Points.Select(point => point.Volume), exchange, range);
        if (max <= 0m) return [];
        return Enumerable.Range(0, 4).Select(index => { var ratio = index / 3m; return new HistoryAxisTick(140m - ratio * 120m, FormatCompactHistoryNumber(max * ratio)); }).ToArray();
    }
    private static string FormatCompactHistoryNumber(decimal value) => value >= 1_000_000m ? $"{(value / 1_000_000m).ToString("0.#", RussianCulture)}M" : value >= 1_000m ? $"{(value / 1_000m).ToString("0.#", RussianCulture)}K" : value.ToString("N0", RussianCulture);
    private static decimal? GetHistoryLow(StockHistoryResponse history) { var values = history.Points.Select(point => point.LowEur ?? point.LowNormalized).Where(value => value > 0m).ToArray(); return values.Length == 0 ? null : values.Min(); }
    private static decimal? GetHistoryHigh(StockHistoryResponse history) { var values = history.Points.Select(point => point.HighEur ?? point.HighNormalized).Where(value => value > 0m).ToArray(); return values.Length == 0 ? null : values.Max(); }
    private static decimal? GetHistoryBaseline(StockHistoryResponse history) => GetUsableHistoryPoints(history).FirstOrDefault() is var first && first.Timestamp != default ? first.Price : null;
    private static decimal? GetLatestHistoryVolume(StockHistoryResponse history) => history.Points.OrderByDescending(point => point.Timestamp).Select(point => (decimal?)point.Volume).FirstOrDefault();
    private static IReadOnlyList<HistoryDateTick> GetHistoryDateTicks(StockHistoryResponse history, string range)
    {
        var points = GetUsableHistoryPoints(history); if (points.Count == 0) return [];
        if (range == "1m") return GetDailyHistoryDateTicks(points, BuildHistoryXMap(history, range));
        if (range == "1w") return GetWeeklyHistoryDateTicks(points, BuildHistoryXMap(history, range));
        var start = points[0].Timestamp; var end = points[^1].Timestamp;
        Func<DateTime, DateTime> addStep = range switch { "today" => date => date.AddHours(2), "24h" => date => date.AddHours(4), "1w" => date => date.AddDays(1), "3m" or "6m" => date => date.AddDays(14), "1y" => date => date.AddMonths(1), "3y" => date => date.AddMonths(3), "5y" => date => date.AddMonths(6), _ => date => date.AddDays(14) };
        var dates = new List<DateTime> { start };
        for (var date = addStep(start); date < end && dates.Count < 20; date = addStep(date)) dates.Add(date);
        if (end > start) dates.Add(end);
        var format = range is "today" or "24h" ? "HH:mm" : range is "1y" or "3y" or "5y" ? "MM.yy" : "dd.MM";
        var xMap = BuildHistoryXMap(history, range);
        if (UsesNoTradeGapCompression(range)) return BuildCompressedDateTicks(dates, xMap, format);
        if (dates.Count > 2)
        {
            var previous = dates[^2];
            var previousX = xMap(previous);
            var endX = xMap(end);
            var previousLabel = previous.ToLocalTime().ToString(format, RussianCulture);
            var endLabel = end.ToLocalTime().ToString(format, RussianCulture);
            if (previousLabel == endLabel)
                dates.RemoveAt(dates.Count - 1);
            else if (endX - previousX < 40m)
                dates.RemoveAt(dates.Count - 2);
        }
        return dates.Select((date, index) => new HistoryDateTick(xMap(date), date.ToLocalTime().ToString(format, RussianCulture), index == 0 ? "start" : index == dates.Count - 1 ? "end" : "middle")).ToArray();
    }

    private static IReadOnlyList<HistoryDateTick> BuildCompressedDateTicks(IReadOnlyList<DateTime> dates, Func<DateTime, decimal> xMap, string format)
    {
        // Compressed gaps shift trading sessions closer together, so thin labels by pixel distance.
        const decimal minLabelGap = 55m;
        var ticks = new List<HistoryDateTick>();
        foreach (var date in dates)
        {
            var x = xMap(date);
            if (ticks.Count > 0 && x - ticks[^1].X < minLabelGap) continue;
            ticks.Add(new HistoryDateTick(x, date.ToLocalTime().ToString(format, RussianCulture), "middle"));
        }

        if (ticks.Count > 0 && ticks[^1].X > 770m) ticks[^1] = ticks[^1] with { Anchor = "end" };
        if (ticks.Count > 0 && ticks[0].X < 80m) ticks[0] = ticks[0] with { Anchor = "start" };
        return ticks;
    }

    private static IReadOnlyList<HistoryDateTick> GetWeeklyHistoryDateTicks(IReadOnlyList<(DateTime Timestamp, decimal Price)> points, Func<DateTime, decimal> xMap)
    {
        // 1:1 weekly axis: labels are sampled by point index, not by wall-clock time.
        // The date and the time are rendered on two lines so neighbouring labels do not collide.
        const int maxLabels = 10;
        var step = Math.Max(1, (int)Math.Ceiling((points.Count - 1) / (decimal)(maxLabels - 1)));
        var ticks = new List<HistoryDateTick>();
        for (var index = 0; index < points.Count; index += step)
        {
            var local = points[index].Timestamp.ToLocalTime();
            ticks.Add(new HistoryDateTick(
                xMap(points[index].Timestamp),
                local.ToString("dd.MM", RussianCulture),
                "middle",
                199m,
                local.ToString("HH:mm", RussianCulture)));
        }

        var lastX = xMap(points[^1].Timestamp);
        if (ticks.Count == 0 || ticks[^1].X < lastX - 40m)
        {
            var lastLocal = points[^1].Timestamp.ToLocalTime();
            ticks.Add(new HistoryDateTick(
                lastX,
                lastLocal.ToString("dd.MM", RussianCulture),
                "middle",
                199m,
                lastLocal.ToString("HH:mm", RussianCulture)));
        }

        if (ticks[^1].X > 770m) ticks[^1] = ticks[^1] with { Anchor = "end" };
        if (ticks[0].X < 80m) ticks[0] = ticks[0] with { Anchor = "start" };
        return ticks;
    }

    private static IReadOnlyList<HistoryDateTick> GetDailyHistoryDateTicks(IReadOnlyList<(DateTime Timestamp, decimal Price)> points, Func<DateTime, decimal> xMap)
    {
        // Horizontal day numbers; the month is rendered on its own row below.
        const decimal minLabelGap = 15m;
        var ticks = new List<HistoryDateTick>();
        foreach (var day in points.GroupBy(point => point.Timestamp.ToLocalTime().Date).OrderBy(group => group.Key))
        {
            var x = xMap(day.Min(point => point.Timestamp));
            if (ticks.Count > 0 && x - ticks[^1].X < minLabelGap) continue;
            ticks.Add(new HistoryDateTick(x, day.Key.Day.ToString(RussianCulture), "middle", 200m));
        }

        return ticks;
    }

    private static IReadOnlyList<HistoryMonthLabel> GetHistoryMonthLabels(StockHistoryResponse history, string range)
    {
        if (range != "1m") return [];
        var points = GetUsableHistoryPoints(history);
        if (points.Count == 0) return [];

        var xMap = BuildHistoryXMap(history, range);

        return points
            .GroupBy(point => { var local = point.Timestamp.ToLocalTime(); return new { local.Year, local.Month }; })
            .OrderBy(group => group.Key.Year)
            .ThenBy(group => group.Key.Month)
            .Select(group => new HistoryMonthLabel(
                (xMap(group.Min(point => point.Timestamp)) + xMap(group.Max(point => point.Timestamp))) / 2m,
                RussianCulture.DateTimeFormat.GetMonthName(group.Key.Month)))
            .ToList();
    }

    private sealed class StockHistoryResponse { public List<StockHistoryPoint> Points { get; set; } = []; public StockHistoryVolumeMetrics VolumeMetrics { get; set; } = new(); public string? Range { get; set; } }
    private sealed class StockHistoryVolumeMetrics { public decimal? AverageVolume20 { get; set; } public decimal? AverageVolume50 { get; set; } public decimal? RelativeVolume { get; set; } public decimal? Turnover { get; set; } public string? TurnoverCurrency { get; set; } }
    private sealed class StockHistoryPoint { public DateTime Timestamp { get; set; } public decimal CloseNormalized { get; set; } public decimal? CloseEur { get; set; } public decimal HighNormalized { get; set; } public decimal LowNormalized { get; set; } public decimal? HighEur { get; set; } public decimal? LowEur { get; set; } public long Volume { get; set; } }
    private sealed record HistoryAxisTick(decimal Y, string Label);
    private sealed record HistoryDateTick(decimal X, string Label, string Anchor, decimal Y = 205m, string? SubLabel = null);
    private sealed record HistoryMonthLabel(decimal X, string Label);
    private sealed record HistoryLineSegment(string Points, bool IsGap);
    private sealed record HistoryVolumeBar(DateTime Timestamp, long Volume, decimal X, decimal Y, decimal Width, decimal Height, bool IsCapped);

