@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using FinanceApp.Blazor.Components.Models
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@implements IDisposable

<section class="orders-panel">
    <div class="orders-toolbar">
        <div class="orders-toolbar-info">
            <label class="orders-page-size">
                На странице:
                <select value="@_pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </label>
        </div>
        <div class="orders-toolbar-actions">
            <button type="button" class="portfolio-refresh-button" @onclick="LoadOrdersAsync" disabled="@_loading">Обновить</button>
            <button type="button" class="portfolio-primary-button" @onclick="OpenDialog">Новый ордер</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="portfolio-state portfolio-state-error" role="alert">@_error</div>
    }
    else if (_loading && _orders.Count == 0)
    {
        <div class="portfolio-state">Загрузка ордеров…</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_actionMessage))
        {
            <div class="portfolio-refresh-notice" role="status">@_actionMessage</div>
        }

        <div class="index-tabs orders-tabs" role="tablist" aria-label="Ордера">
            <button type="button" role="tab" class="@(_activeTab == "open" ? "active" : "")" aria-selected="@(_activeTab == "open")" @onclick='() => SelectTab("open")'>
                Открытые <span class="orders-tab-count">@OpenOrders.Count</span>
            </button>
            <button type="button" role="tab" class="@(_activeTab == "history" ? "active" : "")" aria-selected="@(_activeTab == "history")" @onclick='() => SelectTab("history")'>
                История <span class="orders-tab-count">@HistoryOrders.Count</span>
            </button>
        </div>

        @if (_activeTab == "open")
        {
            @if (OpenOrders.Count == 0)
            {
                <div class="portfolio-state">Нет открытых ордеров.</div>
            }
            else
            {
                <div class="orders-table-wrap">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Инструмент</th>
                                <th>Сторона</th>
                                <th>Тип</th>
                                <th>Количество</th>
                                <th>Условие</th>
                                <th>Статус</th>
                                <th>Создан</th>
                                <th class="actions-heading">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in PagedOpenOrders)
                            {
                                <tr @key="order.Id">
                                    <td>
                                        <button type="button" class="orders-ticker-button" @onclick="() => ToggleHistoryAsync(order)" aria-expanded="@(_expandedOrderId == order.Id)" title="Показать историю цены">
                                            <span class="orders-ticker">@order.StockTicker</span>
                                            <span class="orders-name">@order.StockName</span>
                                            <span class="orders-expand-icon">@(_expandedOrderId == order.Id ? "▾" : "▸")</span>
                                        </button>
                                    </td>
                                    <td class="@(order.Side == "Buy" ? "orders-side-buy" : "orders-side-sell")">@SideLabel(order.Side)</td>
                                    <td>@KindLabel(order.Kind)</td>
                                    <td>@FormatNumber(order.Quantity)</td>
                                    <td>@PriceCondition(order)</td>
                                    <td><span class="orders-status orders-status-@order.Status.ToLowerInvariant()">@StatusLabel(order.Status)</span></td>
                                    <td>@FormatDate(order.CreatedAt)</td>
                                    <td class="transaction-row-actions">
                                        <button type="button" class="action-icon-button" title="Редактировать ордер" aria-label="Редактировать ордер" @onclick="() => OpenEditDialog(order)" disabled="@_busy"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m3 14.8-.8 3 3-.8L16.8 5.4a1.8 1.8 0 0 0-2.6-2.6L3 14.8Zm9.9-9.9 2.6 2.6" /></svg></button>
                                        <button type="button" class="action-icon-button" title="Отменить ордер" aria-label="Отменить ордер" @onclick="() => CancelOrderAsync(order)" disabled="@_busy"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg></button>
                                        <button type="button" class="action-icon-button action-delete-button" title="Удалить ордер" aria-label="Удалить ордер" @onclick="() => DeleteOrderAsync(order)" disabled="@_busy"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14m-9 0V3h4v2m3 0-.8 12H5.8L5 5m3 3v6m4-6v6" /></svg></button>
                                    </td>
                                </tr>
                                @if (_expandedOrderId == order.Id)
                                {
                                    <tr class="orders-history-row" @key="-order.Id">
                                        <td colspan="8">
                                            @if (_stockDetailsLoading)
                                            {
                                                <div class="position-history-state">Загрузка данных инструмента…</div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(_stockDetailsError))
                                            {
                                                <div class="position-history-state position-history-error" role="alert">@_stockDetailsError</div>
                                            }
                                            else if (_expandedStock is not null)
                                            {
                                                <StockHistoryPanel @key="_expandedStock.Id" Stock="_expandedStock" />
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (OpenPageCount > 1)
                {
                    <div class="catalog-pagination orders-pagination">
                        <button type="button" class="stocks-toolbar-button" @onclick="() => GoToOpenPage(_openPage - 1)" disabled="@(_openPage <= 1)">← Назад</button>
                        <span>Страница @_openPage из @OpenPageCount</span>
                        <button type="button" class="stocks-toolbar-button" @onclick="() => GoToOpenPage(_openPage + 1)" disabled="@(_openPage >= OpenPageCount)">Вперёд →</button>
                    </div>
                }
            }
        }
        else
        {
            @if (HistoryOrders.Count == 0)
            {
                <div class="portfolio-state">История пуста.</div>
            }
            else
            {
                <div class="orders-table-wrap">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Инструмент</th>
                                <th>Сторона</th>
                                <th>Тип</th>
                                <th>Количество</th>
                                <th>Цена исполнения</th>
                                <th>Статус</th>
                                <th>Исполнен</th>
                                <th>Источник</th>
                                <th class="actions-heading">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in PagedHistoryOrders)
                            {
                                <tr @key="order.Id">
                                    <td>
                                        <button type="button" class="orders-ticker-button" @onclick="() => ToggleHistoryAsync(order)" aria-expanded="@(_expandedOrderId == order.Id)" title="Показать историю цены">
                                            <span class="orders-ticker">@order.StockTicker</span>
                                            <span class="orders-name">@order.StockName</span>
                                            <span class="orders-expand-icon">@(_expandedOrderId == order.Id ? "▾" : "▸")</span>
                                        </button>
                                    </td>
                                    <td class="@(order.Side == "Buy" ? "orders-side-buy" : "orders-side-sell")">@SideLabel(order.Side)</td>
                                    <td>@KindLabel(order.Kind)</td>
                                    <td>@FormatNumber(order.Quantity)</td>
                                    <td>@(order.AverageFillPrice is decimal price ? FormatMoney(price) : "—")</td>
                                    <td>
                                        <span class="orders-status orders-status-@order.Status.ToLowerInvariant()">@StatusLabel(order.Status)</span>
                                        @if (!string.IsNullOrWhiteSpace(order.RejectReason))
                                        {
                                            <span class="orders-reject-reason">@order.RejectReason</span>
                                        }
                                    </td>
                                    <td>@FormatDateTime(order.ExecutedAt)</td>
                                    <td>
                                        @if (order.ExecutionSource == "Automatic")
                                        {
                                            <span class="orders-auto-badge">Авто</span>
                                        }
                                        else if (order.ExecutionSource == "Manual")
                                        {
                                            <span>Вручную</span>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="transaction-row-actions">
                                        <button type="button" class="action-icon-button" title="Редактировать ордер" aria-label="Редактировать ордер" @onclick="() => OpenEditDialog(order)" disabled="@_busy"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m3 14.8-.8 3 3-.8L16.8 5.4a1.8 1.8 0 0 0-2.6-2.6L3 14.8Zm9.9-9.9 2.6 2.6" /></svg></button>
                                        <button type="button" class="action-icon-button action-delete-button" title="Удалить ордер" aria-label="Удалить ордер" @onclick="() => DeleteOrderAsync(order)" disabled="@_busy"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14m-9 0V3h4v2m3 0-.8 12H5.8L5 5m3 3v6m4-6v6" /></svg></button>
                                    </td>
                                </tr>
                                @if (_expandedOrderId == order.Id)
                                {
                                    <tr class="orders-history-row" @key="-order.Id">
                                        <td colspan="9">
                                            @if (_stockDetailsLoading)
                                            {
                                                <div class="position-history-state">Загрузка данных инструмента…</div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(_stockDetailsError))
                                            {
                                                <div class="position-history-state position-history-error" role="alert">@_stockDetailsError</div>
                                            }
                                            else if (_expandedStock is not null)
                                            {
                                                <StockHistoryPanel @key="_expandedStock.Id" Stock="_expandedStock" />
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (HistoryPageCount > 1)
                {
                    <div class="catalog-pagination orders-pagination">
                        <button type="button" class="stocks-toolbar-button" @onclick="() => GoToHistoryPage(_historyPage - 1)" disabled="@(_historyPage <= 1)">← Назад</button>
                        <span>Страница @_historyPage из @HistoryPageCount</span>
                        <button type="button" class="stocks-toolbar-button" @onclick="() => GoToHistoryPage(_historyPage + 1)" disabled="@(_historyPage >= HistoryPageCount)">Вперёд →</button>
                    </div>
                }
            }
        }
    }
</section>

@if (_dialogOpen)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseDialog">
        <section class="action-dialog orders-dialog" role="dialog" aria-modal="true" aria-labelledby="order-dialog-title" @onclick:stopPropagation>
            <h2 id="order-dialog-title">@(_editingOrderId is null ? "Новый ордер" : "Редактировать ордер")</h2>
            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="login-error" role="alert">@_formError</div>
            }
            <EditForm Model="_form" OnValidSubmit="SubmitOrderAsync" FormName="order-form">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="login-field">
                    <label for="order-side">Сторона</label>
                    <select id="order-side" @bind="_form.Side" disabled="@_editingExecutedOrder">
                        <option value="Buy">Покупка</option>
                        <option value="Sell">Продажа</option>
                    </select>
                </div>
                <div class="login-field">
                    <label for="order-kind">Тип ордера</label>
                    <select id="order-kind" @bind="_form.Kind" disabled="@_editingExecutedOrder">
                        <option value="Market">Рыночный (Market)</option>
                        <option value="Limit">Лимитный (Limit)</option>
                        <option value="StopMarket">Стоп-маркет (Stop Market)</option>
                        <option value="StopLimit">Стоп-лимит (Stop Limit)</option>
                        <option value="TakeProfit">Тейк-профит (Take Profit)</option>
                        <option value="TrailingStop">Трейлинг-стоп (Trailing Stop)</option>
                    </select>
                </div>
                @if (_editingOrderId is null)
                {
                    <div class="login-field stock-autocomplete-field">
                        <label for="order-stock-search">Акция</label>
                        <input id="order-stock-search" class="stock-search-input" type="search" role="combobox"
                               aria-autocomplete="list" aria-controls="order-stock-results" aria-expanded="@_stockSearchOpen"
                               autocomplete="off" placeholder="Введите тикер или название"
                               value="@_stockSearch" @oninput="OnStockSearchChanged" />
                        @if (_stockSearchOpen)
                        {
                            <div id="order-stock-results" class="stock-autocomplete-results" role="listbox">
                                @if (_stockSearchLoading)
                                {
                                    <div class="stock-search-message">Поиск акций…</div>
                                }
                                else if (_stockOptions.Count == 0)
                                {
                                    <div class="stock-search-message">Совпадений не найдено.</div>
                                }
                                else
                                {
                                    @foreach (var stock in _stockOptions)
                                    {
                                        <button type="button" class="stock-search-option" @onclick="() => SelectStock(stock)">
                                            <span class="stock-search-ticker">@stock.Ticker</span>
                                            <span class="stock-search-name">@stock.Name</span>
                                            <span class="stock-search-exchange">@stock.Exchange</span>
                                            <span class="stock-search-price">@FormatMoney(stock.CurrentPrice)</span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="login-field">
                        <label for="order-stock-readonly">Акция</label>
                        <input id="order-stock-readonly" type="text" value="@_stockSearch" readonly disabled />
                    </div>
                }
                <div class="login-field">
                    <label for="order-quantity">Количество</label>
                    <input id="order-quantity" type="number" step="0.01" min="0.01" @bind="_form.Quantity" />
                </div>

                @if (_form.Kind is "Limit" or "StopLimit")
                {
                    <div class="login-field">
                        <label for="order-limit-price">@(_editingExecutedOrder ? "Цена исполнения" : "Лимитная цена")</label>
                        <input id="order-limit-price" type="number" step="0.01" min="0" @bind="_form.Price" />
                    </div>
                }

                @if (_form.Kind is "StopMarket" or "StopLimit")
                {
                    <div class="login-field">
                        <label for="order-stop-price">Стоп-цена</label>
                        <input id="order-stop-price" type="number" step="0.01" min="0" @bind="_form.StopPrice" />
                    </div>
                }

                @if (_form.Kind == "TakeProfit")
                {
                    <div class="login-field">
                        <label for="order-take-profit">Целевая цена</label>
                        <input id="order-take-profit" type="number" step="0.01" min="0" @bind="_form.TakeProfitPrice" />
                    </div>
                }

                @if (_form.Kind == "TrailingStop")
                {
                    <div class="login-field">
                        <label for="order-trailing-mode">Режим трейлинга</label>
                        <select id="order-trailing-mode" @bind="_form.TrailingMode">
                            <option value="Percent">Процент от цены</option>
                            <option value="Absolute">Абсолютный размер</option>
                        </select>
                    </div>
                    @if (_form.TrailingMode == "Percent")
                    {
                        <div class="login-field">
                            <label for="order-trail-percent">Процент (%)</label>
                            <input id="order-trail-percent" type="number" step="0.01" min="0.01" @bind="_form.TrailPercentInput" />
                        </div>
                    }
                    else
                    {
                        <div class="login-field">
                            <label for="order-trail-amount">Абсолютный размер</label>
                            <input id="order-trail-amount" type="number" step="0.01" min="0.01" @bind="_form.TrailAmountInput" />
                        </div>
                    }
                }

                <div class="dialog-actions">
                    <button type="button" class="portfolio-refresh-button" @onclick="CloseDialog">Отмена</button>
                    <button type="submit" class="login-submit" disabled="@_busy">@(_busy ? "Сохранение…" : _editingOrderId is null ? "Создать ордер" : "Сохранить")</button>
                </div>
            </EditForm>
        </section>
    </div>
}

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true,
    };

    [Parameter] public int PortfolioId { get; set; }
    [Parameter] public EventCallback OnOrdersChanged { get; set; }

    private readonly List<OrderListItem> _orders = [];
    private bool _loading;
    private string? _error;
    private string? _actionMessage;
    private bool _busy;
    private bool _disposed;
    private int? _loadedPortfolioId;
    private Timer? _pollTimer;

    private bool _dialogOpen;
    private int? _editingOrderId;
    private bool _editingExecutedOrder;
    private string? _formError;
    private readonly OrderFormModel _form = new();
    private string _stockSearch = string.Empty;
    private bool _stockSearchOpen;
    private bool _stockSearchLoading;
    private List<StockOption> _stockOptions = [];
    private CancellationTokenSource? _stockSearchCancellation;

    private static readonly int[] PageSizeOptions = [10, 25, 50];
    private int _pageSize = 10;
    private int _openPage = 1;
    private int _historyPage = 1;
    private string _activeTab = "open";

    private int? _expandedOrderId;
    private PortfolioStockViewModel? _expandedStock;
    private bool _stockDetailsLoading;
    private string? _stockDetailsError;
    private readonly Dictionary<int, PortfolioStockViewModel> _stockDetailsCache = [];

    private List<OrderListItem> OpenOrders => _orders
        .Where(o => o.Status is "Pending" or "Triggered")
        .ToList();

    private List<OrderListItem> HistoryOrders => _orders
        .Where(o => o.Status is not ("Pending" or "Triggered"))
        .ToList();

    private int OpenPageCount => Math.Max(1, (int)Math.Ceiling(OpenOrders.Count / (double)_pageSize));

    private int HistoryPageCount => Math.Max(1, (int)Math.Ceiling(HistoryOrders.Count / (double)_pageSize));

    private List<OrderListItem> PagedOpenOrders => OpenOrders
        .Skip((_openPage - 1) * _pageSize)
        .Take(_pageSize)
        .ToList();

    private List<OrderListItem> PagedHistoryOrders => HistoryOrders
        .Skip((_historyPage - 1) * _pageSize)
        .Take(_pageSize)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedPortfolioId == PortfolioId) return;
        _loadedPortfolioId = PortfolioId;
        _orders.Clear();
        _openPage = 1;
        _historyPage = 1;
        _activeTab = "open";
        EnsurePolling();
        await LoadOrdersAsync();
    }

    private void EnsurePolling()
    {
        _pollTimer ??= new Timer(_ => _ = InvokeAsync(PollAsync), null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
    }

    private async Task PollAsync()
    {
        if (_disposed || _loading || _dialogOpen || _busy) return;
        await LoadOrdersAsync(silent: true);
    }

    private async Task LoadOrdersAsync() => await LoadOrdersAsync(silent: false);

    private async Task LoadOrdersAsync(bool silent)
    {
        if (_loading) return;
        _loading = true;
        if (!silent) _error = null;
        if (!silent) await InvokeAsync(StateHasChanged);

        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _error = "Войдите в приложение, чтобы увидеть ордера.";
                return;
            }

            using var response = await client.GetAsync($"Portfolios/{PortfolioId}/orders");
            if (!response.IsSuccessStatusCode)
            {
                if (!silent)
                {
                    if (response.StatusCode == HttpStatusCode.Unauthorized)
                    {
                        _error = "Войдите в приложение, чтобы увидеть ордера.";
                    }
                    else
                    {
                        var details = await ReadErrorAsync(response);
                        if (details.Length > 500) details = details[..500] + "…";
                        _error = $"Не удалось загрузить ордера (HTTP {(int)response.StatusCode}): {details}";
                    }
                }
                return;
            }

            var loaded = await response.Content.ReadFromJsonAsync<List<OrderListItem>>(JsonOptions) ?? [];
            _orders.Clear();
            _orders.AddRange(loaded);
            _error = null;
        }
        catch (Exception)
        {
            if (!silent) _error = "Не удалось загрузить ордера.";
        }
        finally
        {
            _loading = false;
            ClampPages();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ClampPages()
    {
        if (_openPage > OpenPageCount) _openPage = OpenPageCount;
        if (_openPage < 1) _openPage = 1;
        if (_historyPage > HistoryPageCount) _historyPage = HistoryPageCount;
        if (_historyPage < 1) _historyPage = 1;

        if (_expandedOrderId is int expandedId && _orders.All(o => o.Id != expandedId))
        {
            CollapseHistory();
        }
    }

    private void SelectTab(string tab)
    {
        _activeTab = tab == "history" ? "history" : "open";
        CollapseHistory();
    }

    private void GoToOpenPage(int page)
    {
        _openPage = Math.Clamp(page, 1, OpenPageCount);
        CollapseHistory();
    }

    private void GoToHistoryPage(int page)
    {
        _historyPage = Math.Clamp(page, 1, HistoryPageCount);
        CollapseHistory();
    }

    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size) || size <= 0) return;
        _pageSize = size;
        _openPage = 1;
        _historyPage = 1;
        CollapseHistory();
    }

    private async Task ToggleHistoryAsync(OrderListItem order)
    {
        if (_expandedOrderId == order.Id)
        {
            CollapseHistory();
            return;
        }

        _expandedOrderId = order.Id;
        _expandedStock = null;
        _stockDetailsError = null;

        if (_stockDetailsCache.TryGetValue(order.StockId, out var cached))
        {
            _expandedStock = cached;
            return;
        }

        var requestOrderId = order.Id;
        _stockDetailsLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _stockDetailsError = "Войдите в приложение, чтобы увидеть историю цены.";
                return;
            }

            using var response = await client.GetAsync($"Stocks/{order.StockId}");
            if (!response.IsSuccessStatusCode)
            {
                _stockDetailsError = await ReadErrorAsync(response);
                return;
            }

            var stock = await response.Content.ReadFromJsonAsync<StockDetailsResponse>(JsonOptions);
            if (stock is null)
            {
                _stockDetailsError = "Не удалось загрузить данные инструмента.";
                return;
            }

            var viewModel = new PortfolioStockViewModel
            {
                Id = stock.Id,
                Ticker = stock.Ticker ?? order.StockTicker ?? string.Empty,
                Name = stock.Name ?? order.StockName ?? string.Empty,
                CommonName = stock.CommonName,
                Exchange = stock.Exchange,
                Isin = stock.Isin,
                CurrentPrice = stock.CurrentPrice,
                CurrentPriceChange = stock.CurrentPriceChange,
                CurrentPriceChangePercent = stock.CurrentPriceChangePercent,
                CurrentPriceAt = stock.CurrentPriceAt,
            };

            _stockDetailsCache[order.StockId] = viewModel;
            if (_expandedOrderId == requestOrderId) _expandedStock = viewModel;
        }
        catch (Exception)
        {
            if (_expandedOrderId == requestOrderId) _stockDetailsError = "Не удалось загрузить данные инструмента.";
        }
        finally
        {
            if (_expandedOrderId == requestOrderId)
            {
                _stockDetailsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CollapseHistory()
    {
        _expandedOrderId = null;
        _expandedStock = null;
        _stockDetailsError = null;
        _stockDetailsLoading = false;
    }

    private void OpenDialog()
    {
        _formError = null;
        _actionMessage = null;
        _editingOrderId = null;
        _editingExecutedOrder = false;
        _dialogOpen = true;
        _form.Side = "Buy";
        _form.Kind = "Market";
        _form.Quantity = 1m;
        _form.Price = 0m;
        _form.StopPrice = null;
        _form.TakeProfitPrice = null;
        _form.TrailPercentInput = 5m;
        _form.TrailAmountInput = null;
        _form.TrailingMode = "Percent";
        _form.StockId = null;
        _stockSearch = string.Empty;
        _stockOptions = [];
        _stockSearchOpen = false;
    }

    private void OpenEditDialog(OrderListItem order)
    {
        _formError = null;
        _actionMessage = null;
        _editingOrderId = order.Id;
        _editingExecutedOrder = order.Status is "Executed" or "PartiallyFilled";
        _dialogOpen = true;
        _form.StockId = order.StockId;
        _form.Side = order.Side;
        _form.Kind = order.Kind;
        _form.Quantity = order.Quantity;
        _form.Price = order.Status is "Executed" or "PartiallyFilled"
            ? order.AverageFillPrice ?? order.Price
            : order.Price;
        _form.StopPrice = order.StopPrice;
        _form.TakeProfitPrice = order.TakeProfitPrice;
        _form.TrailPercentInput = order.TrailPercent;
        _form.TrailAmountInput = order.TrailAmount;
        _form.TrailingMode = order.TrailPercent is not null ? "Percent" : "Absolute";
        _stockSearch = string.IsNullOrWhiteSpace(order.StockName)
            ? order.StockTicker ?? string.Empty
            : $"{order.StockTicker} - {order.StockName}";
        _stockOptions = [];
        _stockSearchOpen = false;
    }

    private void CloseDialog()
    {
        _dialogOpen = false;
        _editingOrderId = null;
        _editingExecutedOrder = false;
        _stockSearchCancellation?.Cancel();
        _stockSearchOpen = false;
    }

    private async Task SubmitOrderAsync()
    {
        if (_form.StockId is null)
        {
            _formError = "Выберите акцию.";
            return;
        }

        _busy = true;
        _formError = null;
        var editingOrderId = _editingOrderId;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _formError = editingOrderId is null
                    ? "Войдите в приложение, чтобы создать ордер."
                    : "Войдите в приложение, чтобы сохранить ордер.";
                return;
            }

            var payload = new Dictionary<string, object?>
            {
                ["stockId"] = _form.StockId.Value,
                ["side"] = _form.Side,
                ["kind"] = _form.Kind,
                ["quantity"] = _form.Quantity,
            };

            switch (_form.Kind)
            {
                case "Limit":
                    payload["price"] = _form.Price;
                    break;
                case "StopMarket":
                    payload["stopPrice"] = _form.StopPrice;
                    break;
                case "StopLimit":
                    payload["price"] = _form.Price;
                    payload["stopPrice"] = _form.StopPrice;
                    break;
                case "TakeProfit":
                    payload["takeProfitPrice"] = _form.TakeProfitPrice;
                    break;
                case "TrailingStop":
                    if (_form.TrailingMode == "Percent")
                    {
                        payload["trailPercent"] = _form.TrailPercentInput;
                    }
                    else
                    {
                        payload["trailAmount"] = _form.TrailAmountInput;
                    }
                    break;
            }

            // Executed orders are edited by fill price regardless of their kind.
            if (editingOrderId is not null)
            {
                payload["price"] = _form.Price;
            }

            using var response = editingOrderId is int orderId
                ? await client.PutAsJsonAsync($"Portfolios/{PortfolioId}/orders/{orderId}", payload)
                : await client.PostAsJsonAsync($"Portfolios/{PortfolioId}/orders", payload);
            if (!response.IsSuccessStatusCode)
            {
                _formError = await ReadErrorAsync(response);
                return;
            }

            _dialogOpen = false;
            _actionMessage = editingOrderId is null ? "Ордер создан." : "Ордер сохранён.";
            _editingOrderId = null;
            if (editingOrderId is null)
            {
                _activeTab = _form.Kind == "Market" ? "history" : "open";
            }
            await LoadOrdersAsync(silent: true);
            if (OnOrdersChanged.HasDelegate) await OnOrdersChanged.InvokeAsync();
        }
        catch (Exception)
        {
            _formError = editingOrderId is null ? "Не удалось создать ордер." : "Не удалось сохранить ордер.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelOrderAsync(OrderListItem order)
    {
        _busy = true;
        _actionMessage = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _actionMessage = "Войдите в приложение, чтобы отменить ордер.";
                return;
            }

            using var response = await client.PostAsync($"Portfolios/{PortfolioId}/orders/{order.Id}/cancel", null);
            if (!response.IsSuccessStatusCode)
            {
                _actionMessage = await ReadErrorAsync(response);
                return;
            }

            _actionMessage = "Ордер отменён.";
            await LoadOrdersAsync(silent: true);
            if (OnOrdersChanged.HasDelegate) await OnOrdersChanged.InvokeAsync();
        }
        catch (Exception)
        {
            _actionMessage = "Не удалось отменить ордер.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteOrderAsync(OrderListItem order)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Удалить ордер {order.StockTicker}?")) return;

        _busy = true;
        _actionMessage = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _actionMessage = "Войдите в приложение, чтобы удалить ордер.";
                return;
            }

            using var response = await client.DeleteAsync($"Portfolios/{PortfolioId}/orders/{order.Id}");
            if (!response.IsSuccessStatusCode)
            {
                _actionMessage = await ReadErrorAsync(response);
                return;
            }

            _actionMessage = "Ордер удалён.";
            if (_expandedOrderId == order.Id) CollapseHistory();
            await LoadOrdersAsync(silent: true);
            if (OnOrdersChanged.HasDelegate) await OnOrdersChanged.InvokeAsync();
        }
        catch (Exception)
        {
            _actionMessage = "Не удалось удалить ордер.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnStockSearchChanged(ChangeEventArgs args)
    {
        var query = args.Value?.ToString() ?? string.Empty;
        _stockSearch = query;
        _stockSearchOpen = query.Trim().Length >= 2;
        _stockOptions = [];
        _stockSearchLoading = false;

        _stockSearchCancellation?.Cancel();
        _stockSearchCancellation?.Dispose();
        _stockSearchCancellation = null;

        if (!_stockSearchOpen) return;

        var cancellation = new CancellationTokenSource();
        _stockSearchCancellation = cancellation;
        _stockSearchLoading = true;
        try
        {
            await Task.Delay(250, cancellation.Token);
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            using var response = await client.GetAsync($"Stocks/search?q={Uri.EscapeDataString(query.Trim())}&limit=15", cancellation.Token);
            if (response.IsSuccessStatusCode)
            {
                _stockOptions = await response.Content.ReadFromJsonAsync<List<StockOption>>(JsonOptions, cancellation.Token) ?? [];
            }
        }
        catch (OperationCanceledException) { }
        catch { _formError = "Не удалось выполнить поиск акции."; }
        finally
        {
            if (!cancellation.IsCancellationRequested)
            {
                _stockSearchLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void SelectStock(StockOption stock)
    {
        _form.StockId = stock.Id;
        _stockSearch = $"{stock.Ticker} - {stock.Name}";
        _stockSearchOpen = false;
        _stockOptions = [];
    }

    private async Task<HttpClient?> CreateAuthenticatedClientAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
        string? token;
        try
        {
            token = await module.InvokeAsync<string?>("getToken");
        }
        finally
        {
            await module.DisposeAsync();
        }

        if (string.IsNullOrWhiteSpace(token)) return null;

        var client = HttpClientFactory.CreateClient("FinanceApi");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        return client;
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(body))
            {
                var trimmed = body.Trim();
                if (trimmed.StartsWith('"') && trimmed.EndsWith('"'))
                {
                    return JsonSerializer.Deserialize<string>(trimmed) ?? trimmed;
                }
                return trimmed;
            }
        }
        catch
        {
        }
        return $"Запрос завершился с ошибкой (HTTP {(int)response.StatusCode}).";
    }

    private static string SideLabel(string side) => side == "Buy" ? "Покупка" : "Продажа";

    private static string KindLabel(string kind) => kind switch
    {
        "Market" => "Рыночный",
        "Limit" => "Лимитный",
        "StopMarket" => "Стоп-маркет",
        "StopLimit" => "Стоп-лимит",
        "TakeProfit" => "Тейк-профит",
        "TrailingStop" => "Трейлинг-стоп",
        _ => kind,
    };

    private static string StatusLabel(string status) => status switch
    {
        "Pending" => "Ожидает",
        "Triggered" => "Активирован",
        "Executed" => "Исполнен",
        "Cancelled" => "Отменён",
        "Rejected" => "Отклонён",
        "Expired" => "Истёк",
        "PartiallyFilled" => "Частично исполнен",
        _ => status,
    };

    private static string PriceCondition(OrderListItem order) => order.Kind switch
    {
        "Market" => "По рынку",
        "Limit" => $"Лимит {FormatMoney(order.Price)}",
        "StopMarket" => $"Стоп {FormatMoney(order.StopPrice ?? 0m)}",
        "StopLimit" => $"Стоп {FormatMoney(order.StopPrice ?? 0m)} / лимит {FormatMoney(order.Price)}",
        "TakeProfit" => $"Цель {FormatMoney(order.TakeProfitPrice ?? 0m)}",
        "TrailingStop" => order.TrailPercent is decimal percent
            ? $"Трейлинг {percent.ToString("N2", RussianCulture)}%"
            : $"Трейлинг {FormatMoney(order.TrailAmount ?? 0m)}",
        _ => "—",
    };

    private static string FormatMoney(decimal value) => $"{value.ToString("N2", RussianCulture)} €";
    private static string FormatNumber(decimal value) => value.ToString("N2", RussianCulture);
    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("dd.MM.yyyy HH:mm", RussianCulture);
    private static string FormatDateTime(DateTime? value) => value?.ToLocalTime().ToString("dd.MM.yyyy HH:mm", RussianCulture) ?? "—";

    public void Dispose()
    {
        _disposed = true;
        _pollTimer?.Dispose();
        _stockSearchCancellation?.Cancel();
        _stockSearchCancellation?.Dispose();
    }

