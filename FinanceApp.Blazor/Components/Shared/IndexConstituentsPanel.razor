        _createModalOpen = true;
        _editError = null;
        _editForm = new ConstituentEditModel { Exchange = "NYSE", MarketIndexIds = [IndexId] };
        _editLoading = true;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            if (_sectors.Count == 0)
            {
                using var sectorsResponse = await client.GetAsync("Sectors?includeArchived=true");
                if (sectorsResponse.IsSuccessStatusCode)
                {
                    var sectors = await sectorsResponse.Content
                        .ReadFromJsonAsync<List<TrackedSectorDirectoryViewModel>>(JsonOptions)
                        ?? new List<TrackedSectorDirectoryViewModel>();

                    _sectors.AddRange(sectors);
                }
            }

            if (_marketIndices.Count == 0)
            {
                using var indicesResponse = await client.GetAsync("market-indices?includeArchived=true");
                if (indicesResponse.IsSuccessStatusCode)
                {
                    var indices = await indicesResponse.Content
                        .ReadFromJsonAsync<List<TrackedMarketIndexDirectoryViewModel>>(JsonOptions)
                        ?? new List<TrackedMarketIndexDirectoryViewModel>();

                    _marketIndices.AddRange(indices);
                }
            }
