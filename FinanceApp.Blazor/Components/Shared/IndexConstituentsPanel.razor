    private (decimal? Price, decimal? Change, decimal? Percent, DateTime? Timestamp) GetDisplaySnapshot(IndexConstituentDto constituent)
    {
        if (_liveQuotes.TryGetValue(constituent.StockId, out var quote)
            && quote.CurrentPriceEur is decimal price
            && quote.PriceTimestampUtc is DateTime liveAt
            && (constituent.CurrentPriceAt is not DateTime storedAt || liveAt >= storedAt))
        {
            return (price, quote.ChangeEur, quote.PercentChange, liveAt);
        }
        return (constituent.CurrentPrice, constituent.CurrentPriceChange, constituent.CurrentPriceChangePercent, constituent.CurrentPriceAt);
    }

    private async Task<HttpClient?> CreateAuthenticatedClientAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./portfolioApi.js");
        try
        {
            var token = await module.InvokeAsync<string?>("getToken");
            if (string.IsNullOrWhiteSpace(token)) return null;
            var client = HttpClientFactory.CreateClient("FinanceApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            return client;
        }
        finally
        {
            await module.DisposeAsync();
        }
    }

    private static T? TryDeserialize<T>(string body) where T : class
    {
        if (string.IsNullOrWhiteSpace(body)) return null;
        try { return JsonSerializer.Deserialize<T>(body, JsonOptions); }
        catch (JsonException) { return null; }
    }

    private static string? ExtractApiErrorMessage(string body)
    {
        if (string.IsNullOrWhiteSpace(body)) return null;
        try
        {
            using var document = JsonDocument.Parse(body);
            if (document.RootElement.ValueKind == JsonValueKind.String) return document.RootElement.GetString();
            foreach (var key in new[] { "message", "detail", "title" })
            {
                if (document.RootElement.TryGetProperty(key, out var value) && value.ValueKind == JsonValueKind.String)
                {
                    var text = value.GetString();
                    if (!string.IsNullOrWhiteSpace(text)) return text;
                }
            }
        }
        catch (JsonException)
        {
        }
        return body.TrimStart().StartsWith('<') ? null : body;
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;
    private static bool Contains(string? value, string query) => value?.Contains(query, StringComparison.CurrentCultureIgnoreCase) == true;
    private static string FormatMoney(decimal? value, bool signed = false)
    {
        if (value is null) return "—";
        var number = value.Value.ToString("N2", RussianCulture);
        return signed && value.Value > 0m ? $"+{number} €" : $"{number} €";
    }

    private static string FormatPercent(decimal? value) =>
        value is null ? "—" : $"{(value.Value > 0m ? "+" : string.Empty)}{value.Value.ToString("N2", RussianCulture)} %";

    private static string FormatPerformance(decimal? value) =>
        value is null ? "—" : $"{(value.Value > 0m ? "+" : string.Empty)}{value.Value.ToString("N2", RussianCulture)} %";

    private static string FormatDateTime(DateTime? value) =>
        value is null ? "—" : value.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm", RussianCulture);

