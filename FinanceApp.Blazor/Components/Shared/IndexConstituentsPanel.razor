            _editLoading = false;
        }
    }

    private async Task OpenEditAsync(IndexConstituentDto constituent)
    {
        _editing = constituent;
        _editLoading = true;
        _editError = null;
        _editForm = new ConstituentEditModel();
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            using var stockResponse = await client.GetAsync($"Stocks/{constituent.StockId}");
            if (!stockResponse.IsSuccessStatusCode)
            {
                _editError = "Ошибка загрузки акции";
                return;
            }
            var stock = await stockResponse.Content.ReadFromJsonAsync<EditSourceStock>(JsonOptions);
            if (stock is not null)
            {
                _editForm = new ConstituentEditModel
                {
                    Ticker = stock.Ticker,
                    Exchange = stock.Exchange,
                    Name = stock.Name,
                    CommonName = stock.CommonName ?? string.Empty,
                    Wkn = stock.Wkn ?? string.Empty,
                    Isin = stock.Isin ?? string.Empty,
                    FinanzenNetSlug = stock.FinanzenNetSlug ?? string.Empty,
                    CurrentPrice = stock.CurrentPrice,
                    SectorId = stock.SectorId,
                    IndustryId = stock.IndustryId,
                    MarketIndexIds = [.. stock.MarketIndexIds],
                };
            }

            if (_sectors.Count == 0)
            {
                using var sectorsResponse = await client.GetAsync("Sectors?includeArchived=true");
                if (sectorsResponse.IsSuccessStatusCode)
                {
                    _sectors.Clear();
                    _sectors.AddRange(await sectorsResponse.Content.ReadFromJsonAsync<List<TrackedSectorDirectoryViewModel>>(JsonOptions) ?? []);
                }
            }
            if (_marketIndices.Count == 0)
            {
                using var indicesResponse = await client.GetAsync("market-indices?includeArchived=true");
                if (indicesResponse.IsSuccessStatusCode)
                {
                    _marketIndices.Clear();
                    _marketIndices.AddRange(await indicesResponse.Content.ReadFromJsonAsync<List<TrackedMarketIndexDirectoryViewModel>>(JsonOptions) ?? []);
                }
            }
        }
        catch
        {
            _editError = "Ошибка загрузки акции";
        }
        finally
        {
            _editLoading = false;
        }
    }

    private void CloseEdit()
    {
        if (_editSaving) return;
        _editing = null;
        _editError = null;
    }

    private void OnEditSectorChanged(int? sectorId)
    {
        _editForm.SectorId = sectorId;
        if (_editForm.IndustryId is int industryId
            && !_sectors.Any(sector => sector.Id == sectorId && sector.Industries.Any(industry => industry.Id == industryId)))
        {
            _editForm.IndustryId = null;
        }
    }

    private void ToggleEditMarketIndex(int indexId, ChangeEventArgs args)
    {
        var selected = string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (selected && !_editForm.MarketIndexIds.Contains(indexId)) _editForm.MarketIndexIds.Add(indexId);
        else if (!selected) _editForm.MarketIndexIds.Remove(indexId);
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null || _editSaving) return;
        _editSaving = true;
        _editError = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _editError = "Войдите в приложение и повторите попытку.";
                return;
            }
            var payload = new
            {
                ticker = _editForm.Ticker,
                exchange = _editForm.Exchange,
                name = _editForm.Name.Trim(),
                commonName = string.IsNullOrWhiteSpace(_editForm.CommonName) ? _editForm.Name.Trim() : _editForm.CommonName.Trim(),
                wkn = NullIfEmpty(_editForm.Wkn?.Trim().ToUpperInvariant()),
                isin = NullIfEmpty(_editForm.Isin?.Trim().ToUpperInvariant()),
                finanzenNetSlug = NullIfEmpty(_editForm.FinanzenNetSlug?.Trim().ToLowerInvariant()),
                currentPrice = _editForm.CurrentPrice,
                sectorId = _editForm.SectorId,
                industryId = _editForm.IndustryId,
                marketIndexIds = _editForm.MarketIndexIds.Distinct().ToList(),
                confirmationText = string.Empty,
                identityEditingEnabled = false,
                retainProviderSymbol = false
            };
            using var response = await client.PutAsJsonAsync($"Stocks/{_editing.StockId}/edit", payload);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _editError = ExtractApiErrorMessage(body) ?? $"Ошибка сохранения акции (HTTP {(int)response.StatusCode}).";
                return;
            }
            _editing = null;
            _infoNotice = "Акция обновлена";
            _infoNoticeLevel = "info";
            await LoadConstituentsAsync();
            if (_sortMode != "name") await LoadPerformanceAsync(_sortMode);
        }
        catch
        {
            _editError = "Ошибка сохранения акции";
        }
        finally
        {
            _editSaving = false;
        }
    }

