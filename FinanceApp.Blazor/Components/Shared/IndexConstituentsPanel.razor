@using System.Globalization
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using FinanceApp.Blazor.Components.Models
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<div class="index-constituents-panel">
    @if (!string.IsNullOrWhiteSpace(_infoNotice))
    {
        <div class="constituents-alert constituents-alert--@_infoNoticeLevel" role="status">@_infoNotice</div>
    }
    @if (!string.IsNullOrWhiteSpace(_quoteSummary))
    {
        <div class="constituents-alert constituents-alert--info" role="status">@_quoteSummary</div>
    }
    @if (!string.IsNullOrWhiteSpace(_performanceError))
    {
        <div class="constituents-alert constituents-alert--warning" role="alert">@_performanceError</div>
    }

    <div class="constituents-toolbar">
        <input type="search" class="constituents-search" placeholder="Поиск по тикеру, названию, WKN, ISIN…" aria-label="Поиск по составу индекса" value="@_search" @oninput="OnSearchInput" />
        <label class="constituents-sort-label">
            Сортировка:
            <select value="@_sortMode" @onchange="OnSortModeChanged" aria-label="Сортировка">
                <option value="name">По названию</option>
                @foreach (var range in PerformanceRanges)
                {
                    <option value="@range.Value">@range.Label</option>
                }
            </select>
        </label>
        @if (_sortMode != "name")
        {
            <button type="button" class="stocks-toolbar-button stocks-sort-direction" @onclick="ToggleSortDirection" aria-label="@(_sortDirection == "desc" ? "Сортировать по возрастанию" : "Сортировать по убыванию")" title="@(_sortDirection == "desc" ? "Убывание" : "Возрастание")">@(_sortDirection == "desc" ? "↑" : "↓")</button>
        }
        @if (!IsArchived)
        {
            <button type="button" class="stocks-toolbar-button" @onclick="RefreshConstituentsAsync" disabled="@(_refreshing || _batchHistoryRefreshing || _batchQuoteRefreshing)">@(_refreshing ? "Обновление…" : "Обновить состав")</button>
        }
        <button type="button" class="stocks-toolbar-button" @onclick="OpenCreateAsync" disabled="@(IsArchived || _editLoading)">＋ Добавить акцию</button>
        <button type="button" class="stocks-toolbar-button" @onclick="ConfirmBatchHistoryRefreshAsync" disabled="@(IsArchived || _constituents.Count == 0 || _refreshing || _batchHistoryRefreshing || _batchQuoteRefreshing)">@(_batchHistoryRefreshing ? "Обновление истории…" : "Обновить историю акций")</button>
        <button type="button" class="stocks-toolbar-button" @onclick="BatchRefreshQuotesAsync" disabled="@(IsArchived || _constituents.Count == 0 || _batchQuoteRefreshing)">
            @(_batchQuoteRefreshing && !string.IsNullOrWhiteSpace(_batchQuoteProgress) ? _batchQuoteProgress : "Обновить текущие цены")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_source) || _asOfDate is not null)
    {
        <div class="constituents-source-alert @(_sourceIsStale ? "constituents-alert--warning" : "constituents-alert--info")">
            <span>Источник: @(string.IsNullOrWhiteSpace(_source) ? "—" : _source)@(_isCuratedSnapshot ? " (Проверенный снимок)" : "")</span>
            @if (_asOfDate is DateTime asOf)
            {
                <span>As of: @asOf.ToLocalTime().ToString("dd.MM.yyyy", RussianCulture)</span>
            }
        </div>
    }

    @if (_loading)
    {
        <div class="position-history-state">Загрузка состава…</div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="constituents-alert constituents-alert--error" role="alert">
            @_error
            <button type="button" class="stocks-toolbar-button" @onclick="LoadConstituentsAsync">Повторить</button>
        </div>
    }
    else if (_constituents.Count == 0)
    {
        <div class="position-history-state">Состав этого индекса не загружен. Нажмите «Обновить состав» для импорта.</div>
    }
    else if (FilteredConstituents.Count == 0)
    {
        <div class="position-history-state">Нет компонентов, соответствующих поиску</div>
    }
    else
    {
        <div class="positions-table-wrap index-constituents-table-wrap">
            <table class="positions-table index-constituents-table">
                <thead>
                    <tr>
                        <th>Тикер</th>
                        <th>Название</th>
                        <th class="numeric">Текущая цена</th>
                        <th class="numeric">Изменение (€)</th>
                        <th class="numeric">(%)</th>
                        <th class="numeric">Рост за период</th>
                        <th>Цена API</th>
                        <th>Время</th>
                        <th class="actions-heading">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var constituent in PagedConstituents)
                    {
                        var snapshot = GetDisplaySnapshot(constituent);
                        var change = snapshot.Change;
                        var percent = snapshot.Percent;
                        var expanded = _expandedStockId == constituent.StockId;
                        <tr>
                            <td>
                                <button type="button" class="ticker-chart-toggle" @onclick="() => ToggleHistory(constituent.StockId)" aria-expanded="@expanded" aria-controls="index-constituent-history-@constituent.StockId">
                                    <span class="ticker-chart-caret @(expanded ? "expanded" : "")">›</span>@constituent.Ticker
                                </button>
                                <span class="ticker-exchange-abbreviation">@constituent.Exchange</span>
                            </td>
                            <td>
                                <div class="index-constituent-name">
                                    <strong title="@constituent.Name">@constituent.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(constituent.CommonName) && constituent.CommonName != constituent.Name)
                                    {
                                        <span class="tracked-stock-common-name">@constituent.CommonName</span>
                                    }
                                    <span class="index-constituent-classification">@(string.Join(" · ", new[] { constituent.Sector, constituent.Industry }.Where(value => !string.IsNullOrWhiteSpace(value))))</span>
                                </div>
                            </td>
                            <td class="numeric">@FormatMoney(snapshot.Price)</td>
                            <td class="numeric"><span class="@(change is null ? "" : change >= 0 ? "positive" : "negative")">@FormatMoney(change, signed: true)</span></td>
                            <td class="numeric"><span class="@(percent is null ? "" : percent >= 0 ? "positive" : "negative")">@FormatPercent(percent)</span></td>
                            <td class="numeric">
                                @if (_performanceLoading)
                                {
                                    <span class="index-constituent-muted">…</span>
                                }
                                else if (_performanceByStockId.TryGetValue(constituent.StockId, out var performance) && performance is decimal)
                                {
                                    <span class="@(performance >= 0 ? "positive" : "negative")">@FormatPerformance(performance)</span>
                                }
                                else
                                {
                                    <span class="index-constituent-muted" title="Недостаточно исторических данных">—</span>
                                }
                            </td>
                            <td>
                                @if (_liveQuotes.TryGetValue(constituent.StockId, out var live) && live.CurrentPriceEur is decimal livePrice)
                                {
                                    <span class="index-constituent-api-price">
                                        @livePrice.ToString("N2", RussianCulture)
                                        @if (live.IsStale || !string.IsNullOrWhiteSpace(live.DelayWarning))
                                        {
                                            <span class="index-constituent-delay-tag" title="@live.DelayWarning">Задержано</span>
                                        }
                                        else if (live.CurrentPriceEur is null)
                                        {
                                            <span class="index-constituent-delay-tag">Нет EUR</span>
                                        }
                                    </span>
                                }
                                else if (constituent.CurrentPriceIsDelayed)
                                {
                                    <span class="index-constituent-api-price">
                                        @FormatMoney(constituent.CurrentPrice)
                                        <span class="index-constituent-delay-tag" title="@constituent.CurrentPriceDelayWarning">Задержано</span>
                                    </span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@FormatDateTime(snapshot.Timestamp)</td>
                            <td>
                                <div class="index-constituent-actions">
                                    <button type="button" class="action-icon-button" title="Обновить цену" aria-label="Обновить цену @constituent.Ticker" @onclick="() => RefreshLivePriceAsync(constituent)" disabled="@(_quoteLoadingId is not null || _batchHistoryRefreshing)">⟳</button>
                                    <button type="button" class="action-icon-button" title="Редактировать акцию" aria-label="Редактировать акцию @constituent.Ticker" @onclick="() => OpenEditAsync(constituent)" disabled="@_editLoading">✎</button>
                                    @if (string.Equals(constituent.TrackingStatus, "Tracked", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="index-constituent-tracked" title="Уже в списке акций">✓</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="action-icon-button" title="Добавить в список акций" aria-label="Добавить @constituent.Ticker в список акций" @onclick="() => TrackAsync(constituent)" disabled="@(_trackingStockId is not null)">＋</button>
                                    }
                                </div>
                            </td>
                        </tr>
                        @if (expanded)
                        {
                            <tr id="index-constituent-history-@constituent.StockId" class="position-history-row"><td colspan="9"><StockHistoryPanel Stock="ToHistoryStock(constituent)" /></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (PageCount > 1)
        {
            <div class="catalog-pagination index-constituents-pagination">
                <button type="button" class="stocks-toolbar-button" @onclick="PreviousPage" disabled="@(_page <= 1)">← Назад</button>
                <span>Страница @_page из @PageCount</span>
                <button type="button" class="stocks-toolbar-button" @onclick="NextPage" disabled="@(_page >= PageCount)">Вперёд →</button>
                <span>Всего: @FilteredConstituents.Count</span>
            </div>
        }
    }
</div>

@if (_editing is not null || _createModalOpen)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseEdit">
        <section class="action-dialog stock-edit-dialog" role="dialog" aria-modal="true" aria-labelledby="constituent-edit-title" @onclick:stopPropagation>
            <h2 id="constituent-edit-title">@(_createModalOpen ? "Добавить акцию" : "Редактировать акцию")</h2>
            @if (_editing is not null)
            {
                <p class="action-dialog-subtitle">@_editing.Ticker · @_editing.Name</p>
            }
            @if (_editLoading)
            {
                <div class="position-history-state">Загрузка…</div>
            }
            else
            {
                <EditForm Model="@_editForm" OnValidSubmit="SaveEditAsync" FormName="constituent-stock-edit-form">
                    <DataAnnotationsValidator />
                    @if (!string.IsNullOrWhiteSpace(_editError))
                    {
                        <div class="portfolio-state-error" role="alert">@_editError</div>
                    }
                    <div class="stock-edit-grid">
                        <label class="login-field">Тикер<InputText @bind-Value="_editForm.Ticker" disabled="@(!_createModalOpen)" /></label>
                        <label class="login-field">Биржа<InputText @bind-Value="_editForm.Exchange" disabled="@(!_createModalOpen)" /></label>
                        <label class="login-field">Название<InputText @bind-Value="_editForm.Name" /></label>
                        <label class="login-field">Общее название<InputText @bind-Value="_editForm.CommonName" /></label>
                        <label class="login-field">ISIN<InputText @bind-Value="_editForm.Isin" /></label>
                        <label class="login-field">WKN<InputText @bind-Value="_editForm.Wkn" /></label>
                        <label class="login-field">Сектор<InputSelect TValue="int?" Value="@_editForm.SectorId" ValueChanged="OnEditSectorChanged" ValueExpression="@(() => _editForm.SectorId)"><option value="">Без сектора</option>@foreach (var sector in Sectors) { <option value="@sector.Id">@sector.Name@(sector.IsArchived ? " (архив)" : "")</option> }</InputSelect></label>
                        <label class="login-field">Отрасль<InputSelect @bind-Value="_editForm.IndustryId"><option value="">Без отрасли</option>@foreach (var industry in EditIndustries) { <option value="@industry.Id">@industry.Name@(industry.IsArchived ? " (архив)" : "")</option> }</InputSelect></label>
                        <label class="login-field">Текущая цена (€)<InputNumber @bind-Value="_editForm.CurrentPrice" step="0.01" /></label>
                        <label class="login-field">Finanzen.net slug<InputText @bind-Value="_editForm.FinanzenNetSlug" /></label>
                    </div>
                    <fieldset class="stock-edit-indices">
                        <legend>Биржевые индексы</legend>
                        @foreach (var index in MarketIndices)
                        {
                            <label><input type="checkbox" checked="@_editForm.MarketIndexIds.Contains(index.Id)" @onchange="args => ToggleEditMarketIndex(index.Id, args)" /> @index.Name@(index.IsArchived ? " (архив)" : "")</label>
                        }
                    </fieldset>
                    <footer class="stock-edit-footer">
                        <button type="button" class="dialog-secondary-button" @onclick="CloseEdit" disabled="@_editSaving">Отмена</button>
                        <button type="submit" class="portfolio-primary-button" disabled="@_editSaving">@(_editSaving ? "Сохранение…" : _createModalOpen ? "Добавить" : "Сохранить")</button>
                    </footer>
                </EditForm>
            }
        </section>
    </div>
}

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly (string Label, string Value)[] PerformanceRanges =
    [
        ("Сегодня", "today"), ("24 ч.", "24h"), ("1 нед.", "1w"), ("1 мес.", "1m"), ("3 мес.", "3m"),
        ("6 мес.", "6m"), ("1 год", "1y"), ("3 года", "3y"), ("5 лет", "5y"),
    ];
    private static readonly string[] TerminalJobStates = ["Succeeded", "RateLimited", "Failed", "Interrupted"];

    [Parameter, EditorRequired] public int IndexId { get; set; }
    [Parameter] public bool IsArchived { get; set; }

    private readonly List<IndexConstituentDto> _constituents = [];
    private readonly Dictionary<int, decimal?> _performanceByStockId = [];
    private readonly Dictionary<int, StockLiveQuoteViewModel> _liveQuotes = [];
    private readonly List<TrackedSectorDirectoryViewModel> _sectors = [];
    private readonly List<TrackedMarketIndexDirectoryViewModel> _marketIndices = [];

    private bool _loading;
    private bool _refreshing;
    private bool _performanceLoading;
    private string? _performanceError;
    private string? _error;
    private string? _infoNotice;
    private string _infoNoticeLevel = "info";
    private string? _search = string.Empty;
    private string _sortMode = "name";
    private string _sortDirection = "desc";
    private int _page = 1;
    private int? _loadedIndexId;
    private int? _trackingStockId;
    private int? _quoteLoadingId;
    private int? _expandedStockId;
    private string? _source;
    private DateTime? _asOfDate;
    private bool _isCuratedSnapshot;
    private bool _sourceIsStale;

    private bool _batchHistoryRefreshing;
    private bool _batchQuoteRefreshing;
    private string? _batchQuoteProgress;
    private string? _quoteSummary;

    private IndexConstituentDto? _editing;
    private bool _createModalOpen;
    private ConstituentEditModel _editForm = new();
    private bool _editLoading;
    private bool _editSaving;
    private string? _editError;

    private IEnumerable<TrackedIndustryDirectoryViewModel> EditIndustries =>
        Sectors.Where(sector => sector.Id == _editForm.SectorId)
            .SelectMany(sector => sector.Industries.Where(industry => !industry.IsArchived || industry.Id == _editForm.IndustryId))
            .OrderBy(industry => industry.Name, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<TrackedSectorDirectoryViewModel> Sectors => _sectors.Where(sector => !sector.IsArchived || sector.Id == _editForm.SectorId);
    private IEnumerable<TrackedMarketIndexDirectoryViewModel> MarketIndices => _marketIndices.Where(index => !index.IsArchived || _editForm.MarketIndexIds.Contains(index.Id));

    private List<IndexConstituentDto> FilteredConstituents
    {
        get
        {
            var direction = _sortDirection == "asc" ? 1 : -1;
            var sorted = _sortMode == "name"
                ? _constituents.OrderBy(item => item.Name, StringComparer.CurrentCultureIgnoreCase)
                    .ThenBy(item => item.Ticker, StringComparer.CurrentCultureIgnoreCase)
                    .ThenBy(item => item.StockId)
                : _constituents.OrderByDescending(item => PerformanceOf(item.StockId) is not null)
                    .ThenBy(item => (PerformanceOf(item.StockId) ?? decimal.MinValue) * direction)
                    .ThenBy(item => item.StockId);

            var query = (_search ?? string.Empty).Trim();
            if (query.Length == 0) return sorted.ToList();

            return sorted.Where(item =>
                Contains(item.Ticker, query)
                || Contains(item.Name, query)
                || Contains(item.CommonName, query)
                || Contains(item.Wkn, query)
                || Contains(item.Isin, query)
                || Contains(item.ProviderSymbol, query)).ToList();
        }
    }

    private decimal? PerformanceOf(int stockId) =>
        _performanceByStockId.TryGetValue(stockId, out var value) ? value : null;

    private List<IndexConstituentDto> PagedConstituents => FilteredConstituents.Skip((_page - 1) * 20).Take(20).ToList();
    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredConstituents.Count / 20.0));

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedIndexId == IndexId) return;
        _loadedIndexId = IndexId;
        _page = 1;
        _search = string.Empty;
        _expandedStockId = null;
        _liveQuotes.Clear();
        _performanceError = null;
        _performanceByStockId.Clear();
        await LoadConstituentsAsync();
        if (_sortMode != "name") await LoadPerformanceAsync(_sortMode);
    }

    private async Task LoadConstituentsAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _error = "Войдите в приложение, чтобы увидеть состав индекса.";
                return;
            }

            using var response = await client.GetAsync($"market-indices/{IndexId}/constituents?includeFormer=false");
            if (!response.IsSuccessStatusCode)
            {
                _error = response.StatusCode == HttpStatusCode.Unauthorized
                    ? "Войдите в приложение, чтобы увидеть состав индекса."
                    : $"Не удалось загрузить состав индекса (HTTP {(int)response.StatusCode}).";
                return;
            }

            var data = await response.Content.ReadFromJsonAsync<IndexConstituentsResponse>(JsonOptions);
            _constituents.Clear();
            if (data?.Constituents is not null) _constituents.AddRange(data.Constituents);
            _source = data?.Source;
            _asOfDate = data?.AsOfDate;
            _isCuratedSnapshot = data?.IsCuratedSnapshot == true;
            _sourceIsStale = data?.IsStale == true;
            if (_page > PageCount) _page = PageCount;
        }
        catch
        {
            _error = "Не удалось загрузить состав индекса.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadPerformanceAsync(string range)
    {
        _performanceLoading = true;
        _performanceError = null;
        _performanceByStockId.Clear();
        var requested = range;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            using var response = await client.GetAsync($"market-indices/{IndexId}/constituents/performance?range={Uri.EscapeDataString(range)}");
            if (!response.IsSuccessStatusCode)
            {
                if (_sortMode == requested) _performanceError = "Ошибка загрузки данных о росте";
                return;
            }
            var data = await response.Content.ReadFromJsonAsync<IndexConstituentPerformanceResponse>(JsonOptions);
            if (_sortMode != requested) return;
            foreach (var item in data?.Items ?? [])
            {
                _performanceByStockId[item.StockId] = item.ChangePercent;
            }
        }
        catch
        {
            if (_sortMode == requested) _performanceError = "Ошибка загрузки данных о росте";
        }
        finally
        {
            if (_sortMode == requested) _performanceLoading = false;
        }
    }

    private async Task OnSortModeChanged(ChangeEventArgs args)
    {
        var next = args.Value?.ToString() ?? "name";
        _sortMode = PerformanceRanges.Any(range => range.Value == next) ? next : "name";
        _page = 1;
        if (_sortMode == "name")
        {
            _performanceByStockId.Clear();
            _performanceError = null;
            _performanceLoading = false;
            return;
        }
        await LoadPerformanceAsync(_sortMode);
    }

    private void ToggleSortDirection()
    {
        _sortDirection = _sortDirection == "desc" ? "asc" : "desc";
        _page = 1;
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _page = 1;
    }

    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < PageCount) _page++; }

    private async Task RefreshConstituentsAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        _infoNotice = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _infoNotice = "Войдите в приложение и повторите попытку.";
                return;
            }
            using var response = await client.PostAsync($"market-indices/{IndexId}/constituents/refresh", null);
            var body = await response.Content.ReadAsStringAsync();
            var result = TryDeserialize<IndexConstituentsRefreshResponse>(body);
            if (result is null)
            {
                _infoNotice = $"Ошибка обновления состава (HTTP {(int)response.StatusCode}).";
                return;
            }

            _source = string.IsNullOrWhiteSpace(result.ProviderName) ? _source : result.ProviderName;
            _asOfDate = result.AsOfDate ?? _asOfDate;
            _isCuratedSnapshot = result.IsCuratedSnapshot || _isCuratedSnapshot;
            _sourceIsStale = result.IsStale;

            var providerStatus = result.ProviderStatus ?? string.Empty;
            var details = $"добавлено {result.Added}, обновлено {result.Updated}, без изменений {result.Unchanged}, закрыто {result.Closed}";
            if (result.Conflicts is int conflicts && conflicts > 0) details += $", конфликтов {conflicts}";
            _infoNotice = string.IsNullOrWhiteSpace(result.ProviderMessage)
                ? $"Состав обновлён: {details}."
                : $"Состав обновлён: {details}. {result.ProviderMessage}";
            _infoNoticeLevel = string.Equals(providerStatus, "Success", StringComparison.OrdinalIgnoreCase) && (result.Conflicts ?? 0) == 0
                ? "info"
                : "warning";

            if (string.Equals(providerStatus, "Success", StringComparison.OrdinalIgnoreCase)
                || string.Equals(providerStatus, "Partial", StringComparison.OrdinalIgnoreCase))
            {
                await LoadConstituentsAsync();
                if (_sortMode != "name") await LoadPerformanceAsync(_sortMode);
            }
        }
        catch
        {
            _infoNotice = "Ошибка обновления состава";
        }
        finally
        {
            _refreshing = false;
        }
    }

    private async Task ConfirmBatchHistoryRefreshAsync()
    {
        if (_batchHistoryRefreshing || IsArchived || _constituents.Count == 0) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Обновить историю всех акций текущего состава? Запросы выполняются последовательно и могут занять время.");
        if (!confirmed) return;

        _batchHistoryRefreshing = true;
        _infoNotice = null;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _infoNotice = "Войдите в приложение и повторите попытку.";
                return;
            }
            using var response = await client.PostAsync($"market-indices/{IndexId}/constituents/history/refresh", null);
            var body = await response.Content.ReadAsStringAsync();
            var data = TryDeserialize<BatchHistoryRefreshResponse>(body);
            if (!response.IsSuccessStatusCode || data is null)
            {
                _infoNotice = ExtractApiErrorMessage(body) ?? $"Ошибка пакетного обновления исторических данных (HTTP {(int)response.StatusCode}).";
                return;
            }

            _infoNotice = $"Обновление истории: всего {data.Total}, попыток {data.Attempted}, успешно {data.Succeeded}, ошибок {data.Failed}, лимит {data.RateLimited}, пропущено {data.SkippedRateLimited}.";
            _infoNoticeLevel = data.Failed > 0 || data.RateLimited > 0 || data.SkippedRateLimited > 0 ? "warning" : "info";
            if (_sortMode != "name") await LoadPerformanceAsync(_sortMode);
        }
        catch
        {
            _infoNotice = "Ошибка пакетного обновления исторических данных";
        }
        finally
        {
            _batchHistoryRefreshing = false;
        }
    }

    private async Task BatchRefreshQuotesAsync()
    {
        if (_batchQuoteRefreshing || IsArchived || _constituents.Count == 0) return;
        _batchQuoteRefreshing = true;
        _quoteSummary = null;
        _batchQuoteProgress = "Обновление цен…";
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null)
            {
                _quoteSummary = "Войдите в приложение и повторите попытку.";
                return;
            }

            using var startResponse = await client.PostAsync($"market-indices/{IndexId}/constituents/quotes/refresh", null);
            var startBody = await startResponse.Content.ReadAsStringAsync();
            var job = TryDeserialize<BatchQuoteJobResponse>(startBody);
            if (!startResponse.IsSuccessStatusCode || job is null)
            {
                _quoteSummary = ExtractApiErrorMessage(startBody) ?? $"Ошибка обновления цен (HTTP {(int)startResponse.StatusCode}).";
                return;
            }

            var startedAt = DateTime.UtcNow;
            while (!TerminalJobStates.Contains(job.State ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                   && (DateTime.UtcNow - startedAt).TotalMinutes < 10)
            {
                _batchQuoteProgress = job.Total > 0 ? $"Обновление цен: {job.Processed} из {job.Total}" : "Обновление цен…";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(2000);
                using var pollResponse = await client.GetAsync($"market-indices/{IndexId}/constituents/quotes/refresh-jobs/{Uri.EscapeDataString(job.JobId ?? string.Empty)}");
                var pollBody = await pollResponse.Content.ReadAsStringAsync();
                if (!pollResponse.IsSuccessStatusCode) break;
                var polled = TryDeserialize<BatchQuoteJobResponse>(pollBody);
                if (polled is null) break;
                job = polled;
            }

            _quoteSummary = $"Обновление цен: обработано {job.Processed} из {job.Total}, успешно {job.Succeeded}, задержано {job.Delayed}, без EUR {job.NoEurConversion}, ошибок {job.ProviderFailed + job.PersistFailed}.";
            await LoadConstituentsAsync();
        }
        catch
        {
            _quoteSummary = "Ошибка пакетного обновления цен";
        }
        finally
        {
            _batchQuoteRefreshing = false;
            _batchQuoteProgress = null;
        }
    }

    private async Task RefreshLivePriceAsync(IndexConstituentDto constituent)
    {
        if (_quoteLoadingId is not null || string.IsNullOrWhiteSpace(constituent.Ticker)) return;
        _quoteLoadingId = constituent.StockId;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            var slug = string.IsNullOrWhiteSpace(constituent.FinanzenNetSlug)
                ? string.Empty
                : $"&finanzenNetSlug={Uri.EscapeDataString(constituent.FinanzenNetSlug)}";
            using var quoteResponse = await client.GetAsync($"StockPrice/{Uri.EscapeDataString(constituent.Ticker)}?exchange={Uri.EscapeDataString(constituent.Exchange)}{slug}");
            if (!quoteResponse.IsSuccessStatusCode)
            {
                _infoNotice = $"Ошибка получения цены для {constituent.Ticker}";
                _infoNoticeLevel = "error";
                return;
            }
            var quote = await quoteResponse.Content.ReadFromJsonAsync<StockLiveQuoteViewModel>(JsonOptions);
            if (quote is null) return;
            _liveQuotes[constituent.StockId] = quote;

            if (quote.CurrentPriceEur is decimal price)
            {
                var update = new
                {
                    currentPrice = Math.Round(price, 2, MidpointRounding.AwayFromZero),
                    currentPriceChange = quote.ChangeEur is decimal change ? Math.Round(change, 4, MidpointRounding.AwayFromZero) : (decimal?)null,
                    currentPriceChangePercent = quote.PercentChange is decimal percent ? Math.Round(percent, 4, MidpointRounding.AwayFromZero) : (decimal?)null,
                    currentPriceAt = quote.PriceTimestampUtc,
                    currentPriceIsDelayed = quote.IsStale || !string.IsNullOrWhiteSpace(quote.DelayWarning),
                    currentPriceDelayWarning = string.IsNullOrWhiteSpace(quote.DelayWarning) ? null : quote.DelayWarning.Trim()
                };
                using var updateResponse = await client.PatchAsJsonAsync($"Stocks/{constituent.StockId}/quote", update);
                if (updateResponse.IsSuccessStatusCode)
                {
                    constituent.CurrentPrice = update.currentPrice;
                    constituent.CurrentPriceChange = update.currentPriceChange;
                    constituent.CurrentPriceChangePercent = update.currentPriceChangePercent;
                    constituent.CurrentPriceAt = quote.PriceTimestampUtc;
                    constituent.CurrentPriceIsDelayed = update.currentPriceIsDelayed;
                    constituent.CurrentPriceDelayWarning = update.currentPriceDelayWarning;
                }
            }
        }
        catch
        {
            _infoNotice = $"Ошибка получения цены для {constituent.Ticker}";
            _infoNoticeLevel = "error";
        }
        finally
        {
            _quoteLoadingId = null;
        }
    }

    private async Task TrackAsync(IndexConstituentDto constituent)
    {
        if (_trackingStockId is not null) return;
        _trackingStockId = constituent.StockId;
        try
        {
            using var client = await CreateAuthenticatedClientAsync();
            if (client is null) return;
            using var response = await client.PostAsync($"Stocks/{constituent.StockId}/track", null);
            if (!response.IsSuccessStatusCode)
            {
                _infoNotice = $"Не удалось добавить «{constituent.Name}» в отслеживаемые акции.";
                _infoNoticeLevel = "error";
                return;
            }
            constituent.TrackingStatus = "Tracked";
            _infoNotice = $"«{constituent.Name}» добавлена в отслеживаемые акции";
            _infoNoticeLevel = "info";
        }
        catch
        {
            _infoNotice = "Ошибка добавления в отслеживаемые";
            _infoNoticeLevel = "error";
        }
        finally
        {
            _trackingStockId = null;
        }
    }

